<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>MusicVault</AssemblyName>
    <RootNamespace>MusicVault.App</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 嵌入 exe，任务栏 / 资源管理器显示品牌图标 -->
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Description>下载即整理，整理即播放 - 跨平台个人音乐管理工具</Description>
  </PropertyGroup>

  <!-- 默认 Release：自包含单文件（兼容性最佳，推荐发布） -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Avalonia/TagLib 依赖反射，裁剪易导致发布版无法启动 -->
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- 启用 -p:EnableAot=true 时尝试 NativeAOT（需额外 rd.xml 与平台验证） -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(EnableAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MusicVault.Core\MusicVault.Core.csproj" />
    <ProjectReference Include="..\MusicVault.Services\MusicVault.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.3" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <!-- 发布输出需含 native libvlc；Windows 单文件仍由 publish-with-api.ps1 旁路；macOS 由 publish-macos.sh 优先从 VLC.app 捆绑 -->
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.1" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\release-notes.json" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableAot)' == 'true'">
    <RdXmlFile Include="rd.xml" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MusicVault.Tests" />
  </ItemGroup>
</Project>
