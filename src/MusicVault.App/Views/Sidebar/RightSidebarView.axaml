<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sidebarvm="using:MusicVault.App.ViewModels.Sidebar"
             xmlns:sidebar="using:MusicVault.App.Views.Sidebar"
             xmlns:meta="using:MusicVault.App.Views.Sidebar"
             xmlns:controls="using:MusicVault.App.Controls"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="MusicVault.App.Views.Sidebar.RightSidebarView"
             x:DataType="sidebarvm:RightSidebarViewModel">
  <Grid RowDefinitions="Auto,*">
    <!-- 歌词 / 元数据 顶栏 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="{DynamicResource LibraryPaneHeaderMargin}"
          IsVisible="{Binding !IsQueueMode}">
      <TextBlock Grid.Column="0" Text="{Binding SidebarLyricsTitle}" Classes="text-subtitle" IsVisible="{Binding IsLyricsMode}"/>
      <TextBlock Grid.Column="0" Text="{Binding SidebarMetadataTitle}" Classes="text-subtitle" IsVisible="{Binding IsMetadataMode}"/>
      <Button Grid.Column="1" Classes="icon-btn" ToolTip.Tip="{Binding FullscreenToolTip}"
              automation:AutomationProperties.Name="{Binding FullscreenToolTip}"
              Command="{Binding EnterFullscreenCommand}" IsVisible="{Binding IsLyricsMode}">
        <TextBlock Text="{StaticResource IconGlyphFullscreen}" Classes="icon-sm"/>
      </Button>
      <Button Grid.Column="2" Classes="icon-btn" ToolTip.Tip="{Binding SwitchMetadataToolTip}"
              automation:AutomationProperties.Name="{Binding SwitchMetadataToolTip}"
              Command="{Binding ToggleMetadataLyricsCommand}" IsVisible="{Binding IsLyricsMode}">
        <TextBlock Text="{StaticResource IconGlyphLyrics}" Classes="icon-sm"/>
      </Button>
      <Button Grid.Column="3" Classes="icon-btn" ToolTip.Tip="{Binding CloseToolTip}"
              automation:AutomationProperties.Name="{Binding CloseToolTip}"
              Command="{Binding CloseCommand}">
        <TextBlock Text="{StaticResource IconGlyphClose}" Classes="icon-sm"/>
      </Button>
    </Grid>

    <!-- 播放队列顶栏（参考 QQ 音乐：标题 + 批量 + 清空 + 关闭） -->
    <StackPanel Grid.Row="0" Margin="{DynamicResource LibraryPaneHeaderMargin}" Spacing="8"
                IsVisible="{Binding IsQueueMode}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding QueueTitle}" Classes="text-subtitle"/>
          <TextBlock Text="{Binding QueueCountText}" Classes="text-caption"
                     Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
        <Button Grid.Column="1" Classes="icon-btn queue-toolbar-btn"
                Classes.active="{Binding IsQueueBatchMode}"
                Command="{Binding ToggleQueueBatchModeCommand}"
                ToolTip.Tip="{Binding QueueBatchToolTip}"
                automation:AutomationProperties.Name="{Binding QueueBatchToolTip}">
          <TextBlock Text="{StaticResource IconGlyphQueue}" Classes="icon-sm"/>
        </Button>
        <controls:PopconfirmHost Grid.Column="2"
                                 Title="{Binding QueueClearTitle}"
                                 Description="{Binding QueueClearDescription}"
                                 ConfirmText="{Binding QueueClearConfirm}"
                                 ConfirmIsDanger="True"
                                 ConfirmedCommand="{Binding ClearQueueCommand}"
                                 IsEnabled="{Binding HasQueueRows}">
          <Button Classes="icon-btn queue-toolbar-btn"
                  ToolTip.Tip="{Binding QueueClearToolTip}"
                  automation:AutomationProperties.Name="{Binding QueueClearToolTip}">
            <TextBlock Text="{StaticResource IconGlyphDelete}" Classes="icon-sm"/>
          </Button>
        </controls:PopconfirmHost>
        <Button Grid.Column="3" Classes="icon-btn queue-toolbar-btn" ToolTip.Tip="{Binding CloseToolTip}"
                automation:AutomationProperties.Name="{Binding CloseToolTip}"
                Command="{Binding CloseCommand}">
          <TextBlock Text="{StaticResource IconGlyphClose}" Classes="icon-sm"/>
        </Button>
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="8"
                  IsVisible="{Binding IsQueueBatchMode}">
        <Button Content="{Binding QueueSelectAllText}" Classes="flat-btn btn-toolbar"
                Command="{Binding SelectAllQueueItemsCommand}"
                automation:AutomationProperties.Name="{Binding QueueSelectAllText}"/>
        <Button Content="{Binding QueueDeselectAllText}" Classes="flat-btn btn-toolbar"
                Command="{Binding DeselectAllQueueItemsCommand}"
                automation:AutomationProperties.Name="{Binding QueueDeselectAllText}"/>
        <Button Content="{Binding QueueRemoveSelectedText}" Classes="flat-btn btn-toolbar"
                Command="{Binding RemoveSelectedQueueItemsCommand}"
                IsEnabled="{Binding CanRemoveSelectedQueueItems}"
                automation:AutomationProperties.Name="{Binding QueueRemoveSelectedText}"/>
        <TextBlock Text="{Binding QueueSelectedCountText}"
                   Classes="text-caption" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   IsVisible="{Binding HasSelectedQueueItems}"/>
      </StackPanel>
    </StackPanel>

    <sidebar:LyricsScrollPanelView Grid.Row="1" IsVisible="{Binding IsLyricsMode}"
                                   Margin="{DynamicResource ChipGridItemMargin}"/>

    <Panel Grid.Row="1" IsVisible="{Binding IsMetadataMode}" Margin="{DynamicResource MarginBottomSm}">
      <meta:MetadataEditorPanel DataContext="{Binding MetadataEditor}"/>
    </Panel>

    <DockPanel Grid.Row="1" IsVisible="{Binding IsQueueMode}" Margin="{DynamicResource MarginBottomSm}">
      <controls:QueueSidebarTableHeader x:Name="QueueTableHeader"
                                        DockPanel.Dock="Top"
                                        IsBatchMode="{Binding IsQueueBatchMode}"/>

      <Panel>
        <ListBox x:Name="QueueListBox"
                 Classes="virtual-list discover-results-list scroll-clear-player-progress queue-sidebar-list"
                 ItemsSource="{Binding QueueRows}"
                 ItemTemplate="{StaticResource SidebarQueueTrackRowTemplate}"
                 DoubleTapped="OnQueueDoubleTapped"
                 IsVisible="{Binding HasQueueRows}"/>
        <controls:EmptyStateView IsVisible="{Binding !HasQueueRows}"
                                 Title="{Binding QueueEmptyHistoryTitle}"
                                 Description="{Binding QueueEmptyHistoryDescription}"
                                 ShowIcon="False"/>
      </Panel>
    </DockPanel>
  </Grid>
</UserControl>
