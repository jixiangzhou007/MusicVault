<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicVault.App.ViewModels.Dialogs"
             x:Class="MusicVault.App.Views.Overlays.ConfirmRemoveDownloadModalView"
             x:DataType="vm:ConfirmRemoveDownloadModalViewModel">
  <Border Classes="ant-popover player-elevated-popover app-modal-panel">
    <DockPanel>
      <Border DockPanel.Dock="Bottom" Classes="app-dialog-footer">
        <StackPanel Classes="app-dialog-actions">
          <Button Content="{Binding CancelButtonText}" Classes="flat-btn app-dialog-btn" Command="{Binding CancelCommand}"/>
          <Button Content="{Binding ListOnlyButtonText}"
                  Classes="app-dialog-btn"
                  Classes.flat-btn="{Binding !ListOnlyIsPrimary}"
                  Classes.primary="{Binding ListOnlyIsPrimary}"
                  Command="{Binding ListOnlyCommand}"/>
          <Button Content="{Binding ListAndFileButtonText}" Classes="danger app-dialog-btn"
                  IsVisible="{Binding ShowListAndFileButton}"
                  Command="{Binding ListAndFileCommand}"/>
        </StackPanel>
      </Border>
      <StackPanel Classes="app-dialog-body">
        <TextBlock Text="{Binding ModalTitle}" Classes="text-title"/>
        <TextBlock Text="{Binding SummaryText}" Classes="text-body" TextWrapping="Wrap" LineHeight="22"/>
        <TextBlock Text="{Binding DetailText}" Classes="text-caption" TextWrapping="Wrap" LineHeight="20"/>
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
