<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MusicVault.App.Controls"
             xmlns:vm="using:MusicVault.App.ViewModels.Dialogs"
             x:Class="MusicVault.App.Views.Overlays.FirstRunWizardModalView"
             x:DataType="vm:FirstRunWizardModalViewModel">
  <Border Classes="ant-popover player-elevated-popover app-modal-panel" MinWidth="520" MaxWidth="600">
    <DockPanel>
      <Border DockPanel.Dock="Bottom" Classes="app-dialog-footer">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding SkipWizardText}" Classes="flat-btn app-dialog-btn"
                    Command="{Binding SkipWizardCommand}"
                    IsVisible="{Binding !IsLastStep}"/>
            <Button Content="{Binding SkipStepText}" Classes="flat-btn app-dialog-btn"
                    Command="{Binding SkipCurrentStepCommand}"
                    IsVisible="{Binding !IsWelcomeStep}"
                    IsEnabled="{Binding !IsLastStep}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{Binding BackText}" Classes="flat-btn app-dialog-btn"
                    Command="{Binding BackCommand}"
                    IsVisible="{Binding CanGoBack}"/>
            <Button Content="{Binding NextButtonText}" Classes="primary app-dialog-btn"
                    Command="{Binding NextCommand}"/>
          </StackPanel>
        </Grid>
      </Border>

      <StackPanel Classes="app-dialog-body" Spacing="14">
        <controls:StepsIndicator Items="{Binding WizardSteps}" Margin="{DynamicResource MarginBottomXs}"/>

        <StackPanel IsVisible="{Binding IsWelcomeStep}" Spacing="10">
          <TextBlock Text="{Binding WelcomeTitle}" Classes="text-title"/>
          <TextBlock Classes="text-body" TextWrapping="Wrap" LineHeight="22"
                     Text="{Binding WelcomeDesc}"/>
          <TextBlock Classes="text-caption" TextWrapping="Wrap"
                     Text="{Binding WelcomeHint}"/>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsLibraryStep}" Spacing="10">
          <TextBlock Text="{Binding LibraryTitle}" Classes="text-subtitle"/>
          <TextBlock Classes="text-caption" TextWrapping="Wrap" LineHeight="20"
                     Text="{Binding LibraryDesc}"/>
          <TextBox Text="{Binding LibraryPath}" Watermark="{Binding LibraryWatermark}"
                   Classes="app-dialog-field" IsReadOnly="True"/>
          <Button Content="{Binding LibraryBrowseText}" Classes="flat-btn" HorizontalAlignment="Left"
                  Command="{Binding PickLibraryFolderCommand}"/>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsDownloadStep}" Spacing="10">
          <TextBlock Text="{Binding DownloadTitle}" Classes="text-subtitle"/>
          <TextBlock Classes="text-caption" TextWrapping="Wrap" LineHeight="20"
                     Text="{Binding DownloadDesc}"/>
          <TextBox Text="{Binding DownloadDirectory}" Watermark="{Binding DownloadWatermark}"
                   Classes="app-dialog-field" IsReadOnly="True"/>
          <Button Content="{Binding DownloadBrowseText}" Classes="flat-btn" HorizontalAlignment="Left"
                  Command="{Binding PickDownloadFolderCommand}"/>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsApiStep}" Spacing="10">
          <TextBlock Text="{Binding ApiTitle}" Classes="text-subtitle"/>
          <TextBlock Classes="text-caption" TextWrapping="Wrap" LineHeight="20"
                     Text="{Binding ApiDesc}"/>
          <Border Classes="ant-alert ant-alert-info" IsVisible="{Binding ShowApiHealthStatus}">
            <TextBlock Classes="ant-alert-message" Text="{Binding ApiHealthStatusText}" TextWrapping="Wrap"/>
          </Border>
          <TextBlock Classes="text-caption" TextWrapping="Wrap"
                     IsVisible="{Binding !HasAnyBundledApi}"
                     Text="{Binding ApiNoBundledText}"/>
        </StackPanel>

        <TextBlock Text="{Binding StatusMessage}" Classes="app-dialog-status" TextWrapping="Wrap"
                   IsVisible="{Binding HasStatusMessage}"/>
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
