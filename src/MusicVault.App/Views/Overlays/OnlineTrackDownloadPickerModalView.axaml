<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicVault.App.ViewModels.Dialogs"
             xmlns:mvm="using:MusicVault.App.ViewModels"
             x:Class="MusicVault.App.Views.Overlays.OnlineTrackDownloadPickerModalView"
             x:DataType="vm:OnlineTrackDownloadPickerModalViewModel">
  <Border Classes="ant-popover player-elevated-popover app-modal-panel" MinWidth="420" MaxWidth="520">
    <DockPanel>
      <Border DockPanel.Dock="Bottom" Classes="app-dialog-footer">
        <StackPanel Classes="app-dialog-actions">
          <Button Content="{Binding CancelLabel}" Classes="flat-btn app-dialog-btn" Command="{Binding CancelCommand}"/>
        </StackPanel>
      </Border>
      <StackPanel Classes="app-dialog-body" Spacing="12">
        <TextBlock Text="{Binding ModalTitle}" Classes="text-title"/>
        <TextBlock Text="{Binding Title}" Classes="text-body" TextWrapping="Wrap" MaxLines="2"/>
        <TextBlock Text="{Binding Artist}" Classes="text-caption"
                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>

        <StackPanel Spacing="6">
          <TextBlock Text="{Binding FolderLabel}" Classes="text-label"/>
          <TextBlock Text="{Binding DownloadDirectoryDisplay}"
                     Classes="text-caption"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding DownloadDirectoryDisplay}"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding PickFolderLabel}"
                    Classes="flat-btn btn-toolbar"
                    Command="{Binding PickFolderCommand}"/>
            <Button Content="{Binding UseDefaultFolderLabel}"
                    Classes="flat-btn btn-toolbar"
                    IsVisible="{Binding HasCustomDirectory}"
                    Command="{Binding UseDefaultFolderCommand}"/>
          </StackPanel>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Options}" IsVisible="{Binding HasOptions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="mvm:OnlineTrackFormatViewModel">
              <Button Content="{Binding Label}"
                      Classes="discover-action-chip"
                      Margin="{DynamicResource ChipGridItemMargin}"
                      ToolTip.Tip="{Binding HoverTip}"
                      Command="{Binding $parent[UserControl].((vm:OnlineTrackDownloadPickerModalViewModel)DataContext).PickCommand}"
                      CommandParameter="{Binding}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding NoQualityText}"
                   Classes="text-caption"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   IsVisible="{Binding !HasOptions}"/>

        <StackPanel Spacing="6">
          <TextBlock Text="{Binding RecentTitle}" Classes="text-label"/>
          <ItemsControl ItemsSource="{Binding RecentDownloads}" IsVisible="{Binding HasRecentDownloads}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:OnlineTrackDownloadHistoryEntry">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Title}" Classes="text-caption"
                             TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                  <TextBlock Text="{Binding Artist}" Classes="text-caption"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                  <TextBlock Text="{Binding StatusText}" Classes="text-caption"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             ToolTip.Tip="{Binding TargetPath}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding NoRecentText}"
                     Classes="text-caption"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     IsVisible="{Binding !HasRecentDownloads}"/>
          <Button Content="{Binding OpenTransfersLabel}"
                  Classes="flat-btn btn-toolbar"
                  HorizontalAlignment="Left"
                  Command="{Binding OpenTransfersCommand}"/>
        </StackPanel>
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
