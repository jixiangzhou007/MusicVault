<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:MusicVault.App.Converters"
             xmlns:vm="using:MusicVault.App.ViewModels.Dialogs"
             x:Class="MusicVault.App.Views.Overlays.PreviewLoadingModalView"
             x:DataType="vm:PreviewLoadingModalViewModel">
  <Border x:Name="PreviewLoadingCard"
          Classes="preview-loading-card"
          Opacity="0"
          RenderTransformOrigin="50%,50%"
          RenderTransform="scale(0.94)">
    <Border.Transitions>
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.24" Easing="CubicEaseOut"/>
      </Transitions>
    </Border.Transitions>
    <DockPanel LastChildFill="True">
      <Button DockPanel.Dock="Bottom"
              Content="{Binding CancelLabel}"
              Classes="flat-btn preview-loading-cancel"
              HorizontalAlignment="Right"
              Command="{Binding CancelCommand}"/>
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding ModalTitle}" Classes="preview-loading-title"/>
        <TextBlock Text="{Binding Title}" Classes="preview-loading-track"
                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
        <TextBlock Text="{Binding Artist}" Classes="preview-loading-artist"
                   TextTrimming="CharacterEllipsis" MaxLines="1"
                   IsVisible="{Binding Artist, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"/>
        <TextBlock Text="{Binding StatusText}" Classes="preview-loading-status"
                   TextTrimming="CharacterEllipsis" MaxLines="2"/>
        <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
          <ProgressBar Grid.Column="0" Minimum="0" Maximum="100"
                       Value="{Binding ProgressValue}"
                       IsIndeterminate="{Binding IsProgressIndeterminate}"
                       Classes="ant-progress-line-modal preview-loading-progress"/>
          <TextBlock Grid.Column="1" Text="{Binding ProgressPercentText}"
                     Classes="ant-progress-percent"
                     IsVisible="{Binding ShowProgressPercent}"/>
        </Grid>
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
