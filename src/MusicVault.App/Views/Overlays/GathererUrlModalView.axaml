<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicVault.App.ViewModels.Dialogs"
             x:Class="MusicVault.App.Views.Overlays.GathererUrlModalView"
             x:DataType="vm:GathererUrlModalViewModel">
  <Border Classes="ant-popover player-elevated-popover app-modal-panel" MaxWidth="480" MinWidth="360">
    <DockPanel>
      <Border DockPanel.Dock="Bottom" Classes="app-dialog-footer">
        <StackPanel Classes="app-dialog-actions">
          <Button Content="{Binding CancelButtonText}" Classes="flat-btn app-dialog-btn" Command="{Binding CancelCommand}"/>
          <Button Content="{Binding SaveButtonText}" Classes="primary app-dialog-btn" Command="{Binding SaveCommand}"/>
        </StackPanel>
      </Border>
      <StackPanel Classes="app-dialog-body" Spacing="10">
        <TextBlock Text="{Binding Title}" Classes="text-title"/>
        <TextBlock Text="{Binding Description}" Classes="settings-field-caption" TextWrapping="Wrap"/>
        <TextBox Text="{Binding Url}" Watermark="{Binding Watermark}"
                 Classes="discover-field metadata-field field-input metadata-input app-dialog-field"/>
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
