<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicVault.App.ViewModels.Dialogs"
             x:Class="MusicVault.App.Views.Overlays.OpenSourceDetailModalView"
             x:DataType="vm:OpenSourceDetailModalViewModel">
  <Border Classes="ant-popover player-elevated-popover app-modal-panel" MaxWidth="480">
    <DockPanel>
      <Border DockPanel.Dock="Bottom" Classes="app-dialog-footer">
        <StackPanel Classes="app-dialog-actions">
          <Button Content="{Binding CloseButtonText}" Classes="primary app-dialog-btn"
                  Command="{Binding CloseCommand}"/>
        </StackPanel>
      </Border>
      <StackPanel Classes="app-dialog-body" Spacing="10">
        <TextBlock Text="{Binding Title}" Classes="text-title"/>
        <TextBlock Text="{Binding Summary}" Classes="settings-field-caption" TextWrapping="Wrap"/>
        <ScrollViewer MaxHeight="280"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <TextBlock Text="{Binding Detail}" Classes="text-body" TextWrapping="Wrap" LineHeight="22"/>
        </ScrollViewer>
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
