<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pvm="using:MusicVault.App.ViewModels.Pages"
             xmlns:svc="using:MusicVault.App.Services"
             xmlns:conv="using:MusicVault.App.Converters"
             xmlns:controls="using:MusicVault.App.Controls"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="MusicVault.App.Views.Pages.SettingsPageView"
             x:DataType="pvm:SettingsPageViewModel"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
  <DockPanel Classes="pane-play" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid x:Name="RootGrid" ColumnDefinitions="260,6,*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

      <!-- Nav sidebar -->
      <DockPanel Grid.Column="0" Classes="pane-library">
        <Grid DockPanel.Dock="Top" Margin="{DynamicResource LibraryPaneHeaderMargin}" MinHeight="32">
          <TextBlock Text="{Binding PreferencesCenterLabel}" Classes="text-subtitle" VerticalAlignment="Center"/>
        </Grid>
        <ListBox x:Name="SettingsNavList"
                 ItemsSource="{Binding NavItems}"
                 SelectionChanged="OnSettingsNavSelectionChanged"
                 Classes="music-library-list settings-nav-list">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="pvm:SettingsNavItemViewModel">
              <Border Classes="library-list-row settings-nav-row" HorizontalAlignment="Stretch"
                      automation:AutomationProperties.Name="{Binding Title}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding Title}" Classes="text-label" TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding ShowNavIndicators}">
                    <Border Classes="settings-nav-badge" IsVisible="{Binding ShowNavBadge}"><TextBlock Text="{Binding NavBadgeText}"/></Border>
                    <Border Classes="settings-nav-pending-dot" IsVisible="{Binding ShowPendingDot}"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <controls:VerticalPaneSplitter x:Name="NavPaneSplitter" Grid.Column="1"/>

      <!-- Content -->
        <DockPanel Grid.Column="2" Classes="pane-play" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch">
          <StackPanel Classes="settings-page-scroll" HorizontalAlignment="Stretch" VerticalAlignment="Top" Spacing="0">

            <StackPanel Classes="settings-form" HorizontalAlignment="Stretch" VerticalAlignment="Top">

            <!-- ====== Page Header ====== -->
            <Border Classes="settings-page-header">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Classes="settings-overview-header-actions" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding ShowLibraryStatsHeaderActions}">
                  <Button Classes="icon-toolbar-btn" Command="{Binding RefreshLibraryOverviewFromUiCommand}" ToolTip.Tip="{Binding GeneralRefreshStatsToolTip}">
                    <TextBlock Text="{StaticResource IconGlyphRefresh}" Classes="icon-xs"/>
                  </Button>
                  <Button Content="{Binding GeneralManageSourcesLabel}" Classes="flat-btn btn-toolbar"
                          Command="{Binding OpenLibrarySourcesFromOverviewCommand}" ToolTip.Tip="{Binding GeneralManageSourcesToolTip}"/>
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding SelectedSectionTitle}" Classes="settings-page-title" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding SelectedSectionSubtitle}" Classes="settings-page-subtitle" IsVisible="{Binding ShowSectionPageSubtitle}"/>
                  <TextBlock Text="{Binding AppearanceInstantHint}" Classes="settings-field-caption" TextWrapping="Wrap" IsVisible="{Binding ShowAppearanceInstantHint}"/>
                  <TextBlock Text="{Binding StatusMessage}" Classes="text-caption" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" IsVisible="{Binding HasStatusMessage}"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Classes="page-hero-divider"/>

            <!-- ====== Overview：关于书（身份 → 关于 → 快捷入口） ====== -->
            <StackPanel Classes="settings-section settings-intro-page settings-overview-dashboard" IsVisible="{Binding SelectedSection, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter={x:Static pvm:SettingsSectionKind.Overview}}">
              <StackPanel Classes="settings-overview-identity" Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="MusicVault" Classes="settings-intro-app-name"/>
                    <TextBlock Text="{Binding VersionText}" Classes="settings-intro-version" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding IntroductionAuthor}" Classes="settings-intro-author" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{Binding IntroductionTagline}" Classes="settings-intro-tagline" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding HeroDescriptionDisclaimer}" Classes="settings-overview-disclaimer-text" TextWrapping="Wrap"/>
              </StackPanel>

              <StackPanel Classes="settings-group settings-overview-about settings-overview-about-body" Spacing="8">
                <TextBlock Text="{Binding OverviewAboutSectionTitle}" Classes="settings-group-title"/>
                <TextBlock Text="{Binding HeroDescriptionLead}" Classes="settings-field-caption settings-overview-intro-body" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding OverviewCapabilitiesSummary}" Classes="settings-field-caption settings-overview-feature-desc" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding OverviewLicenseSectionTitle}" Classes="settings-overview-panel-title"/>
                <TextBlock Text="{Binding IntroductionCopyright}" Classes="settings-field-caption" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding AboutLicenseHint}" Classes="settings-field-caption" TextWrapping="Wrap"/>
                <WrapPanel Orientation="Horizontal">
                  <ItemsControl ItemsSource="{Binding OpenSourceProjects}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Button Classes="intro-chip" Command="{Binding $parent[UserControl].((pvm:SettingsPageViewModel)DataContext).ShowOpenSourceDetailCommand}" CommandParameter="{Binding}">
                        <TextBlock Text="{Binding Name}" Classes="intro-chip-name"/>
                      </Button>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </WrapPanel>
                <WrapPanel Classes="settings-overview-quickstart-actions" IsVisible="{Binding ShowDesignSystemPreview}">
                  <TextBlock Text="{Binding AboutDevToolsTitle}" Classes="settings-field-caption" VerticalAlignment="Center" Margin="{DynamicResource MarginTrailingSm}"/>
                  <Button Content="{Binding AboutOpenDesignPreviewLabel}" Classes="flat-btn btn-toolbar" Command="{Binding OpenDesignSystemPreviewCommand}"/>
                </WrapPanel>
              </StackPanel>

              <StackPanel Classes="settings-group settings-overview-actions">
                <TextBlock Text="{Binding OverviewShortcutsTitle}" Classes="settings-group-title"/>
                <TextBlock Text="{Binding OverviewLibraryEmptyGuidance}" Classes="settings-overview-empty-copy" TextWrapping="Wrap" IsVisible="{Binding ShowOverviewLibraryEmptyGuidance}"/>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowOverviewLibraryEmptyGuidance}">
                  <Button Content="{Binding GeneralManageSourcesLabel}" Classes="flat-btn btn-toolbar"
                          Command="{Binding OpenLibrarySourcesFromOverviewCommand}" ToolTip.Tip="{Binding GeneralManageSourcesToolTip}"/>
                  <Button Content="{Binding OverviewApplyRecommendedLabel}" Classes="primary btn-toolbar"
                          Command="{Binding ApplyRecommendedSettingsCommand}" ToolTip.Tip="{Binding OverviewRecommendHint}"
                          IsVisible="{Binding ShowOverviewRecommendPrimaryCta}"/>
                </StackPanel>
                <WrapPanel Classes="settings-overview-quick-actions">
                  <Button Content="{Binding OverviewGoAppearanceLabel}" Classes="flat-btn btn-toolbar" Command="{Binding GoToOverviewAppearanceCommand}"/>
                  <Button Content="{Binding OverviewGoPlaybackLabel}" Classes="flat-btn btn-toolbar" Command="{Binding GoToOverviewPlaybackCommand}"/>
                  <Button Content="{Binding OverviewGoDownloadLabel}" Classes="flat-btn btn-toolbar" Command="{Binding GoToOverviewDownloadCommand}"/>
                  <Button Content="{Binding OverviewGoAdvancedLabel}" Classes="flat-btn btn-toolbar" Command="{Binding GoToOverviewAdvancedCommand}"/>
                </WrapPanel>
                <TextBlock Text="{Binding LastRecommendedApplySummary}" Classes="settings-field-caption" TextWrapping="Wrap" IsVisible="{Binding ShowLastRecommendedApplySummary}"/>
              </StackPanel>
            </StackPanel>

            <!-- ====== Appearance ====== -->
            <StackPanel Classes="settings-appearance-page" IsVisible="{Binding SelectedSection, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter={x:Static pvm:SettingsSectionKind.Appearance}}">
              <StackPanel Classes="settings-section settings-section-body settings-appearance-body">
                <StackPanel Classes="settings-group">
                  <TextBlock Text="{Binding AppearanceDisplayGroupTitle}" Classes="settings-group-title"/>
                  <Grid Classes="settings-field-row" ColumnDefinitions="108,12,*">
                    <TextBlock Grid.Column="0" Text="{Binding AppearanceLanguageLabel}" Classes="settings-field-label"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding LanguageOptionLabels}" SelectedIndex="{Binding CultureIndex}" VerticalAlignment="Center" Classes="field-select metadata-platform-combo settings-field-control settings-appearance-control"/></Grid>
                  <Grid Classes="settings-field-row" ColumnDefinitions="108,12,*">
                    <TextBlock Grid.Column="0" Text="{Binding AppearanceThemeLabel}" Classes="settings-field-label"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding ThemeOptionLabels}" SelectedIndex="{Binding ThemeIndex}" VerticalAlignment="Center" Classes="field-select metadata-platform-combo settings-field-control settings-appearance-control"/></Grid>
                  <Grid Classes="settings-field-row" ColumnDefinitions="108,12,*">
                    <TextBlock Grid.Column="0" Text="{Binding AppearanceFontScaleLabel}" Classes="settings-field-label"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding FontScaleOptionLabels}" SelectedIndex="{Binding UiFontScaleIndex}" VerticalAlignment="Center" Classes="field-select metadata-platform-combo settings-field-control settings-appearance-control"/></Grid>
                  <Grid Classes="settings-field-row" ColumnDefinitions="108,12,*">
                    <TextBlock Grid.Column="0" Text="{Binding AppearanceAccentLabel}" Classes="settings-field-label" ToolTip.Tip="{Binding AppearanceAccentHint}" VerticalAlignment="Center"/>
                    <ItemsControl Grid.Column="2" ItemsSource="{Binding AccentColorOptions}" Classes="settings-appearance-swatch-list" ToolTip.Tip="{Binding AppearanceAccentHint}" VerticalAlignment="Center">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pvm:AccentColorOptionViewModel">
                          <Button Classes="accent-swatch settings-appearance-swatch" ToolTip.Tip="{Binding Name}" Command="{Binding $parent[UserControl].((pvm:SettingsPageViewModel)DataContext).SelectAccentColorCommand}" CommandParameter="{Binding}">
                            <Border Classes="accent-swatch-dot" Classes.selected="{Binding IsSelected}" Width="28" Height="28" CornerRadius="14" Background="{Binding SwatchBrush}" BorderThickness="2"/>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                  <Button Content="{Binding AppearanceResetDefaultButtonLabel}" Classes="flat-btn btn-toolbar settings-field-follow-action"
                          HorizontalAlignment="Left" Command="{Binding ResetAppearanceToDefaultsCommand}"
                          ToolTip.Tip="{Binding AppearanceResetDefaultLabel}"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <!-- ====== PlaybackAudio ====== -->
            <StackPanel Classes="settings-playback-page" IsVisible="{Binding SelectedSection, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter={x:Static pvm:SettingsSectionKind.PlaybackAudio}}">
              <Border Classes="antd-card-tabs settings-playback-tabs" HorizontalAlignment="Stretch"><Panel>
                <Border Classes="antd-card-tab-content settings-playback-tab-content"
                        Margin="{DynamicResource AntdCardTabContentMargin}"
                        VerticalAlignment="Top" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="{DynamicResource SettingsGroupBodySpacing}">
                    <StackPanel IsVisible="{Binding IsPlaybackTabPlaybackSelected}" Classes="settings-section-body settings-playback-tab-body">
                      <StackPanel Classes="settings-group">
                        <TextBlock Text="{Binding PlaybackDefaultsGroupTitle}" Classes="settings-group-title"/>
                        <Grid Classes="settings-field-row settings-switch-row" ColumnDefinitions="108,12,*">
                          <TextBlock Grid.Column="0" Text="{Binding PlaybackRestoreOnStartupLabel}" Classes="settings-field-label" ToolTip.Tip="{Binding PlaybackRestoreOnStartupCaption}"/>
                          <ToggleSwitch Grid.Column="2" IsChecked="{Binding RestorePlaybackOnStartup}" Classes="ant-switch" ToolTip.Tip="{Binding PlaybackRestoreOnStartupCaption}"/></Grid>
                        <Grid Classes="settings-field-row" ColumnDefinitions="108,12,*">
                          <TextBlock Grid.Column="0" Text="{Binding PlaybackDefaultVolumeLabel}" Classes="settings-field-label"/>
                          <Grid Grid.Column="2" Classes="settings-inline-control" ColumnDefinitions="*,48" MaxWidth="{DynamicResource ControlWidthStandard}" VerticalAlignment="Center">
                            <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding DefaultVolumePercent}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding DefaultVolumePercentSummary}" Classes="settings-slider-value" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Grid>
                        <Grid Classes="settings-field-row" ColumnDefinitions="108,12,*">
                          <TextBlock Grid.Column="0" Text="{Binding PlaybackDefaultRepeatLabel}" Classes="settings-field-label"/>
                          <ComboBox Grid.Column="2" ItemsSource="{Binding RepeatModeOptionLabels}" SelectedIndex="{Binding DefaultRepeatModeIndex}" Classes="field-select settings-field-control settings-playback-control" VerticalAlignment="Center"/></Grid>
                        <Grid Classes="settings-field-row settings-switch-row" ColumnDefinitions="108,12,*">
                          <TextBlock Grid.Column="0" Text="{Binding PlaybackDefaultShuffleLabel}" Classes="settings-field-label" ToolTip.Tip="{Binding PlaybackDefaultShuffleCaption}"/>
                          <ToggleSwitch Grid.Column="2" IsChecked="{Binding DefaultShuffleOn}" Classes="ant-switch" ToolTip.Tip="{Binding PlaybackDefaultShuffleCaption}"/></Grid>
                      </StackPanel>
                      <StackPanel Classes="settings-group">
                        <TextBlock Text="{Binding PlaybackEngineGroupTitle}" Classes="settings-group-title"/>
                        <Grid Classes="settings-field-row" ColumnDefinitions="108,12,*">
                          <TextBlock Grid.Column="0" Text="{Binding ActivePlaybackEngineLabel}" Classes="settings-field-label"/>
                          <TextBlock Grid.Column="2" Text="{Binding ActivePlaybackEngineName}" Classes="settings-field-value-text"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding ActivePlaybackEngineDetail}"/></Grid>
                        <Grid Classes="settings-field-row settings-switch-row" ColumnDefinitions="108,12,*" IsVisible="{Binding ShowExperimentalLibVlcEngineToggle}">
                          <TextBlock Grid.Column="0" Text="{Binding ExperimentalLibVlcEngineLabel}" Classes="settings-field-label" ToolTip.Tip="{Binding ExperimentalLibVlcEngineCaption}"/>
                          <ToggleSwitch Grid.Column="2" IsChecked="{Binding UseExperimentalLibVlcEngine}" Classes="ant-switch" ToolTip.Tip="{Binding ExperimentalLibVlcEngineCaption}"/></Grid>
                        <TextBlock Text="{Binding ExperimentalLibVlcEngineRestartHint}" Classes="settings-field-caption settings-field-follow-caption" TextWrapping="Wrap"
                                   IsVisible="{Binding ShowExperimentalLibVlcEngineRestartHint}"/>
                      </StackPanel>
                      <StackPanel Classes="settings-group">
                        <TextBlock Text="{Binding PlaybackCapabilityGroupTitle}" Classes="settings-group-title"/>
                        <Grid Classes="settings-field-row tall" ColumnDefinitions="108,12,*">
                          <TextBlock Grid.Column="0" Text="{Binding PlatformCapabilityTitle}" Classes="settings-field-label" VerticalAlignment="Top"/>
                          <StackPanel Grid.Column="2" Classes="settings-field-stack" Spacing="{DynamicResource SettingsGroupBodySpacing}">
                            <ItemsControl ItemsSource="{Binding PlatformCapabilities}" Classes="settings-capability-list">
                              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate><DataTemplate x:DataType="pvm:PlatformCapabilityItemViewModel">
                                <Border Classes="settings-capability-pill" Margin="{DynamicResource SettingsOverviewChipMargin}" ToolTip.Tip="{Binding Detail}">
                                  <TextBlock Text="{Binding Name}"/>
                                </Border>
                              </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="{Binding PlaybackGoToOnlineSourcesLabel}" Classes="flat-btn btn-toolbar" HorizontalAlignment="Left"
                                    Command="{Binding GoToAdvancedOnlineSourcesCommand}"
                                    IsVisible="{Binding ShowGoToOnlineSourcesFromPlayback}"/>
                          </StackPanel>
                        </Grid>
                        <Grid Classes="settings-field-row" ColumnDefinitions="108,12,*">
                          <TextBlock Grid.Column="0" Text="{Binding PlaybackDefaultQualityLabel}" Classes="settings-field-label" ToolTip.Tip="{Binding PlaybackDefaultQualityCaption}"/>
                          <StackPanel Grid.Column="2" Classes="settings-control-inline">
                            <TextBlock Text="{Binding DefaultDownloadQualitySummary}" Classes="settings-field-value-text" VerticalAlignment="Center" ToolTip.Tip="{Binding PlaybackDefaultQualityCaption}"/>
                            <Button Content="{Binding PlaybackGoToDownloadLabel}" Classes="flat-btn btn-toolbar" Command="{Binding GoToOverviewDownloadCommand}"/></StackPanel></Grid>
                      </StackPanel>
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsPlaybackTabLyricsAndSoundSelected}" Classes="settings-section-body settings-playback-tab-body">
                      <StackPanel Classes="settings-group">
                        <TextBlock Text="{Binding PlaybackLyricsSectionTitle}" Classes="settings-group-title"/>
                        <TextBlock Text="{Binding DesktopLyricsUnsupportedHint}" Classes="settings-field-caption" TextWrapping="Wrap" IsVisible="{Binding ShowDesktopLyricsUnsupportedHint}"/>
                        <Grid Classes="settings-field-row settings-switch-row" ColumnDefinitions="108,12,*" IsVisible="{Binding IsDesktopLyricsSupported}">
                          <TextBlock Grid.Column="0" Text="{Binding PlaybackDesktopLyricsLabel}" Classes="settings-field-label" ToolTip.Tip="{Binding PlaybackDesktopLyricsCaption}"/>
                          <ToggleSwitch Grid.Column="2" IsChecked="{Binding DesktopLyricsEnabled}" Classes="ant-switch" ToolTip.Tip="{Binding PlaybackDesktopLyricsCaption}"/></Grid>
                        <Grid Classes="settings-field-row" ColumnDefinitions="108,12,*" IsVisible="{Binding IsDesktopLyricsSupported}">
                          <TextBlock Grid.Column="0" Text="{Binding PlaybackLyricsOpacityLabel}" Classes="settings-field-label"/>
                          <Grid Grid.Column="2" Classes="settings-inline-control" ColumnDefinitions="*,48" MaxWidth="{DynamicResource ControlWidthStandard}" VerticalAlignment="Center">
                            <Slider Grid.Column="0" Minimum="20" Maximum="100" Value="{Binding DesktopLyricsOpacityPercent}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding DesktopLyricsOpacitySummary}" Classes="settings-slider-value" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Grid>
                        <Grid Classes="settings-field-row" ColumnDefinitions="108,12,*" IsVisible="{Binding IsDesktopLyricsSupported}">
                          <TextBlock Grid.Column="0" Text="{Binding PlaybackLyricsFontSizeLabel}" Classes="settings-field-label"/>
                          <Grid Grid.Column="2" Classes="settings-inline-control" ColumnDefinitions="*,48" MaxWidth="{DynamicResource ControlWidthStandard}" VerticalAlignment="Center">
                            <Slider Grid.Column="0" Minimum="14" Maximum="36" Value="{Binding DesktopLyricsFontSize}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding DesktopLyricsFontSizeSummary}" Classes="settings-slider-value" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Grid>
                      </StackPanel>
                      <StackPanel Classes="settings-group">
                        <TextBlock Text="{Binding PlaybackSoundEffectsSectionTitle}" Classes="settings-group-title"/>
                        <TextBlock Text="{Binding EqualizerUnsupportedHint}" Classes="settings-field-caption" TextWrapping="Wrap" IsVisible="{Binding ShowEqualizerUnsupportedHint}"/>
                        <Button Content="{Binding PlaybackGoToTroubleshootLabel}" Classes="flat-btn btn-toolbar settings-field-follow-action" HorizontalAlignment="Left"
                                Command="{Binding GoToUpdateDiagnosticsTroubleshootCommand}"
                                IsVisible="{Binding ShowGoToTroubleshootFromPlayback}"/>
                        <Grid Classes="settings-field-row settings-switch-row" ColumnDefinitions="108,12,*" IsVisible="{Binding IsEqualizerSupported}">
                          <TextBlock Grid.Column="0" Text="{Binding PlaybackEqualizerLabel}" Classes="settings-field-label" ToolTip.Tip="{Binding PlaybackEqualizerEnableCaption}"/>
                          <ToggleSwitch Grid.Column="2" IsChecked="{Binding EqualizerEnabled}" Classes="ant-switch" ToolTip.Tip="{Binding PlaybackEqualizerEnableCaption}"/></Grid>
                        <Grid Classes="settings-field-row" ColumnDefinitions="108,12,*" IsVisible="{Binding IsEqualizerSupported}">
                          <TextBlock Grid.Column="0" Text="{Binding PlaybackEqualizerPresetLabel}" Classes="settings-field-label"/>
                          <Button Grid.Column="2" Content="{Binding PlaybackOpenEqualizerLabel}" Classes="flat-btn btn-toolbar" Command="{Binding OpenEqualizerCommand}" HorizontalAlignment="Left"/></Grid>
                      </StackPanel>
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsPlaybackTabShortcutsSelected}" Classes="settings-section-body settings-playback-tab-body">
                      <StackPanel Classes="settings-group">
                        <TextBlock Text="{Binding PlaybackShortcutsGroupTitle}" Classes="settings-group-title"/>
                        <Grid Classes="settings-field-row settings-switch-row" ColumnDefinitions="108,12,*">
                          <TextBlock Grid.Column="0" Text="{Binding PlaybackShortcutsEnableLabel}" Classes="settings-field-label" ToolTip.Tip="{Binding PlaybackShortcutsEnableCaption}"/>
                          <ToggleSwitch Grid.Column="2" IsChecked="{Binding EnableHotkeys}" Classes="ant-switch" ToolTip.Tip="{Binding PlaybackShortcutsEnableCaption}"/></Grid>
                        <Border Classes="settings-shortcut-list">
                          <StackPanel>
                            <Grid Classes="settings-shortcut-list-header" ColumnDefinitions="172,*">
                              <TextBlock Grid.Column="0" Text="{Binding ShortcutColumnKeyLabel}" Classes="settings-shortcut-list-th"/>
                              <TextBlock Grid.Column="1" Text="{Binding ShortcutColumnActionLabel}" Classes="settings-shortcut-list-th"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ShortcutRows}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pvm:SettingsShortcutRow">
                                  <Border Classes="settings-shortcut-list-row">
                                    <Grid ColumnDefinitions="172,*">
                                      <TextBlock Grid.Column="0" Text="{Binding Key}" Classes="settings-shortcut-list-td"/>
                                      <TextBlock Grid.Column="1" Text="{Binding Action}" Classes="settings-shortcut-list-td"/>
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                        <Grid Classes="settings-field-row" ColumnDefinitions="108,12,*">
                          <TextBlock Grid.Column="0" Text="{Binding PlaybackShortcutsManageLabel}" Classes="settings-field-label"/>
                          <StackPanel Grid.Column="2" Classes="settings-control-inline" Orientation="Horizontal" Spacing="8">
                            <Button Content="{Binding RestoreShortcutDefaultsLabel}" Classes="flat-btn btn-toolbar" Command="{Binding RestoreShortcutDefaultsCommand}"/>
                            <Button Content="{Binding ExportShortcutsLabel}" Classes="flat-btn btn-toolbar" Command="{Binding ExportShortcutsCommand}"/>
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel></Border>
                <Border Classes="antd-card-tab-rail" Margin="{DynamicResource AntdCardTabRailMargin}"/>
                <ScrollViewer VerticalAlignment="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Classes="antd-card-tab-nav"><StackPanel Orientation="Horizontal" Spacing="8">
                  <controls:AntdCardTab Title="{Binding PlaybackTabPlaybackLabel}" IsSelected="{Binding IsPlaybackTabPlaybackSelected}" SelectCommand="{Binding SelectPlaybackAudioTabCommand}" CommandParameter="{x:Static pvm:PlaybackAudioTabKind.Playback}"/>
                  <controls:AntdCardTab Title="{Binding PlaybackTabLyricsAndSoundLabel}" IsSelected="{Binding IsPlaybackTabLyricsAndSoundSelected}" SelectCommand="{Binding SelectPlaybackAudioTabCommand}" CommandParameter="{x:Static pvm:PlaybackAudioTabKind.LyricsAndSound}"/>
                  <controls:AntdCardTab Title="{Binding PlaybackTabShortcutsLabel}" IsSelected="{Binding IsPlaybackTabShortcutsSelected}" SelectCommand="{Binding SelectPlaybackAudioTabCommand}" CommandParameter="{x:Static pvm:PlaybackAudioTabKind.Shortcuts}"/>
                </StackPanel></ScrollViewer>
              </Panel></Border>
            </StackPanel>

            <!-- ====== DownloadCache ====== -->
            <StackPanel Classes="settings-download-page" IsVisible="{Binding SelectedSection, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter={x:Static pvm:SettingsSectionKind.DownloadCache}}">
              <StackPanel Classes="settings-section settings-section-body settings-download-body">
                <Border Classes="ant-alert ant-alert-warning" IsVisible="{Binding ShowDownloadDiskSpaceAlert}">
                  <TextBlock Classes="ant-alert-message" Text="{Binding DownloadDiskSpaceAlertText}" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Classes="settings-group">
                  <TextBlock Text="{Binding DownloadFilesGroupTitle}" Classes="settings-group-title"/>
                  <Grid Classes="settings-field-row tall" ColumnDefinitions="108,12,*">
                    <TextBlock Grid.Column="0" Text="{Binding DownloadSaveDirLabel}" Classes="settings-field-label" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="2" Classes="settings-path-row">
                      <TextBlock Text="{Binding DownloadDirectory}" Classes="settings-field-value-text" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding DownloadDirectory}"/>
                      <StackPanel Classes="settings-control-inline" Orientation="Horizontal" Spacing="8">
                        <Button Content="{Binding PickDownloadFolderLabel}" Classes="flat-btn btn-toolbar" Command="{Binding PickDownloadFolderCommand}"/>
                        <Button Content="{Binding DownloadOpenLabel}" Classes="flat-btn btn-toolbar" Command="{Binding OpenDownloadDirectoryCommand}" IsVisible="{Binding CanOpenDownloadDirectory}"/>
                        <Button Content="{Binding DownloadCopyPathLabel}" Classes="flat-btn btn-toolbar" Command="{Binding CopyDownloadDirectoryCommand}"/>
                      </StackPanel>
                    </StackPanel></Grid>
                  <Grid Classes="settings-field-row" ColumnDefinitions="108,12,*">
                    <TextBlock Grid.Column="0" Text="{Binding DownloadConcurrencyLabel}" Classes="settings-field-label"/>
                    <Grid Grid.Column="2" Classes="settings-inline-control settings-inline-control-compact" ColumnDefinitions="*,48" VerticalAlignment="Center">
                      <Slider Grid.Column="0" Minimum="1" Maximum="8" Value="{Binding MaxDownloads}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding DownloadConcurrencySummary}" Classes="settings-slider-value" HorizontalAlignment="Right"/></Grid></Grid>
                  <Grid Classes="settings-field-row" ColumnDefinitions="108,12,*">
                    <TextBlock Grid.Column="0" Text="{Binding PlaybackDefaultQualityLabel}" Classes="settings-field-label" ToolTip.Tip="{Binding PlaybackDefaultQualityCaption}"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding DefaultQualityOptionLabels}" SelectedIndex="{Binding DefaultDownloadQualityIndex}" Classes="field-select settings-field-control" VerticalAlignment="Center"/></Grid>
                </StackPanel>
                <StackPanel Classes="settings-group">
                  <TextBlock Text="{Binding DownloadCacheGroupTitle}" Classes="settings-group-title"/>
                  <Grid Classes="settings-field-row settings-switch-row" ColumnDefinitions="108,12,*">
                    <TextBlock Grid.Column="0" Text="{Binding NasCacheOnPlayLabel}" Classes="settings-field-label" ToolTip.Tip="{Binding NasCacheOnPlayCaption}"/>
                    <ToggleSwitch Grid.Column="2" IsChecked="{Binding NasCacheOnPlay}" Classes="ant-switch" ToolTip.Tip="{Binding NasCacheOnPlayCaption}"/></Grid>
                  <Grid Classes="settings-field-row" ColumnDefinitions="108,12,*" IsVisible="{Binding ShowNasDownloadTargetLibrary}">
                    <TextBlock Grid.Column="0" Text="{Binding NasDownloadTargetLibraryLabel}" Classes="settings-field-label" ToolTip.Tip="{Binding NasDownloadTargetLibraryCaption}"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding NasDownloadTargetLibraryLabels}" SelectedIndex="{Binding NasDownloadTargetLibraryIndex}" Classes="field-select settings-field-control settings-field-control-wide" VerticalAlignment="Center" ToolTip.Tip="{Binding NasDownloadTargetLibraryCaption}"/></Grid>
                  <Grid Classes="settings-field-row" ColumnDefinitions="108,12,*">
                    <TextBlock Grid.Column="0" Text="{Binding NasPlaybackCacheStatsLabel}" Classes="settings-field-label"/>
                    <TextBlock Grid.Column="2" Text="{Binding NasPlaybackCacheStatsText}" Classes="settings-field-value-text" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid>
                  <Grid Classes="settings-field-row" ColumnDefinitions="108,12,*">
                    <TextBlock Grid.Column="0" Text="{Binding DownloadClearCacheLabel}" Classes="settings-field-label"/>
                    <Button Grid.Column="2" Content="{Binding NasPlaybackCacheClearLabel}" Classes="flat-btn btn-toolbar" HorizontalAlignment="Left"
                            Command="{Binding ClearNasPlaybackCacheCommand}" IsEnabled="{Binding CanClearNasPlaybackCache}"/></Grid>
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <!-- ====== DataBackup ====== -->
            <StackPanel Classes="settings-data-page" IsVisible="{Binding SelectedSection, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter={x:Static pvm:SettingsSectionKind.DataBackup}}">
              <StackPanel Classes="settings-section settings-section-body settings-data-body">
                <StackPanel Classes="settings-group settings-overview-stats-group">
                  <TextBlock Text="{Binding OverviewLibraryStatsTitle}" Classes="settings-group-title"/>
                  <TextBlock Text="{Binding OverviewLibraryEmptyGuidance}" Classes="settings-overview-empty-copy" TextWrapping="Wrap" IsVisible="{Binding ShowOverviewLibraryEmptyGuidance}"/>
                  <Grid Classes="settings-overview-kpi-grid" ColumnDefinitions="*,*,*,*,*">
                    <Border Grid.Column="0" Classes="settings-overview-kpi-card" Margin="{DynamicResource SettingsOverviewKpiCardGapMargin}">
                      <StackPanel Classes="settings-overview-kpi-cell" Spacing="4">
                        <TextBlock Text="{Binding OverviewTracksDisplay}" Classes="settings-overview-kpi-card-value" Classes.settings-overview-kpi-value-empty="{Binding OverviewTracksKpiIsPlaceholder}"/>
                        <TextBlock Text="{Binding GeneralKpiTracksLabel}" Classes="settings-overview-kpi-card-label"/>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="settings-overview-kpi-card" Margin="{DynamicResource SettingsOverviewKpiCardGapMargin}">
                      <StackPanel Classes="settings-overview-kpi-cell" Spacing="4">
                        <TextBlock Text="{Binding OverviewAlbumsDisplay}" Classes="settings-overview-kpi-card-value" Classes.settings-overview-kpi-value-empty="{Binding OverviewAlbumsKpiIsPlaceholder}"/>
                        <TextBlock Text="{Binding GeneralKpiAlbumsLabel}" Classes="settings-overview-kpi-card-label"/>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="settings-overview-kpi-card" Margin="{DynamicResource SettingsOverviewKpiCardGapMargin}">
                      <StackPanel Classes="settings-overview-kpi-cell" Spacing="4">
                        <TextBlock Text="{Binding OverviewArtistsDisplay}" Classes="settings-overview-kpi-card-value" Classes.settings-overview-kpi-value-empty="{Binding OverviewArtistsKpiIsPlaceholder}"/>
                        <TextBlock Text="{Binding GeneralKpiArtistsLabel}" Classes="settings-overview-kpi-card-label"/>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Classes="settings-overview-kpi-card" Margin="{DynamicResource SettingsOverviewKpiCardGapMargin}">
                      <StackPanel Classes="settings-overview-kpi-cell" Spacing="4">
                        <TextBlock Text="{Binding OverviewTotalSizeText}" Classes="settings-overview-kpi-card-value" Classes.settings-overview-kpi-value-empty="{Binding OverviewTracksKpiIsPlaceholder}"/>
                        <TextBlock Text="{Binding GeneralChipSizeLabel}" Classes="settings-overview-kpi-card-label"/>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Classes="settings-overview-kpi-card settings-overview-kpi-card-last">
                      <StackPanel Classes="settings-overview-kpi-cell" Spacing="4">
                        <TextBlock Text="{Binding OverviewPlayCountKpiDisplay}" Classes="settings-overview-kpi-card-value" Classes.settings-overview-kpi-value-empty="{Binding OverviewPlayCountKpiIsPlaceholder}"/>
                        <TextBlock Text="{Binding GeneralChipPlayCountLabel}" Classes="settings-overview-kpi-card-label"/>
                      </StackPanel>
                    </Border>
                  </Grid>
                </StackPanel>
                <StackPanel Classes="settings-group">
                  <TextBlock Text="{Binding BackupSectionTitle}" Classes="settings-group-title" ToolTip.Tip="{Binding BackupDescription}"/>
                  <StackPanel Classes="settings-control-inline" Orientation="Horizontal" Spacing="8">
                    <Button Content="{Binding BackupNowLabel}" Classes="primary btn-toolbar" Command="{Binding CreateBackupCommand}"/>
                    <Button Content="{Binding BackupOpenFolderLabel}" Classes="flat-btn btn-toolbar" Command="{Binding OpenBackupFolderCommand}" IsVisible="{Binding CanOpenBackupFolder}"/>
                  </StackPanel>
                  <Border Classes="settings-backup-table" HorizontalAlignment="Stretch">
                    <StackPanel>
                      <StackPanel Classes="settings-backup-empty" IsVisible="{Binding !HasBackupEntries}">
                        <TextBlock Text="{Binding BackupEmptyHint}" Classes="settings-field-caption" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel IsVisible="{Binding HasBackupEntries}">
                        <Border Classes="settings-backup-table-header-wrap">
                          <Grid Classes="settings-backup-table-header" ColumnDefinitions="*,Auto,Auto" HorizontalAlignment="Stretch">
                            <TextBlock Grid.Column="0" Text="{Binding BackupColumnNameLabel}" Classes="settings-backup-table-th"/>
                            <TextBlock Grid.Column="1" Text="{Binding BackupColumnMetaLabel}" Classes="settings-backup-table-th settings-backup-table-meta"/>
                            <TextBlock Grid.Column="2" Text="{Binding BackupColumnActionsLabel}" Classes="settings-backup-table-th settings-backup-table-action"/>
                          </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding BackupEntriesPage}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="pvm:SettingsBackupEntryViewModel">
                          <Border Classes="settings-backup-table-row"><Grid Classes="settings-backup-table-row-grid" ColumnDefinitions="*,Auto,Auto" HorizontalAlignment="Stretch">
                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Classes="settings-backup-table-td text-label" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding MetaText}" Classes="settings-backup-table-td text-caption settings-backup-table-meta"/>
                            <Button Grid.Column="2" Content="{Binding $parent[UserControl].((pvm:SettingsPageViewModel)DataContext).BackupRestoreLabel}" Classes="flat-btn btn-toolbar settings-backup-restore-action" Command="{Binding $parent[UserControl].((pvm:SettingsPageViewModel)DataContext).RestoreBackupCommand}" CommandParameter="{Binding}" HorizontalAlignment="Left"/></Grid></Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Grid Classes="settings-backup-pagination" ColumnDefinitions="*,Auto" IsVisible="{Binding HasBackupEntries}" HorizontalAlignment="Stretch">
                    <TextBlock Grid.Column="0" Text="{Binding BackupListSummary}" Classes="settings-field-caption settings-backup-pagination-info" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" IsVisible="{Binding ShowBackupPagination}">
                      <TextBlock Text="{Binding BackupPageInfoText}" Classes="settings-field-caption" VerticalAlignment="Center"/>
                      <Button Content="{Binding BackupPreviousPageLabel}" Classes="flat-btn btn-toolbar" Command="{Binding BackupPreviousPageCommand}" IsEnabled="{Binding CanBackupPreviousPage}"/>
                      <Button Content="{Binding BackupNextPageLabel}" Classes="flat-btn btn-toolbar" Command="{Binding BackupNextPageCommand}" IsEnabled="{Binding CanBackupNextPage}"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
                <StackPanel Classes="settings-group">
                  <TextBlock Text="{Binding AcoustIdLookupTitle}" Classes="settings-group-title" ToolTip.Tip="{Binding AcoustIdLookupHint}"/>
                  <Grid Classes="settings-field-row settings-switch-row" ColumnDefinitions="108,12,*">
                    <TextBlock Grid.Column="0" Text="{Binding AcoustIdEnableLabel}" Classes="settings-field-label" ToolTip.Tip="{Binding AcoustIdLookupHint}"/>
                    <ToggleSwitch Grid.Column="2" IsChecked="{Binding EnableAcoustIdFingerprintLookup}" Classes="ant-switch"
                                  automation:AutomationProperties.Name="{Binding AcoustIdEnableLabel}"/>
                  </Grid>
                  <StackPanel IsVisible="{Binding ShowAcoustIdDetails}" Spacing="{DynamicResource SettingsGroupBodySpacing}">
                    <Grid Classes="settings-field-row" ColumnDefinitions="108,12,*">
                      <TextBlock Grid.Column="0" Text="{Binding AcoustIdApiKeyLabel}" Classes="settings-field-label" ToolTip.Tip="{Binding AcoustIdApiKeyToolTip}"/>
                      <TextBox Grid.Column="2" Text="{Binding AcoustIdApiKey}" Watermark="{Binding AcoustIdApiKeyWatermark}" Classes="settings-url-input" MaxWidth="{DynamicResource ControlWidthStandard}" ToolTip.Tip="{Binding AcoustIdApiKeyToolTip}"/>
                    </Grid>
                    <TextBlock Text="{Binding AcoustIdPrerequisiteHint}" Classes="settings-field-caption settings-field-follow-caption" TextWrapping="Wrap"/>
                    <Border Classes="ant-alert ant-alert-warning" IsVisible="{Binding ShowAcoustIdSetupWarning}">
                      <TextBlock Classes="ant-alert-message" Text="{Binding AcoustIdSetupWarningText}" TextWrapping="Wrap"/>
                    </Border>
                    <Grid Classes="settings-field-row" ColumnDefinitions="108,12,*">
                      <TextBlock Grid.Column="0" Text="{Binding AcoustIdTestRowLabel}" Classes="settings-field-label"/>
                      <StackPanel Grid.Column="2" Classes="settings-control-inline" Orientation="Horizontal" Spacing="8">
                        <Button Content="{Binding AcoustIdTestLabel}" Classes="flat-btn btn-toolbar settings-connection-test-btn"
                                Command="{Binding TestAcoustIdLookupCommand}"
                                automation:AutomationProperties.Name="{Binding AcoustIdTestLabel}"/>
                        <Border Classes="settings-connection-pill" Classes.success="{Binding AcoustIdTestButtonOk}" Classes.error="{Binding AcoustIdTestFailed}"
                                IsVisible="{Binding ShowAcoustIdTestResult}" VerticalAlignment="Center">
                          <TextBlock Text="{Binding AcoustIdTestResultText}" TextTrimming="CharacterEllipsis" MaxWidth="{DynamicResource ControlWidthStandard}"/>
                        </Border>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <!-- ====== OnlineSources ====== -->
            <StackPanel Classes="settings-online-page" IsVisible="{Binding ShowAdvancedOnlinePanel}">
              <StackPanel Classes="settings-section settings-section-body settings-online-body">
                <Border Classes="ant-alert ant-alert-warning" IsVisible="{Binding ShowOnlineDownloadAlert}">
                  <TextBlock Classes="ant-alert-message" Text="{Binding PendingMusicApiUpdateNotice}" TextWrapping="Wrap"/>
                </Border>

                <StackPanel Classes="settings-group">
                  <TextBlock Text="{Binding OnlineConnectionHealthTitle}" Classes="settings-group-title"/>
                  <StackPanel Classes="settings-online-status-summary" Spacing="6">
                    <Grid Classes="settings-online-status-row" ColumnDefinitions="72,12,Auto,*">
                      <TextBlock Grid.Column="0" Text="{Binding OnlineUnifiedApiLabel}" Classes="settings-online-status-label" VerticalAlignment="Center"/>
                      <Border Grid.Column="2" Classes="settings-connection-pill"
                              Classes.success="{Binding UnifiedApiStatusIsOk}"
                              Classes.error="{Binding UnifiedApiStatusIsError}"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding UnifiedApiStatusText}"/>
                      </Border>
                    </Grid>
                    <Grid Classes="settings-online-status-row" ColumnDefinitions="72,12,Auto,*">
                      <TextBlock Grid.Column="0" Text="{Binding OnlineNetEaseLabel}" Classes="settings-online-status-label" VerticalAlignment="Center"/>
                      <Border Grid.Column="2" Classes="settings-connection-pill"
                              Classes.success="{Binding NetEaseApiStatusIsOk}"
                              Classes.error="{Binding NetEaseApiStatusIsError}"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding NetEaseApiStatusText}"/>
                      </Border>
                    </Grid>
                    <Grid Classes="settings-online-status-row" ColumnDefinitions="72,12,*">
                      <TextBlock Grid.Column="0" Text="{Binding OnlineLoginStatusLabel}" Classes="settings-online-status-label" VerticalAlignment="Top" Margin="0,4,0,0"/>
                      <Border Grid.Column="2" Classes="settings-connection-pill"
                              Classes.success="{Binding OnlineLoginStatusIsOk}"
                              Classes.error="{Binding OnlineLoginStatusNeedsAttention}"
                              IsVisible="{Binding OnlineLoginStatusSummary, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"
                              HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding OnlineLoginStatusSummary}" TextWrapping="Wrap" MaxWidth="{DynamicResource SettingsListMaxWidth}"/>
                      </Border>
                    </Grid>
                  </StackPanel>
                  <WrapPanel Classes="settings-connection-test-line settings-connection-test-primary" Orientation="Horizontal">
                    <StackPanel Classes="settings-connection-test-group" Orientation="Horizontal" Spacing="8">
                      <Button Content="{Binding OnlineTestUnifiedApiLabel}" Classes="flat-btn btn-toolbar settings-connection-test-btn" Command="{Binding TestUnifiedApiCommand}"/>
                      <Border Classes="settings-connection-pill" Classes.success="{Binding UnifiedApiTestSucceeded}" Classes.error="{Binding UnifiedApiTestFailed}" IsVisible="{Binding ShowUnifiedApiTestResult}">
                        <TextBlock Text="{Binding UnifiedApiTestResultText}" TextTrimming="CharacterEllipsis" MaxWidth="{DynamicResource ControlWidthStandard}"/>
                      </Border>
                    </StackPanel>
                    <StackPanel Classes="settings-connection-test-group" Orientation="Horizontal" Spacing="8">
                      <Button Content="{Binding OnlineTestNetEaseLabel}" Classes="flat-btn btn-toolbar settings-connection-test-btn" Command="{Binding TestNetEaseApiCommand}"/>
                      <Border Classes="settings-connection-pill" Classes.success="{Binding NetEaseApiTestSucceeded}" Classes.error="{Binding NetEaseApiTestFailed}" IsVisible="{Binding ShowNetEaseApiTestResult}">
                        <TextBlock Text="{Binding NetEaseApiTestResultText}" TextTrimming="CharacterEllipsis" MaxWidth="{DynamicResource ControlWidthStandard}"/>
                      </Border>
                    </StackPanel>
                    <Button Content="{Binding OnlinePlatformLoginLabel}" Classes="flat-btn btn-toolbar" Command="{Binding OpenMusicApiAccountCommand}"/>
                  </WrapPanel>
                  <WrapPanel Classes="settings-connection-test-line settings-connection-test-secondary" Orientation="Horizontal">
                    <Button Content="{Binding OnlineDiagnoseLoginLabel}" Classes="flat-btn btn-toolbar settings-connection-secondary-btn" Command="{Binding DiagnosePlatformLoginCommand}"/>
                    <Button Content="{Binding OnlineRunFullProbeLabel}" Classes="flat-btn btn-toolbar settings-connection-secondary-btn"
                            Command="{Binding RunFullApiProbeCommand}" IsEnabled="{Binding !IsRunningApiProbe}"/>
                    <Button Content="{Binding OnlineTroubleshootLabel}" Classes="flat-btn btn-toolbar settings-connection-secondary-btn" Command="{Binding GoToUpdateDiagnosticsTroubleshootCommand}" IsVisible="{Binding ShowConnectionTestTroubleshootLink}"/>
                  </WrapPanel>
                  <TextBlock Text="{Binding PlatformLoginDiagnoseResultText}" Classes="settings-field-caption" TextWrapping="Wrap"
                             IsVisible="{Binding ShowPlatformLoginDiagnoseResult}"/>
                  <TextBlock Text="{Binding ApiProbeSummaryText}" Classes="settings-field-caption" TextWrapping="Wrap"
                             IsVisible="{Binding ShowApiProbeResults}"/>
                  <ItemsControl ItemsSource="{Binding ApiProbeRows}" IsVisible="{Binding ShowApiProbeResults}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="pvm:SettingsApiProbeRowViewModel">
                        <Grid ColumnDefinitions="108,*,Auto" Margin="{DynamicResource SectionSplitMargin}">
                          <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="text-caption" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="{Binding Url}" Classes="text-caption" TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                          <Border Grid.Column="2" Classes="settings-connection-pill"
                                  Classes.success="{Binding Ok}" Classes.error="{Binding !Ok}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" MaxWidth="{DynamicResource ControlWidthStandard}"/>
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <StackPanel Classes="settings-group">
                  <TextBlock Text="{Binding OnlineBundledServicesTitle}" Classes="settings-group-title"/>
                  <Border Classes="ant-alert ant-alert-info" IsVisible="{Binding ShowBundledMusicApiUnsupportedHint}">
                    <TextBlock Classes="ant-alert-message" Text="{Binding BundledMusicApiUnsupportedHint}" TextWrapping="Wrap"/>
                  </Border>
                  <WrapPanel Classes="settings-online-switch-row" Orientation="Horizontal">
                    <Grid Classes="settings-online-switch-cell" ColumnDefinitions="Auto,8,Auto" IsVisible="{Binding IsBundledMusicApiFeatureAvailable}">
                      <TextBlock Grid.Column="0" Text="{Binding OnlineAutoStartBundledApiLabel}" Classes="settings-online-switch-label"/>
                      <ToggleSwitch Grid.Column="2" IsChecked="{Binding AutoStartBundledMusicApi}" Classes="ant-switch"/></Grid>
                    <Grid Classes="settings-online-switch-cell" ColumnDefinitions="Auto,8,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding OnlineAutoStartNetEaseApiLabel}" Classes="settings-online-switch-label"/>
                      <ToggleSwitch Grid.Column="2" IsChecked="{Binding AutoStartBundledNetEaseApi}" Classes="ant-switch"/></Grid>
                    <Grid Classes="settings-online-switch-cell" ColumnDefinitions="Auto,8,Auto" IsVisible="{Binding IsBundledMusicApiFeatureAvailable}">
                      <TextBlock Grid.Column="0" Text="{Binding OnlineAutoCheckLabel}" Classes="settings-online-switch-label" ToolTip.Tip="{Binding OnlineWeeklyBundledApiCheckCaption}"/>
                      <ToggleSwitch Grid.Column="2" IsChecked="{Binding CheckBundledMusicApiUpdates}" Classes="ant-switch" ToolTip.Tip="{Binding OnlineWeeklyBundledApiCheckCaption}"/></Grid>
                  </WrapPanel>
                  <Grid ColumnDefinitions="Auto,12,*" Margin="0,10,0,0">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding OnlineHeroPromoSourceLabel}" Classes="settings-online-switch-label"/>
                      <TextBlock Text="{Binding OnlineHeroPromoSourceCaption}" Classes="settings-field-caption" TextWrapping="Wrap" MaxWidth="280"/>
                    </StackPanel>
                    <ComboBox Grid.Column="2"
                              Classes="discover-combo"
                              Width="180"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding DiscoverHeroPromoSourceLabels}"
                              SelectedIndex="{Binding DiscoverHeroPromoSourceIndex}"/>
                  </Grid>
                </StackPanel>

                <StackPanel Classes="settings-online-advanced-section">
                  <Border Classes="settings-online-advanced-divider"/>
                  <TextBlock Text="{Binding OnlineAdvancedSectionTitle}" Classes="settings-online-advanced-label"/>
                  <TextBlock Text="{Binding OnlineAdvancedSectionCaption}" Classes="settings-field-caption settings-online-advanced-caption" TextWrapping="Wrap"/>

                <StackPanel Classes="settings-group settings-online-disclosure settings-disclosure">
                  <ToggleButton Classes="settings-online-disclosure-header"
                                IsChecked="{Binding IsPlatformApisExpanded}">
                    <Grid ColumnDefinitions="Auto,8,*" MinHeight="32">
                      <Panel Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center">
                        <TextBlock Text="{StaticResource IconGlyphChevronRight}" Classes="icon-xs settings-online-disclosure-chevron"
                                   IsVisible="{Binding !IsPlatformApisExpanded}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="{StaticResource IconGlyphChevronDown}" Classes="icon-xs settings-online-disclosure-chevron"
                                   IsVisible="{Binding IsPlatformApisExpanded}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Panel>
                      <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding OnlinePlatformApisTitle}" Classes="settings-online-disclosure-title"/>
                        <TextBlock Text="{Binding PlatformDisclosureCaption}" Classes="settings-field-caption settings-online-disclosure-caption"
                                   Classes.attention="{Binding ShowPlatformNeedsAttentionBadge}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding !IsPlatformApisExpanded}"/>
                      </StackPanel>
                    </Grid>
                  </ToggleButton>
                  <StackPanel Classes="settings-online-disclosure-body" IsVisible="{Binding IsPlatformApisExpanded}">
                    <UniformGrid Classes="settings-online-pair-grid" Columns="2">
                      <Grid Classes="settings-online-pair-cell" ColumnDefinitions="Auto,8,*">
                        <TextBlock Grid.Column="0" Text="{Binding OnlineUnifiedApiLabel}" Classes="settings-online-pair-label"/>
                        <TextBox Grid.Column="2" Text="{Binding MusicApiBaseUrl}" Classes="settings-url-input settings-online-pair-input"/></Grid>
                      <Grid Classes="settings-online-pair-cell" ColumnDefinitions="Auto,8,*">
                        <TextBlock Grid.Column="0" Text="{Binding OnlineNetEaseLabel}" Classes="settings-online-pair-label"/>
                        <TextBox Grid.Column="2" Text="{Binding NetEaseApiUrl}" Classes="settings-url-input settings-online-pair-input"/></Grid>
                      <Grid Classes="settings-online-pair-cell" ColumnDefinitions="Auto,8,*">
                        <TextBlock Grid.Column="0" Text="{Binding OnlineQQMusicLabel}" Classes="settings-online-pair-label"/>
                        <TextBox Grid.Column="2" Text="{Binding QqMusicApiUrl}" Classes="settings-url-input settings-online-pair-input"/></Grid>
                      <Grid Classes="settings-online-pair-cell" ColumnDefinitions="Auto,8,*">
                        <TextBlock Grid.Column="0" Text="{Binding OnlineQuarkCookieLabel}" Classes="settings-online-pair-label"/>
                        <Grid Grid.Column="2" ColumnDefinitions="*,Auto">
                          <TextBox Text="{Binding MyFreeMp3QuarkCookies}" Classes="settings-url-input settings-online-pair-input"/>
                          <Border Grid.Column="1" Classes="settings-connection-pill" Margin="8,0,0,0"
                                  Classes.success="{Binding HasQuarkCookieConfigured}"
                                  Classes.error="{Binding !HasQuarkCookieConfigured}"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding QuarkCookieStatusText}"/>
                          </Border>
                        </Grid></Grid>
                    </UniformGrid>
                  </StackPanel>
                </StackPanel>

                <StackPanel Classes="settings-group settings-online-disclosure settings-disclosure">
                  <ToggleButton Classes="settings-online-disclosure-header"
                                IsChecked="{Binding IsRecognitionExpanded}">
                    <Grid ColumnDefinitions="Auto,8,*" MinHeight="32">
                      <Panel Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center">
                        <TextBlock Text="{StaticResource IconGlyphChevronRight}" Classes="icon-xs settings-online-disclosure-chevron"
                                   IsVisible="{Binding !IsRecognitionExpanded}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="{StaticResource IconGlyphChevronDown}" Classes="icon-xs settings-online-disclosure-chevron"
                                   IsVisible="{Binding IsRecognitionExpanded}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Panel>
                      <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding OnlineRecognitionGroupTitle}" Classes="settings-online-disclosure-title"
                                   ToolTip.Tip="{Binding MusicRecognitionSetupHint}"/>
                        <TextBlock Text="{Binding RecognitionDisclosureCaption}" Classes="settings-field-caption settings-online-disclosure-caption"
                                   Classes.attention="{Binding ShowRecognitionNeedsAttentionBadge}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding !IsRecognitionExpanded}"/>
                      </StackPanel>
                    </Grid>
                  </ToggleButton>
                  <StackPanel Classes="settings-online-disclosure-body" IsVisible="{Binding IsRecognitionExpanded}">
                    <Grid Classes="settings-field-row tall" ColumnDefinitions="108,12,*">
                      <TextBlock Grid.Column="0" Text="{Binding OnlineRecognitionApiLabel}" Classes="settings-field-label" ToolTip.Tip="{Binding MusicRecognitionSetupHint}" VerticalAlignment="Top"/>
                      <StackPanel Grid.Column="2" Classes="settings-field-stack">
                        <TextBox Text="{Binding MusicRecognitionApiUrl}" Classes="settings-url-input settings-field-wide" ToolTip.Tip="{Binding MusicRecognitionSetupHint}"/>
                        <StackPanel Classes="settings-control-inline" Orientation="Horizontal" Spacing="8">
                          <Button Content="{Binding OnlineConfigGuideLabel}" Classes="flat-btn btn-toolbar" Command="{Binding OpenMusicRecognitionGuideCommand}"/>
                          <Button Content="{Binding OnlineTestRecognitionLabel}" Classes="flat-btn btn-toolbar settings-connection-test-btn" Command="{Binding TestMusicRecognitionCommand}"/>
                          <Border Classes="settings-connection-pill" Classes.success="{Binding MusicRecognitionTestSucceeded}" Classes.error="{Binding MusicRecognitionTestFailed}" IsVisible="{Binding ShowMusicRecognitionTestResult}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MusicRecognitionTestResultText}" TextTrimming="CharacterEllipsis" MaxWidth="{DynamicResource ControlWidthStandard}"/>
                          </Border>
                          <Button Content="{Binding OnlineUseNetEaseRecognitionLabel}" Classes="flat-btn btn-toolbar" Command="{Binding ApplyNetEaseRecognitionDefaultsCommand}" IsVisible="{Binding ShowNetEaseRecognitionSetup}"/>
                        </StackPanel>
                      </StackPanel></Grid>
                  </StackPanel>
                </StackPanel>

                <StackPanel Classes="settings-group settings-online-disclosure settings-disclosure">
                  <ToggleButton Classes="settings-online-disclosure-header"
                                IsChecked="{Binding IsGatherersExpanded}">
                    <Grid ColumnDefinitions="Auto,8,*" MinHeight="32">
                      <Panel Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center">
                        <TextBlock Text="{StaticResource IconGlyphChevronRight}" Classes="icon-xs settings-online-disclosure-chevron"
                                   IsVisible="{Binding !IsGatherersExpanded}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="{StaticResource IconGlyphChevronDown}" Classes="icon-xs settings-online-disclosure-chevron"
                                   IsVisible="{Binding IsGatherersExpanded}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Panel>
                      <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding OnlineGathererSourcesTitle}" Classes="settings-online-disclosure-title"/>
                        <TextBlock Text="{Binding GatherersDisclosureCaption}" Classes="settings-field-caption settings-online-disclosure-caption"
                                   Classes.attention="{Binding ShowGatherersNeedsAttentionBadge}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding !IsGatherersExpanded}"/>
                      </StackPanel>
                    </Grid>
                  </ToggleButton>
                  <StackPanel Classes="settings-online-disclosure-body" IsVisible="{Binding IsGatherersExpanded}">
                    <DockPanel Classes="settings-gatherer-toolbar" LastChildFill="False" Margin="0,0,0,8">
                      <Button DockPanel.Dock="Left" Content="{Binding OnlineTestAllGatherersLabel}" Classes="flat-btn btn-toolbar" Command="{Binding ProbeGatherersCommand}"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding GathererItems}" Classes="settings-gatherer-list">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="{DynamicResource SettingsGathererColumns}"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pvm:GathererItemViewModel">
                          <Grid Classes="settings-gatherer-row"
                                ColumnDefinitions="*,Auto"
                                Classes.gatherer-row-disabled="{Binding !IsEnabled}"
                                ToolTip.Tip="{Binding StatusText}"
                                ToolTip.ShowDelay="300">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding DisplayName}"
                                       Classes="settings-gatherer-name"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding IsEnabled}"
                                          Classes="ant-switch"
                                          VerticalAlignment="Center"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <!-- ====== UpdateDiagnostics ====== -->
            <StackPanel Classes="settings-section settings-update-page" IsVisible="{Binding ShowAdvancedUpdatePanel}">
              <Border Classes="antd-card-tabs settings-update-diagnostics-tabs" HorizontalAlignment="Stretch"><Panel>
                <Border Classes="antd-card-tab-content settings-update-tab-content" Margin="{DynamicResource AntdCardTabContentMargin}" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                  <StackPanel Classes="settings-group-body" Spacing="{DynamicResource SettingsGroupBodySpacing}">

                    <StackPanel IsVisible="{Binding IsUpdateDiagnosticsAppTabSelected}" Classes="settings-section-body settings-update-app-tab">
                      <StackPanel Classes="settings-group">
                        <TextBlock Text="{Binding UpdateAppGroupTitle}" Classes="settings-group-title"/>
                        <Grid Classes="settings-field-row" ColumnDefinitions="108,12,*">
                          <TextBlock Grid.Column="0" Text="{Binding UpdateCurrentVersionLabel}" Classes="settings-field-label"/>
                          <StackPanel Grid.Column="2" Classes="settings-control-inline">
                            <TextBlock Text="{Binding VersionText}" Classes="settings-field-value-text" VerticalAlignment="Center"/>
                            <Button Content="{Binding UpdateCheckLabel}" Classes="flat-btn btn-toolbar" Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding !IsCheckingAppUpdate}"/>
                            <Border Classes="settings-update-pill" Classes.settings-update-status-new="{Binding AppUpdateStatusIsNew}" Classes.settings-update-status-ok="{Binding AppUpdateStatusIsOk}" Classes.settings-update-status-error="{Binding AppUpdateStatusIsError}" IsVisible="{Binding ShowAppUpdateStatus}">
                              <TextBlock Text="{Binding AppUpdateStatusText}" Classes="settings-update-status-text"/>
                            </Border>
                          </StackPanel></Grid>
                        <Border Classes="settings-update-info" IsVisible="{Binding HasPendingUpdate}">
                          <StackPanel Classes="settings-control-inline">
                            <TextBlock Text="{Binding UpdatePendingInstallLabel}" Classes="settings-update-info-text" VerticalAlignment="Center"/>
                            <Button Content="{Binding UpdateRestartInstallLabel}" Classes="primary btn-toolbar" Command="{Binding ApplyUpdateAndRestartCommand}"/>
                          </StackPanel></Border>
                      </StackPanel>
                      <StackPanel Classes="settings-group">
                        <TextBlock Text="{Binding UpdatePreferencesGroupTitle}" Classes="settings-group-title"/>
                        <Grid Classes="settings-field-row" ColumnDefinitions="108,12,*">
                          <TextBlock Grid.Column="0" Text="{Binding UpdateFrequencyFieldLabel}" Classes="settings-field-label" ToolTip.Tip="{Binding UpdateFrequencyToolTip}"/>
                          <ComboBox Grid.Column="2" ItemsSource="{Binding UpdateFrequencyOptionLabels}" SelectedIndex="{Binding UpdateFrequencyIndex}" Classes="field-select settings-field-control settings-update-frequency-combo" VerticalAlignment="Center"/></Grid>
                        <StackPanel Classes="settings-group settings-online-disclosure settings-disclosure">
                          <ToggleButton Classes="settings-online-disclosure-header"
                                        IsChecked="{Binding IsUpdateFeedExpanded}">
                            <Grid ColumnDefinitions="Auto,8,*" MinHeight="32">
                              <Panel Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center">
                                <TextBlock Text="{StaticResource IconGlyphChevronRight}" Classes="icon-xs settings-online-disclosure-chevron"
                                           IsVisible="{Binding !IsUpdateFeedExpanded}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="{StaticResource IconGlyphChevronDown}" Classes="icon-xs settings-online-disclosure-chevron"
                                           IsVisible="{Binding IsUpdateFeedExpanded}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Panel>
                              <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UpdateFeedUrlLabel}" Classes="settings-online-disclosure-title"/>
                                <TextBlock Text="{Binding UpdateFeedDisclosureCaption}" Classes="settings-field-caption settings-online-disclosure-caption"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding !IsUpdateFeedExpanded}"/>
                              </StackPanel>
                            </Grid>
                          </ToggleButton>
                          <StackPanel Classes="settings-online-disclosure-body" IsVisible="{Binding IsUpdateFeedExpanded}">
                            <Grid Classes="settings-field-row" ColumnDefinitions="108,12,*">
                              <TextBlock Grid.Column="0" Text="{Binding UpdateFeedUrlLabel}" Classes="settings-field-label" ToolTip.Tip="{Binding UpdateFeedAdvancedLabel}"/>
                              <TextBox Grid.Column="2" Text="{Binding UpdateFeedUrl}" Watermark="{Binding UpdateFeedUrlPlaceholder}" Classes="discover-field field-input settings-field-wide"/></Grid>
                          </StackPanel>
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsUpdateDiagnosticsBundledApiTabSelected}" Classes="settings-section-body settings-update-bundled-tab">
                      <Border Classes="ant-alert ant-alert-info" IsVisible="{Binding ShowBundledMusicApiUnsupportedHint}">
                        <TextBlock Classes="ant-alert-message" Text="{Binding BundledMusicApiUnsupportedHint}" TextWrapping="Wrap"/>
                      </Border>
                      <StackPanel Classes="settings-group" IsVisible="{Binding IsBundledMusicApiFeatureAvailable}">
                        <TextBlock Text="{Binding UpdateBundledGroupTitle}" Classes="settings-group-title"/>
                        <Grid Classes="settings-field-row" ColumnDefinitions="108,12,*">
                          <TextBlock Grid.Column="0" Text="{Binding OnlineBundledApiLabel}" Classes="settings-field-label"/>
                          <StackPanel Grid.Column="2" Classes="settings-control-inline">
                            <TextBlock Text="{Binding BundledMusicApiVersionText}" Classes="settings-field-value-text" VerticalAlignment="Center"/>
                            <Button Content="{Binding UpdateCheckLabel}" Classes="flat-btn btn-toolbar" Command="{Binding CheckBundledMusicApiUpdateCommand}" IsEnabled="{Binding CanCheckBundledMusicApiUpdate}"/>
                            <Button Content="{Binding UpdateDownloadInstallLabel}" Classes="primary btn-toolbar" Command="{Binding ApplyBundledMusicApiUpdateCommand}" IsVisible="{Binding HasPendingMusicApiUpdate}"/>
                            <Border Classes="settings-update-pill" Classes.settings-update-status-new="{Binding MusicApiUpdateStatusIsNew}" Classes.settings-update-status-ok="{Binding MusicApiUpdateStatusIsOk}" Classes.settings-update-status-error="{Binding MusicApiUpdateStatusIsError}" IsVisible="{Binding ShowMusicApiUpdateStatus}">
                              <TextBlock Text="{Binding MusicApiUpdateStatusText}" Classes="settings-update-status-text"/>
                            </Border>
                          </StackPanel></Grid>
                        <Grid Classes="settings-field-row" ColumnDefinitions="108,12,*">
                          <TextBlock Grid.Column="0" Text="{Binding OnlineApiUpdateRepoLabel}" Classes="settings-field-label" ToolTip.Tip="{Binding OnlineApiUpdateRepoCaption}"/>
                          <StackPanel Grid.Column="2" Spacing="4">
                            <TextBox Text="{Binding BundledMusicApiUpdateGithubRepo}"
                                     Watermark="{Binding OnlineApiUpdateRepoPlaceholder}"
                                     Classes="discover-field field-input settings-field-wide"
                                     ToolTip.Tip="{Binding OnlineApiUpdateRepoCaption}"/>
                            <TextBlock Text="{Binding OnlineApiUpdateRepoCaption}" Classes="settings-field-caption" TextWrapping="Wrap"/>
                          </StackPanel></Grid>
                        <Grid Classes="settings-field-row" ColumnDefinitions="108,12,*">
                          <TextBlock Grid.Column="0" Text="{Binding OnlineBundledNetEaseLabel}" Classes="settings-field-label"/>
                          <TextBlock Grid.Column="2" Text="{Binding BundledNetEaseApiVersionText}" Classes="settings-field-value-text" VerticalAlignment="Center"/></Grid>
                      </StackPanel>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsUpdateDiagnosticsChangelogTabSelected}" Classes="settings-changelog-panel settings-group">
                      <TextBlock Text="{Binding UpdateNoHistoryLabel}" Classes="settings-update-status-empty" IsVisible="{Binding !HasUpdateHistoryEntries}"/>
                      <ScrollViewer Classes="settings-changelog-scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasUpdateHistoryEntries}">
                        <ItemsControl ItemsSource="{Binding UpdateHistoryEntries}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="pvm:ReleaseNoteDayViewModel">
                          <StackPanel Classes="settings-release-day">
                            <TextBlock Text="{Binding Header}" Classes="settings-release-header"/>
                            <ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate>
                              <Grid Classes="settings-release-bullet-row" ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="•" Classes="settings-release-bullet-mark"/>
                                <TextBlock Grid.Column="1" Text="{Binding}" Classes="settings-release-bullet" TextWrapping="Wrap"/>
                              </Grid>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                          </StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                      </ScrollViewer>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsUpdateDiagnosticsTroubleshootTabSelected}" Classes="settings-section-body settings-update-troubleshoot-tab">
                      <StackPanel Classes="settings-group">
                        <TextBlock Text="{Binding DiagnosticsApiProbeTitle}" Classes="settings-group-title"/>
                        <TextBlock Text="{Binding DiagnosticsApiProbeHint}" Classes="settings-field-caption" TextWrapping="Wrap"/>
                        <WrapPanel Classes="settings-field-actions" Orientation="Horizontal">
                          <Button Content="{Binding OnlineRunFullProbeLabel}" Classes="flat-btn btn-toolbar"
                                  Command="{Binding RunFullApiProbeCommand}" IsEnabled="{Binding !IsRunningApiProbe}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding ApiProbeSummaryText}" Classes="settings-field-caption" TextWrapping="Wrap"
                                   IsVisible="{Binding ShowApiProbeResults}"/>
                        <ItemsControl ItemsSource="{Binding ApiProbeRows}" IsVisible="{Binding ShowApiProbeResults}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pvm:SettingsApiProbeRowViewModel">
                              <Grid ColumnDefinitions="108,*,Auto" Margin="{DynamicResource SectionSplitMargin}">
                                <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="text-caption" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Url}" Classes="text-caption" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Classes="settings-connection-pill"
                                        Classes.success="{Binding Ok}" Classes.error="{Binding !Ok}" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" MaxWidth="{DynamicResource ControlWidthStandard}"/>
                                </Border>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <StackPanel Classes="settings-group">
                        <TextBlock Text="{Binding DiagnosticsToolsGroupTitle}" Classes="settings-group-title"/>
                        <WrapPanel Classes="settings-field-actions" Orientation="Horizontal">
                          <Button Content="{Binding DiagnosticsExportPackageLabel}" Classes="flat-btn btn-toolbar" Command="{Binding ExportDiagnosticsCommand}"/>
                          <Button Content="{Binding DiagnosticsExportSnapshotLabel}" Classes="flat-btn btn-toolbar" Command="{Binding ExportUsageInsightsCommand}"/>
                          <controls:PopconfirmHost Title="{Binding ResetUsagePopconfirmTitle}" Description="{Binding ResetUsagePopconfirmDescription}" ConfirmText="{Binding ResetUsagePopconfirmConfirm}" ConfirmIsDanger="True" ConfirmedCommand="{Binding ResetUsageInsightsCommand}">
                            <Button Content="{Binding DiagnosticsResetStatsLabel}" Classes="flat-btn btn-toolbar"/>
                          </controls:PopconfirmHost>
                        </WrapPanel>
                      </StackPanel>
                      <StackPanel Classes="settings-group settings-online-disclosure settings-disclosure">
                        <ToggleButton Classes="settings-online-disclosure-header"
                                      IsChecked="{Binding IsUsageInsightsExpanded}">
                          <Grid ColumnDefinitions="Auto,8,*" MinHeight="32">
                            <Panel Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center">
                              <TextBlock Text="{StaticResource IconGlyphChevronRight}" Classes="icon-xs settings-online-disclosure-chevron"
                                         IsVisible="{Binding !IsUsageInsightsExpanded}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              <TextBlock Text="{StaticResource IconGlyphChevronDown}" Classes="icon-xs settings-online-disclosure-chevron"
                                         IsVisible="{Binding IsUsageInsightsExpanded}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Panel>
                            <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding DiagnosticsUsageStatsTitle}" Classes="settings-online-disclosure-title"/>
                              <TextBlock Text="{Binding DiagnosticsUsageDisclosureCaption}" Classes="settings-field-caption settings-online-disclosure-caption"
                                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                         IsVisible="{Binding !IsUsageInsightsExpanded}"/>
                            </StackPanel>
                          </Grid>
                        </ToggleButton>
                        <StackPanel Classes="settings-online-disclosure-body" IsVisible="{Binding IsUsageInsightsExpanded}" Spacing="{DynamicResource SettingsGroupBodySpacing}">
                          <TextBlock Text="{Binding UsageInsightsHint}" Classes="settings-field-caption" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding FunnelConversionText}" Classes="settings-usage-funnel" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding UsageCountersUpdatedAtText}" Classes="settings-field-caption"/>
                          <ItemsControl ItemsSource="{Binding UsageInsightRows}" Classes="settings-usage-kv-list"><ItemsControl.ItemTemplate><DataTemplate x:DataType="pvm:SettingsUsageInsightRowViewModel">
                            <Grid Classes="settings-usage-kv-row" ColumnDefinitions="120,8,*">
                              <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="settings-field-label"/>
                              <TextBlock Grid.Column="2"
                                         Text="{Binding Value}"
                                         Classes="settings-usage-kv-value"
                                         Classes.settings-usage-kv-value-mono="{Binding IsMonospace}"
                                         TextWrapping="Wrap"/>
                            </Grid>
                          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Classes="settings-group">
                        <TextBlock Text="{Binding DiagnosticsRecentStatusTitle}" Classes="settings-group-title"/>
                        <TextBlock Text="{Binding RecentStatusEmptyText}" Classes="settings-update-status-empty" IsVisible="{Binding !HasRecentStatusEvents}"/>
                        <Border Classes="settings-update-status-list" IsVisible="{Binding HasRecentStatusEvents}"><ItemsControl ItemsSource="{Binding RecentStatusEvents}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="svc:ShellStatusEvent">
                          <Grid Classes="settings-update-status-row" ColumnDefinitions="Auto,Auto,*">
                            <TextBlock Grid.Column="0" Text="{Binding TimestampText}" Classes="text-caption settings-update-status-time" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Width="3" Height="14" CornerRadius="1" Margin="{DynamicResource MarginTrailingSm}" VerticalAlignment="Center" Background="{Binding Level, Converter={x:Static conv:ShellStatusLevelToBrushConverter.Instance}}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Message}" Classes="text-caption" TextWrapping="Wrap" VerticalAlignment="Center"/>
                          </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel></Border>
                <Border Classes="antd-card-tab-rail" Margin="{DynamicResource AntdCardTabRailMargin}"/>
                <ScrollViewer VerticalAlignment="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Classes="antd-card-tab-nav"><StackPanel Orientation="Horizontal" Spacing="8">
                  <controls:AntdCardTab Title="{Binding UpdateDiagnosticsTabAppUpdateLabel}" IsSelected="{Binding IsUpdateDiagnosticsAppTabSelected}" SelectCommand="{Binding SelectUpdateDiagnosticsTabCommand}" CommandParameter="{x:Static pvm:UpdateDiagnosticsTabKind.AppUpdate}"/>
                  <controls:AntdCardTab Title="{Binding UpdateDiagnosticsTabBundledApiLabel}" IsSelected="{Binding IsUpdateDiagnosticsBundledApiTabSelected}" SelectCommand="{Binding SelectUpdateDiagnosticsTabCommand}" CommandParameter="{x:Static pvm:UpdateDiagnosticsTabKind.BundledApi}"/>
                  <controls:AntdCardTab Title="{Binding UpdateDiagnosticsTabChangelogLabel}" IsSelected="{Binding IsUpdateDiagnosticsChangelogTabSelected}" SelectCommand="{Binding SelectUpdateDiagnosticsTabCommand}" CommandParameter="{x:Static pvm:UpdateDiagnosticsTabKind.Changelog}"/>
                  <controls:AntdCardTab Title="{Binding UpdateDiagnosticsTabTroubleshootLabel}" IsSelected="{Binding IsUpdateDiagnosticsTroubleshootTabSelected}" SelectCommand="{Binding SelectUpdateDiagnosticsTabCommand}" CommandParameter="{x:Static pvm:UpdateDiagnosticsTabKind.Troubleshoot}"/>
                </StackPanel></ScrollViewer>
              </Panel></Border>
            </StackPanel>

          </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
