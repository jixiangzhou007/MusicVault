<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicVault.App.ViewModels"
             xmlns:pvm="using:MusicVault.App.ViewModels.Pages"
             xmlns:constants="using:MusicVault.App.Constants"
             xmlns:controls="using:MusicVault.App.Controls"
             xmlns:conv="using:MusicVault.App.Converters"
             xmlns:layout="using:MusicVault.App.Layout"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="MusicVault.App.Views.Pages.SearchPageView"
             x:Name="DiscoverRoot"
             x:CompileBindings="False"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

  <!-- 左右分栏：左 = 搜索工具 + 结果；右 = 传输速览（通栏高度） -->
  <Grid x:Name="RootGrid" ColumnDefinitions="*,0,0"
        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*"
          Classes="pane-play discover-main-pane"
          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
          Grid.IsSharedSizeScope="True">

      <!-- 常驻细搜条：Compact + 高级区 + 失败告警 -->
      <Border Grid.Row="0" Classes="discover-search-band">
        <StackPanel Spacing="0">
      <!-- Hero 搜索壳（已停用；保留树以免绑名断裂） -->
      <Border Classes="discover-search-shell discover-search-hero"
              IsVisible="{Binding UseHeroSearch}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" MinHeight="{DynamicResource ControlHeightLg}">
          <TextBlock Grid.Column="0" Text="{StaticResource IconGlyphSearch}"
                     Classes="icon-sm icon-muted discover-search-leading-icon"
                     VerticalAlignment="Center" Margin="{DynamicResource FieldCaptionLeadingMargin}"/>
          <TextBox x:Name="HeroSongQueryBox" Grid.Column="1" Classes="discover-search-input"
                   Watermark="{Binding SongWatermark}"
                   Text="{Binding SongNameQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   KeyDown="OnSearchFieldKeyDown"/>
          <ComboBox Grid.Column="2" Classes="discover-combo discover-combo-platform discover-search-platform"
                    ItemsSource="{Binding PlatformComboItems}"
                    SelectedIndex="{Binding PlatformIndex}"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{Binding PlatformToolTip}"
                    automation:AutomationProperties.Name="{Binding PlatformToolTip}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="pvm:SearchPageViewModel+PlatformComboItemViewModel">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Classes="discover-platform-icon-clip-sm">
                    <Image Source="{Binding Icon}" Stretch="UniformToFill"
                           Classes="discover-platform-app-icon-sm"/>
                  </Border>
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
            <ComboBox.SelectionBoxItemTemplate>
              <DataTemplate x:DataType="pvm:SearchPageViewModel+PlatformComboItemViewModel">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Classes="discover-platform-icon-clip-sm">
                    <Image Source="{Binding Icon}" Stretch="UniformToFill"
                           Classes="discover-platform-app-icon-sm"/>
                  </Border>
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </ComboBox.SelectionBoxItemTemplate>
          </ComboBox>
          <Button Grid.Column="3" Classes="primary discover-search-go"
                  Command="{Binding SearchCommand}" IsEnabled="{Binding CanSearchAlwaysLit}"
                  ToolTip.Tip="{Binding SearchButtonToolTip}"
                  automation:AutomationProperties.Name="{Binding SearchButtonToolTip}">
            <TextBlock Text="{Binding SearchButtonText}" Classes="text-label" VerticalAlignment="Center"
                       Foreground="{DynamicResource AccentForegroundBrush}"/>
          </Button>
          <Button Grid.Column="4" Classes="icon-toolbar-btn discover-search-icon-btn"
                  Command="{Binding ClearSearchCriteriaCommand}"
                  ToolTip.Tip="{Binding ClearSearchToolTip}"
                  automation:AutomationProperties.Name="{Binding ClearSearchToolTip}">
            <TextBlock Text="{StaticResource IconGlyphClose}" Classes="icon-xs"/>
          </Button>
          <Button Grid.Column="5" Classes="icon-toolbar-btn discover-search-icon-btn"
                  Command="{Binding ToggleDiscoverAdvancedCommand}"
                  ToolTip.Tip="{Binding DiscoverAdvancedToggleToolTip}"
                  automation:AutomationProperties.Name="{Binding DiscoverAdvancedToggleToolTip}">
            <TextBlock Text="{StaticResource IconGlyphMore}" Classes="icon-xs"/>
          </Button>
        </Grid>
      </Border>

      <!-- Compact 搜索壳：与页面底色统一；识曲 + 平台登录点 -->
      <Border Classes="discover-search-shell discover-search-compact"
              IsVisible="{Binding UseCompactSearch}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto"
              MinHeight="{DynamicResource ControlHeightMd}">
          <TextBlock Grid.Column="0" Text="{StaticResource IconGlyphSearch}"
                     Classes="icon-sm icon-muted discover-search-leading-icon"
                     VerticalAlignment="Center"/>
          <TextBox x:Name="SongNameQueryBox" Grid.Column="1" Classes="discover-search-input"
                   Watermark="{Binding SongWatermark}"
                   Text="{Binding SongNameQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   KeyDown="OnSearchFieldKeyDown"/>
          <ComboBox Grid.Column="2" Classes="discover-combo discover-combo-platform discover-search-platform"
                    ItemsSource="{Binding PlatformComboItems}"
                    SelectedIndex="{Binding PlatformIndex}"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{Binding PlatformToolTip}"
                    automation:AutomationProperties.Name="{Binding PlatformToolTip}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="pvm:SearchPageViewModel+PlatformComboItemViewModel">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Classes="discover-platform-icon-clip-sm">
                    <Image Source="{Binding Icon}" Stretch="UniformToFill"
                           Classes="discover-platform-app-icon-sm"/>
                  </Border>
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
            <ComboBox.SelectionBoxItemTemplate>
              <DataTemplate x:DataType="pvm:SearchPageViewModel+PlatformComboItemViewModel">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Classes="discover-platform-icon-clip-sm">
                    <Image Source="{Binding Icon}" Stretch="UniformToFill"
                           Classes="discover-platform-app-icon-sm"/>
                  </Border>
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </ComboBox.SelectionBoxItemTemplate>
          </ComboBox>
          <Button Grid.Column="3" Classes="primary discover-search-go"
                  Command="{Binding SearchCommand}" IsEnabled="{Binding CanSearchAlwaysLit}"
                  ToolTip.Tip="{Binding SearchButtonToolTip}"
                  automation:AutomationProperties.Name="{Binding SearchButtonToolTip}">
            <TextBlock Text="{Binding SearchButtonText}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource AccentForegroundBrush}"/>
          </Button>
          <Button Grid.Column="4" Classes="icon-toolbar-btn discover-search-icon-btn discover-search-recognize-btn"
                  Command="{Binding QuickRecognizeCommand}"
                  ToolTip.Tip="{Binding RecognizeInBarToolTip}"
                  automation:AutomationProperties.Name="{Binding RecognizeInBarToolTip}">
            <TextBlock Text="{StaticResource IconGlyphMicrophone}" Classes="icon-sm"/>
          </Button>
          <ItemsControl Grid.Column="5"
                        Classes="discover-search-login-strip"
                        ItemsSource="{Binding SearchBarLoginCapsules}"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="pvm:SearchPageViewModel+SearchLoginCapsuleViewModel">
                <Button Classes="discover-login-icon"
                        Classes.active="{Binding IsSuccess}"
                        Classes.muted="{Binding IsMuted}"
                        Command="{Binding #DiscoverRoot.DataContext.OpenPlatformLoginCommand}"
                        CommandParameter="{Binding Platform}"
                        ToolTip.Tip="{Binding ToolTip}"
                        automation:AutomationProperties.Name="{Binding ToolTip}">
                  <Border Classes="discover-platform-icon-clip">
                    <Image Source="{Binding DisplayIcon}"
                           Stretch="UniformToFill"
                           Classes="discover-platform-app-icon"/>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>

      <StackPanel Spacing="0" IsVisible="{Binding ShowDiscoverAdvanced}">
      <Grid Margin="{DynamicResource PageHeaderMargin}"
            RowDefinitions="Auto,10,Auto"
            IsVisible="{Binding ShowDiscoverAdvanced}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="DiscoverAlign"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding FieldModeLabel}" Classes="discover-field-label"/>
        <Grid Grid.Row="0" Grid.Column="2" ColumnDefinitions="220,*">
          <controls:IntSegmentedBar Grid.Column="0"
                                    SegmentLabels="{Binding DiscoverModeSegmentLabels}"
                                    SelectedIndex="{Binding DiscoverModeIndex}"
                                    ToolTip.Tip="{Binding ModeToolTip}"
                                    automation:AutomationProperties.Name="{Binding ModeToolTip}"/>
        </Grid>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding FieldArtistLabel}" Classes="discover-field-label"
                   IsVisible="{Binding IsSearchMode}"/>
        <Grid Grid.Row="2" Grid.Column="2" ColumnDefinitions="*"
              IsVisible="{Binding IsSearchMode}">
          <TextBox x:Name="ArtistQueryBox" Classes="discover-field"
                   Watermark="{Binding ArtistWatermark}"
                   Text="{Binding ArtistQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   KeyDown="OnSearchFieldKeyDown"/>
        </Grid>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding FieldLinkLabel}" Classes="discover-field-label"
                   IsVisible="{Binding IsParseMode}"/>
        <Grid Grid.Row="2" Grid.Column="2" ColumnDefinitions="*,128,72,72"
              IsVisible="{Binding IsParseMode}">
          <TextBox Grid.Column="0" Grid.ColumnSpan="2" Classes="discover-field"
                   Watermark="{Binding LinkWatermark}"
                   Text="{Binding LinkInput}"
                   KeyDown="OnLinkInputKeyDown"/>
          <Button Grid.Column="2" Content="{Binding ClearButtonText}" Classes="flat-btn btn-toolbar" Margin="{DynamicResource FieldCaptionLeadingMargin}"
                  Command="{Binding ClearLinkInputCommand}"
                  ToolTip.Tip="{Binding ClearLinkToolTip}"
                  automation:AutomationProperties.Name="{Binding ClearLinkToolTip}"/>
          <Button Grid.Column="3" Content="{Binding ParseButtonText}" Classes="primary discover-action" Margin="{DynamicResource FieldCaptionLeadingMargin}"
                  Command="{Binding ParseLinkCommand}" IsEnabled="{Binding CanParse}"
                  ToolTip.Tip="{Binding ParseButtonToolTip}"
                  automation:AutomationProperties.Name="{Binding ParseButtonToolTip}"/>
        </Grid>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding FieldRecognizeLabel}" Classes="discover-field-label"
                   IsVisible="{Binding IsRecognizeMode}"/>
        <Grid Grid.Row="2" Grid.Column="2" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto"
              IsVisible="{Binding IsRecognizeMode}">
          <controls:IntSegmentedBar Grid.Column="0"
                                    MinWidth="148"
                                    VerticalAlignment="Center"
                                    SegmentLabels="{Binding RecognizeCaptureSegmentLabels}"
                                    SelectedIndex="{Binding RecognizeCaptureSourceIndex}"
                                    IsEnabled="{Binding CanChangeRecognizeCaptureSource}"
                                    ToolTip.Tip="{Binding RecognizeCaptureSourceToolTip}"
                                    automation:AutomationProperties.Name="{Binding RecognizeCaptureSourceToolTip}"/>
          <TextBox Grid.Column="1" Classes="discover-field" Margin="{DynamicResource FieldCaptionLeadingMargin}"
                   Text="{Binding RecognizeFilePath}" IsReadOnly="True"
                   Watermark="{Binding RecognizeWatermark}"/>
          <Button Grid.Column="2" Content="{Binding RecognizeRecordButtonText}"
                  Classes="primary discover-action" Margin="{DynamicResource FieldCaptionLeadingMargin}"
                  Command="{Binding ToggleRecognizeRecordingCommand}"
                  IsEnabled="{Binding CanToggleRecognizeRecording}"
                  ToolTip.Tip="{Binding RecognizeRecordButtonToolTip}"
                  automation:AutomationProperties.Name="{Binding RecognizeRecordButtonToolTip}"/>
          <Button Grid.Column="3" Content="{Binding SelectButtonText}" Classes="flat-btn btn-toolbar" Margin="{DynamicResource FieldCaptionLeadingMargin}"
                  Command="{Binding PickRecognizeAudioCommand}"
                  automation:AutomationProperties.Name="{Binding SelectButtonText}"/>
          <Button Grid.Column="4" Content="{Binding ClearButtonText}" Classes="flat-btn btn-toolbar" Margin="{DynamicResource FieldCaptionLeadingMargin}"
                  Command="{Binding ClearRecognizeAudioCommand}"
                  automation:AutomationProperties.Name="{Binding ClearButtonText}"/>
          <Button Grid.Column="5" Content="{Binding RerecognizeButtonText}" Classes="flat-btn btn-toolbar" Margin="{DynamicResource FieldCaptionLeadingMargin}"
                  Command="{Binding RecognizeAudioCommand}"
                  IsEnabled="{Binding CanRecognize}"
                  ToolTip.Tip="{Binding RecognizeButtonToolTip}"
                  automation:AutomationProperties.Name="{Binding RecognizeButtonToolTip}"/>
        </Grid>
      </Grid>

      <Grid Margin="{DynamicResource DiscoverLoginBandMargin}"
            IsVisible="{Binding ShowDiscoverAdvanced}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="DiscoverAlign"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="2"
                   Text="{Binding RecognizeInlineStatus}"
                   Classes="text-caption discover-recognize-status"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   MaxLines="2"
                   IsVisible="{Binding IsRecognizeMode}"/>
        <ItemsControl Grid.Column="2"
                      IsVisible="{Binding IsSearchMode}"
                      ItemsSource="{Binding SearchModeLoginCapsules}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="pvm:SearchPageViewModel+SearchLoginCapsuleViewModel">
              <Button Classes="discover-login-capsule"
                      Classes.active="{Binding IsSuccess}"
                      Classes.proxy="{Binding IsProxy}"
                      Margin="{DynamicResource MarginTrailingSm}"
                      Height="{DynamicResource ToolbarButtonHeight}"
                      Command="{Binding #DiscoverRoot.DataContext.OpenPlatformLoginCommand}"
                      CommandParameter="{Binding Platform}"
                      ToolTip.Tip="{Binding ToolTip}"
                      automation:AutomationProperties.Name="{Binding ToolTip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Classes="discover-platform-icon-clip-sm">
                    <Image Source="{Binding DisplayIcon}" Stretch="UniformToFill"
                           Classes="discover-platform-app-icon-sm"/>
                  </Border>
                  <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
      </StackPanel>

      <Border Margin="{DynamicResource PageHeaderBlockMargin}"
              Classes="ant-alert ant-alert-warning"
              IsVisible="{Binding ShowUnifiedSourceFailureBanner}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Classes="ant-alert-message"
                     Text="{Binding UnifiedSourceFailureMessage}" TextWrapping="Wrap"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                      Margin="{DynamicResource FieldCaptionLeadingMargin}">
            <Button Content="{Binding UnifiedSourceFailureRetryText}"
                    Classes="flat-btn btn-toolbar"
                    Command="{Binding RetryUnifiedSourceFailureCommand}"
                    IsVisible="{Binding ShowUnifiedSourceFailureRetry}"
                    automation:AutomationProperties.Name="{Binding UnifiedSourceFailureRetryText}"/>
            <Button Content="{Binding UnifiedSourceFailureSettingsText}"
                    Classes="flat-btn btn-toolbar"
                    Command="{Binding OpenOnlineSourcesSettingsCommand}"
                    IsVisible="{Binding ShowUnifiedSourceFailureSettings}"
                    automation:AutomationProperties.Name="{Binding UnifiedSourceFailureSettingsText}"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Margin="{DynamicResource PageHeaderBlockMargin}"
              Classes="ant-alert"
              Classes.ant-alert-info="{Binding DiscoverAlertIsInfo}"
              Classes.ant-alert-warning="{Binding DiscoverAlertIsWarning}"
              Classes.ant-alert-error="{Binding DiscoverAlertIsError}"
              IsVisible="{Binding ShowDiscoverAlert}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Classes="ant-alert-message"
                     Text="{Binding DiscoverAlertMessage}" TextWrapping="Wrap"/>
          <Button Grid.Column="1" Content="{Binding DiscoverAlertActionText}"
                  Classes="flat-btn btn-toolbar" Margin="{DynamicResource FieldCaptionLeadingMargin}"
                  Command="{Binding RunDiscoverAlertActionCommand}"
                  IsVisible="{Binding ShowDiscoverAlertAction}"
                  automation:AutomationProperties.Name="{Binding DiscoverAlertActionText}"/>
        </Grid>
      </Border>
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Classes="page-hero-divider" Margin="{DynamicResource MarginTopXsBottomSm}"
              IsVisible="{Binding ShowSearchResultsPane}"/>

      <!-- 浏览中枢：广告 Hero + 为你精选多列（无页面滚动、无列内滚动） -->
      <Grid x:Name="BrowseHubRoot" Grid.Row="2"
            RowDefinitions="Auto,*"
            Classes="discover-browse-hub"
            IsVisible="{Binding ShowBrowseHub}"
            Margin="{DynamicResource MarginTopSm}">
          <!-- 全幅氛围取色 + 文案；左上角换一换；底栏圆点 -->
          <Border Grid.Row="0"
                  Classes="discover-hero-immersive discover-hero-promo"
                  IsVisible="{Binding ShowDiscoverBanner}"
                  Margin="{DynamicResource PageContentHorizontalMargin}"
                  Cursor="Hand"
                  Background="{Binding HeroPromoAccentBrush}"
                  PointerReleased="OnHeroPromoPointerReleased">
            <Panel>
              <!-- 氛围层：封面铺满取色，不再单独放左侧方封 -->
              <Image Source="{Binding CurrentHeroPromo.CoverBitmap}"
                     Stretch="UniformToFill"
                     Opacity="0.38"
                     IsVisible="{Binding CurrentHeroPromo.HasCoverThumb}"
                     IsHitTestVisible="False"/>
              <Border Background="{Binding HeroPromoAccentBrush}" Opacity="0.58" IsHitTestVisible="False"/>
              <Border Background="{DynamicResource DiscoverHeroPromoFadeBrush}" IsHitTestVisible="False"/>

              <Border Padding="28,20,28,36">
                <StackPanel Spacing="6"
                            MaxWidth="520"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                  <TextBlock Text="{Binding HeroPromoEyebrow}"
                             Classes="discover-hero-eyebrow"
                             TextAlignment="Right"
                             HorizontalAlignment="Right"/>
                  <TextBlock Text="{Binding BannerFeatureTitle}"
                             Classes="discover-hero-title"
                             TextAlignment="Right"
                             HorizontalAlignment="Right"
                             TextTrimming="CharacterEllipsis" MaxLines="2"/>
                  <TextBlock Text="{Binding BannerFeatureSubtitle}"
                             Classes="discover-hero-sub"
                             TextAlignment="Right"
                             HorizontalAlignment="Right"
                             TextTrimming="CharacterEllipsis" MaxLines="2"/>
                  <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0"
                              HorizontalAlignment="Right">
                    <Button Classes="primary btn-toolbar"
                            Content="{Binding HeroPromoPreviewText}"
                            Command="{Binding PreviewHeroPromoCommand}"
                            IsEnabled="{Binding CurrentHeroPromo.CanPreviewExecute}"
                            automation:AutomationProperties.Name="{Binding HeroPromoPreviewText}"/>
                    <Button Classes="flat-btn btn-toolbar"
                            Content="{Binding PrimaryCtaText}"
                            Command="{Binding RunPrimaryCtaCommand}"
                            automation:AutomationProperties.Name="{Binding PrimaryCtaText}"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- 左上角：换一换 → 换下一批 10 首 -->
              <Button Classes="flat-btn discover-hero-refresh"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="14,12,0,0"
                      ZIndex="40"
                      Command="{Binding RefreshHeroPromoCommand}"
                      ToolTip.Tip="{Binding HeroPromoRefreshText}"
                      automation:AutomationProperties.Name="{Binding HeroPromoRefreshText}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{StaticResource IconGlyphRefresh}" Classes="icon-xs"
                             VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding HeroPromoRefreshText}"
                             Classes="discover-hero-refresh-label"
                             VerticalAlignment="Center"/>
                </StackPanel>
              </Button>

              <!-- 底部居中圆点 -->
              <ItemsControl Classes="discover-hero-dots"
                            ItemsSource="{Binding HeroPromoDots}"
                            IsVisible="{Binding ShowHeroPromoDots}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,12"
                            ZIndex="30"
                            IsHitTestVisible="True">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pvm:HeroPromoDotViewModel">
                    <Button Classes="discover-hero-dot"
                            Classes.active="{Binding IsSelected}"
                            Command="{Binding #DiscoverRoot.DataContext.SelectHeroPromoCommand}"
                            CommandParameter="{Binding Index}"
                            automation:AutomationProperties.Name="{Binding Index}">
                      <Panel Width="18" Height="10">
                        <Border Classes="discover-hero-dot-idle"
                                IsVisible="{Binding !IsSelected}"
                                Width="8" Height="8"
                                CornerRadius="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        <Border Classes="discover-hero-dot-active"
                                IsVisible="{Binding IsSelected}"
                                Width="18" Height="8"
                                CornerRadius="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                      </Panel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>
          </Border>

          <Panel x:Name="ForYouHost"
                 Grid.Row="1"
                 Classes="discover-foryou-host"
                 Margin="{DynamicResource PageContentHorizontalMargin}"
                 PointerEntered="OnForYouHostPointerEntered"
                 PointerExited="OnForYouHostPointerExited"
                 SizeChanged="OnForYouHostSizeChanged">
            <DockPanel LastChildFill="True" Margin="0,12,0,12">
              <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,48,8">
                <TextBlock Text="{Binding ForYouTitle}"
                           Classes="discover-browse-section-title"/>
                <TextBlock Text="{Binding ForYouSubtitle}"
                           Classes="text-caption"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding ForYouMixedHotHintText}"
                           Classes="text-caption"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Opacity="0.75"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding ShowForYouMixedHotHint}"/>
              </StackPanel>

              <Panel ClipToBounds="True">
                <ItemsControl x:Name="ForYouList"
                              ItemsSource="{Binding ForYouTracks}"
                              Classes="discover-foryou-list"
                              IsVisible="{Binding HasForYouTracks}"
                              Margin="0,0,48,0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <!-- 列/行由 code-behind SyncForYouUniformGrid 写入；避免 ItemsPanel 内 #DiscoverRoot 转型绑定崩溃 -->
                      <UniformGrid Columns="3" Rows="4"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:OnlineTrackViewModel">
                      <Border Classes="discover-foryou-cell">
                        <Grid ColumnDefinitions="Auto,*" Margin="8,4">
                          <Panel Width="48" Height="48" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Border Classes="discover-foryou-cover">
                              <Panel>
                                <Image Source="{Binding CoverBitmap}" Stretch="UniformToFill"
                                       IsVisible="{Binding HasCoverThumb}"/>
                                <TextBlock Text="{StaticResource IconGlyphMusic}" Classes="icon-xs icon-muted"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsVisible="{Binding !HasCoverThumb}"/>
                              </Panel>
                            </Border>
                            <Button Classes="discover-foryou-play"
                                    Command="{Binding PreviewCommand}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    automation:AutomationProperties.Name="{Binding Title}">
                              <TextBlock Text="{StaticResource IconGlyphPlay}" Classes="icon-sm"/>
                            </Button>
                          </Panel>
                          <DockPanel Grid.Column="1" LastChildFill="True" VerticalAlignment="Center">
                            <Panel DockPanel.Dock="Right" Width="32" Margin="6,0,0,0"
                                   VerticalAlignment="Center">
                              <Button Classes="discover-foryou-fav"
                                      Classes.favorited="{Binding IsOnlineFavorite}"
                                      Command="{Binding ToggleOnlineFavoriteCommand}"
                                      ToolTip.Tip="{Binding OnlineFavoriteToolTip}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      automation:AutomationProperties.Name="{Binding OnlineFavoriteToolTip}">
                                <Panel>
                                  <TextBlock Text="{StaticResource IconGlyphHeart}"
                                             Classes="track-row-glyph online-favorite-heart-off"
                                             IsVisible="{Binding !IsOnlineFavorite}"/>
                                  <TextBlock Text="{StaticResource IconGlyphHeartFill}"
                                             Classes="track-row-glyph online-favorite-heart-on"
                                             IsVisible="{Binding IsOnlineFavorite}"/>
                                </Panel>
                              </Button>
                            </Panel>
                            <Button Classes="discover-foryou-rowhit"
                                    Command="{Binding PreviewCommand}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    automation:AutomationProperties.Name="{Binding Title}">
                              <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" Classes="text-body"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Artist}" Classes="text-caption"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                              </StackPanel>
                            </Button>
                          </DockPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="{DynamicResource PlayPaneBrush}"
                        Margin="0,0,48,0"
                        IsVisible="{Binding ShowForYouSkeleton}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                  <controls:SkeletonBrowseListView VerticalAlignment="Top"/>
                </Border>
                <StackPanel Spacing="8"
                            Margin="0,0,48,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding ShowForYouError}">
                  <TextBlock Text="{Binding ForYouErrorText}" Classes="text-caption"
                             TextWrapping="Wrap" TextAlignment="Center"
                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <Button Content="{Binding ForYouRetryText}" Classes="primary btn-toolbar"
                          HorizontalAlignment="Center"
                          Command="{Binding RetryForYouCommand}"
                          automation:AutomationProperties.Name="{Binding ForYouRetryText}"/>
                </StackPanel>

                <StackPanel Classes="discover-foryou-pager"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            IsVisible="{Binding ForYouPagerVisible}"
                            ZIndex="4"
                            Spacing="8"
                            Margin="0,0,4,0">
                  <Border Classes="discover-foryou-page-btn-well">
                    <Button Classes="discover-foryou-page-btn"
                            Command="{Binding ForYouPrevPageCommand}"
                            ToolTip.Tip="{Binding ForYouPrevPageText}"
                            Content="{StaticResource IconGlyphChevronUp}"
                            automation:AutomationProperties.Name="{Binding ForYouPrevPageText}"/>
                  </Border>
                  <Border Classes="discover-foryou-page-btn-well">
                    <Button Classes="discover-foryou-page-btn"
                            Command="{Binding ForYouNextPageCommand}"
                            ToolTip.Tip="{Binding ForYouNextPageText}"
                            Content="{StaticResource IconGlyphChevronDown}"
                            automation:AutomationProperties.Name="{Binding ForYouNextPageText}"/>
                  </Border>
                </StackPanel>
              </Panel>
            </DockPanel>
          </Panel>
      </Grid>

      <!-- 搜索结果（占满左侧剩余高度） -->
      <DockPanel Grid.Row="2" Classes="pane-play discover-results-pane"
                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                 IsVisible="{Binding ShowSearchResultsPane}">
        <StackPanel DockPanel.Dock="Top" Spacing="0">
          <Border Classes="page-toolbar-divider"
                  IsVisible="{Binding ShowResultsSummary}"/>
          <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto"
                Margin="{DynamicResource PageToolbarGridMargin}"
                IsVisible="{Binding ShowResultsSummary}">
            <Button Grid.Column="0" Classes="icon-toolbar-btn library-pane-toggle-btn" Margin="{DynamicResource MarginTrailingSm}"
                    Command="{Binding ToggleTransfersPaneCommand}"
                    ToolTip.Tip="{Binding TransfersPaneToggleToolTip}"
                    automation:AutomationProperties.Name="{Binding TransfersPaneToggleToolTip}"
                    IsVisible="{Binding !IsTransfersPaneOpen}">
              <TextBlock Text="{Binding TransfersPaneToggleGlyph}" Classes="icon-xs"/>
            </Button>
            <TextBlock Grid.Column="1" Text="{Binding ResultsSummaryText}"
                       Classes="discover-results-summary" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="{Binding BatchEnqueueButtonLabel}" Classes="flat-btn btn-toolbar"
                      Command="{Binding BatchEnqueueAllCommand}"
                      IsVisible="{Binding ShowBatchEnqueueButton}"
                      ToolTip.Tip="{Binding BatchEnqueueToolTip}"
                      automation:AutomationProperties.Name="{Binding BatchEnqueueToolTip}"/>
              <Button Content="{Binding ListenHistoryButtonText}" Classes="flat-btn btn-toolbar"
                      Command="{Binding LoadOnlineListenHistoryCommand}"
                      ToolTip.Tip="{Binding ListenHistoryToolTip}"
                      automation:AutomationProperties.Name="{Binding ListenHistoryToolTip}"/>
              <Button Content="{Binding LoadMoreButtonText}" Classes="flat-btn btn-toolbar"
                      Command="{Binding LoadMoreResultsCommand}"
                      IsVisible="{Binding HasMoreResults}"
                      automation:AutomationProperties.Name="{Binding LoadMoreButtonText}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                        Orientation="Horizontal" Spacing="8"
                        Margin="{DynamicResource MarginTopSm}"
                        IsVisible="{Binding ShowRecognizePlayActions}">
              <Button Content="{Binding RecognizePlayButtonText}"
                      Classes="primary btn-toolbar"
                      Command="{Binding RecognizePlayCommand}"
                      IsEnabled="{Binding CanRecognizePlay}"
                      ToolTip.Tip="{Binding RecognizePlayButtonToolTip}"
                      automation:AutomationProperties.Name="{Binding RecognizePlayButtonText}"/>
              <Button Content="{Binding RecognizePlayNextButtonText}"
                      Classes="flat-btn btn-toolbar"
                      Command="{Binding RecognizePlayNextCommand}"
                      IsEnabled="{Binding CanRecognizePlay}"
                      ToolTip.Tip="{Binding RecognizePlayNextButtonToolTip}"
                      automation:AutomationProperties.Name="{Binding RecognizePlayNextButtonText}"/>
              <TextBlock Text="{Binding RecognizePlayNoSourceCaption}"
                         Classes="text-caption"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap"
                         IsVisible="{Binding ShowRecognizePlayNoSource}"/>
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="Auto,*" Margin="{DynamicResource PageContentHorizontalMargin}"
                IsVisible="{Binding !ShowResultsSummary}">
            <Button Classes="icon-toolbar-btn library-pane-toggle-btn" Margin="{DynamicResource MarginTrailingSm}"
                    Command="{Binding ToggleTransfersPaneCommand}"
                    ToolTip.Tip="{Binding TransfersPaneToggleToolTip}"
                    automation:AutomationProperties.Name="{Binding TransfersPaneToggleToolTip}"
                    IsVisible="{Binding !IsTransfersPaneOpen}">
              <TextBlock Text="{Binding TransfersPaneToggleGlyph}" Classes="icon-xs"/>
            </Button>
          </Grid>
        </StackPanel>

        <DockPanel LastChildFill="True"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch">
          <controls:DiscoverOnlineTrackTableHeader x:Name="DiscoverHeader" DockPanel.Dock="Top"/>

        <Panel>
          <controls:SkeletonDiscoverResultsView Margin="{DynamicResource SettingsOverviewCardMargin}"
                                                IsVisible="{Binding ShowResultsSkeleton}"/>

          <Border VerticalAlignment="Bottom" Margin="{DynamicResource TrackTableHeaderPairedMargin}" Padding="0,4,0,0"
                  IsVisible="{Binding ShowResultsLoadMoreSkeleton}">
            <Grid ColumnDefinitions="{x:Static layout:TrackTableLayout.DiscoverColumns}"
                  Height="{x:Static layout:TrackTableLayout.DiscoverRowHeight}">
              <controls:SkeletonLine Grid.Column="0" LineWidth="16" LineHorizontalAlignment="Center"/>
              <controls:SkeletonLine Grid.Column="1" LineWidth="40" LineHorizontalAlignment="Center"/>
              <controls:SkeletonLine Grid.Column="2" Margin="{DynamicResource TrackColCellMargin}"/>
              <controls:SkeletonLine Grid.Column="3" Margin="{DynamicResource TrackColCellMargin}" LineWidth="60"/>
              <controls:SkeletonLine Grid.Column="4" LineWidth="32" LineHorizontalAlignment="Center"/>
              <controls:SkeletonLine Grid.Column="5" LineWidth="24" LineHorizontalAlignment="Center"/>
              <controls:SkeletonLine Grid.Column="6" LineWidth="24" LineHorizontalAlignment="Center"/>
              <controls:SkeletonLine Grid.Column="7" LineWidth="24" LineHorizontalAlignment="Center"/>
              <controls:SkeletonLine Grid.Column="8" LineWidth="24" LineHorizontalAlignment="Center"/>
            </Grid>
          </Border>

          <ListBox x:Name="ResultsList" ItemsSource="{Binding Results}"
                   Classes="virtual-list discover-results-list track-table-scroll-list"
                   DoubleTapped="OnResultDoubleTapped"
                   IsVisible="{Binding HasResults}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:OnlineTrackViewModel">
                <Border Background="Transparent" Classes="track-row">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top" Classes="track-row-content discover-track-row"
                          Classes.previewing="{Binding IsActivelyPreviewing}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Stretch"
                          MinWidth="0"
                          MinHeight="{x:Static layout:TrackTableLayout.DiscoverRowHeight}"
                          ColumnDefinitions="{x:Static layout:TrackTableLayout.DiscoverColumns}">
                      <TextBlock Grid.Column="0" Text="{Binding RowIndexText}"
                                 Classes="track-col-cell discover-track-index discover-track-text"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <Border Grid.Column="1" Classes="discover-cover-thumb"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              ToolTip.Tip="{Binding Title}">
                        <Panel>
                          <Image Source="{Binding CoverBitmap}" Stretch="UniformToFill"
                                 IsVisible="{Binding HasCoverThumb}"/>
                          <TextBlock Text="{StaticResource IconGlyphMusic}" Classes="icon-xs icon-muted"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     IsVisible="{Binding !HasCoverThumb}"/>
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="2" Classes="discover-track-title-stack"
                                  VerticalAlignment="Center" Spacing="2">
                        <controls:MarqueeTextBlock Text="{Binding Title}" LabelAlignment="Left"
                                                   Classes="discover-track-marquee discover-track-marquee-title"
                                                   ToolTip.Tip="{Binding Title}"/>
                        <controls:MarqueeTextBlock Text="{Binding Artist}" LabelAlignment="Left"
                                                   Classes="discover-track-marquee discover-track-marquee-subtitle"
                                                   ToolTip.Tip="{Binding Artist}"/>
                      </StackPanel>
                      <Grid Grid.Column="3" Classes="discover-track-cell" ToolTip.Tip="{Binding PlatformLabel}">
                        <controls:MarqueeTextBlock Text="{Binding PlatformLabel}" LabelAlignment="Left"
                                                   Classes="discover-track-marquee discover-track-marquee-subtitle"/>
                      </Grid>
                      <TextBlock Grid.Column="4" Text="{Binding DurationText}" Classes="track-col-cell discover-track-text"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <Border Grid.Column="5" Classes="discover-cache-chip"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              ToolTip.Tip="{Binding PreviewCacheToolTip}"
                              automation:AutomationProperties.Name="{Binding PreviewCacheStatusText}"
                              IsVisible="{Binding IsPreviewCached}">
                        <TextBlock Text="{StaticResource IconGlyphCheckMark}" Classes="track-row-glyph discover-cache-glyph"/>
                      </Border>
                      <Button Grid.Column="6"
                              Classes="row-action-btn track-favorite-btn"
                              HorizontalAlignment="Center"
                              ToolTip.Tip="{Binding OnlineFavoriteToolTip}"
                              automation:AutomationProperties.Name="{Binding OnlineFavoriteToolTip}"
                              Command="{Binding ToggleOnlineFavoriteCommand}">
                        <Panel>
                          <TextBlock Text="{StaticResource IconGlyphHeart}" Classes="track-row-glyph online-favorite-heart-off"
                                     IsVisible="{Binding !IsOnlineFavorite}"/>
                          <TextBlock Text="{StaticResource IconGlyphHeartFill}" Classes="track-row-glyph online-favorite-heart-on"
                                     IsVisible="{Binding IsOnlineFavorite}"/>
                        </Panel>
                      </Button>
                      <Button Grid.Column="7"
                              Classes="row-action-btn track-playlist-btn"
                              HorizontalAlignment="Center"
                              ToolTip.Tip="{Binding AddToPlaylistToolTip}"
                              automation:AutomationProperties.Name="{Binding AddToPlaylistToolTip}"
                              Click="OnAddToPlaylistClick">
                        <TextBlock Text="{StaticResource IconGlyphAdd}" Classes="track-row-glyph"/>
                      </Button>
                      <Button Grid.Column="8"
                              Classes="row-action-btn"
                              HorizontalAlignment="Center"
                              ToolTip.Tip="{Binding DownloadToolTip}"
                              automation:AutomationProperties.Name="{Binding DownloadToolTip}"
                              Command="{Binding OpenDownloadPickerCommand}"
                              IsVisible="{Binding HasDownloadOptions}"
                              IsEnabled="{Binding CanUseOnlineDownload}">
                        <TextBlock Text="{StaticResource IconGlyphDownload}" Classes="track-row-glyph"/>
                      </Button>
                    </Grid>
                    <Border DockPanel.Dock="Bottom" Classes="track-row-divider"/>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Button x:Name="ResultsScrollTopBtn" Content="{StaticResource IconGlyphChevronUp}"
                  Classes="list-scroll-top-btn"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="{DynamicResource ListScrollBottomMargin}" IsVisible="False"
                  Click="OnResultsScrollTopClick"/>

          <controls:EmptyStateView IsVisible="{Binding ShowDiscoverEmpty}"
                                   Title="{Binding DiscoverEmptyTitle}"
                                   Description="{Binding DiscoverEmptyDescription}"
                                   IconGlyph="{StaticResource IconGlyphSearch}"
                                   ShowAction="{Binding ShowDiscoverEmptyAction}"
                                   ActionText="{Binding DiscoverEmptyActionText}"
                                   ActionCommand="{Binding RunDiscoverAlertActionCommand}"/>
        </Panel>
        </DockPanel>
      </DockPanel>
    </Grid>

    <controls:VerticalPaneSplitter x:Name="TransfersSplitter" Grid.Column="1"/>

    <!-- 传输速览：右侧通栏 -->
    <DockPanel x:Name="TransfersPane" Grid.Column="2"
               Classes="pane-library downloads-panel discover-transfers-sidebar"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <Border DockPanel.Dock="Top" Margin="{DynamicResource MarginTopSm}">
        <Grid RowDefinitions="Auto,1">
          <Grid Grid.Row="0" Classes="discover-transfers-header" Margin="{DynamicResource LibraryPaneHeaderMargin}"
                ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{Binding TransfersQuickTitle}" Classes="track-col-header" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Transfers.QuickDownloadStatsLine}" Classes="text-caption download-queue-stats"
                         VerticalAlignment="Center"
                         IsVisible="{Binding Transfers.QuickHasAnyItems}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Button Content="{Binding ViewAllTransfersButtonText}" Classes="flat-btn btn-toolbar"
                      Command="{Binding OpenTransfersPageCommand}"
                      ToolTip.Tip="{Binding ViewAllTransfersToolTip}"
                      automation:AutomationProperties.Name="{Binding ViewAllTransfersToolTip}"/>
              <Border Classes="library-pane-toolbar-sep"/>
              <Button Classes="icon-toolbar-btn library-pane-toggle-btn"
                      Command="{Binding ToggleTransfersPaneCommand}"
                      ToolTip.Tip="{Binding TransfersPaneToggleToolTip}">
                <TextBlock Text="{Binding TransfersPaneToggleGlyph}" Classes="icon-xs"/>
              </Button>
            </StackPanel>
          </Grid>
          <Border Grid.Row="1" Classes="splitter-h" Margin="{DynamicResource PageContentHorizontalMarginSm}"/>
        </Grid>
      </Border>

      <Button DockPanel.Dock="Bottom" Content="{Binding ClearQuickViewButtonText}" Classes="flat-btn btn-toolbar download-clear-btn"
              HorizontalAlignment="Stretch" Margin="{DynamicResource LibraryPaneFooterMargin}"
              Command="{Binding Transfers.ClearQueueCommand}"
              IsEnabled="{Binding Transfers.CanClearQuickView}"
              ToolTip.Tip="{Binding ClearQuickViewToolTip}"
              automation:AutomationProperties.Name="{Binding ClearQuickViewToolTip}"/>

      <Panel>
        <ListBox ItemsSource="{Binding Transfers.QuickItems}" Classes="virtual-list download-queue-list"
                 ItemTemplate="{StaticResource DownloadQueueItemCompactTemplate}"
                 IsVisible="{Binding !Transfers.QuickIsEmpty}"/>

        <controls:EmptyStateView IsVisible="{Binding Transfers.QuickIsEmpty}"
                                 Title="{Binding TransfersQuickEmptyTitle}"
                                 Description="{Binding TransfersQuickEmptyDescription}"
                                 IconGlyph="{StaticResource IconGlyphDownload}"/>
      </Panel>
    </DockPanel>
  </Grid>
</UserControl>
