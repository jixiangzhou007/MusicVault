<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 元数据侧栏：圆点/勾选框与文字同一水平中线 -->
  <ControlTheme x:Key="MetadataRadioTheme" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <ControlTemplate TargetType="RadioButton">
        <Grid ColumnDefinitions="16,6,Auto"
              Height="{DynamicResource ControlHeightSm}"
              VerticalAlignment="Center">
          <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
            <Ellipse Width="16" Height="16"
                     Stroke="{DynamicResource BorderSubtleBrush}"
                     StrokeThickness="1"
                     Fill="Transparent"/>
            <Ellipse x:Name="InnerDot"
                     Width="8" Height="8"
                     Fill="{DynamicResource AccentBrush}"
                     IsVisible="False"/>
          </Grid>
          <ContentPresenter Grid.Column="2"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            FontSize="{TemplateBinding FontSize}"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            RecognizesAccessKey="True"/>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked /template/ Ellipse#InnerDot">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
  </ControlTheme>

  <!-- 统一复选框：16×16 方框 + 8px 间距 + 文字垂直居中 -->
  <ControlTheme x:Key="MusicVaultCheckTheme" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <ControlTemplate TargetType="CheckBox">
        <Grid ColumnDefinitions="16,8,*"
              VerticalAlignment="Center">
          <Border x:Name="CheckBoxBorder"
                  Grid.Column="0"
                  Width="16"
                  Height="16"
                  CornerRadius="4"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource BorderSubtleBrush}"
                  Background="{DynamicResource SearchFieldBrush}"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  ClipToBounds="True">
            <Viewbox Width="10"
                     Height="10"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
              <Path x:Name="CheckMark"
                    Data="M2.5,8 L6,11.5 L13.5,4"
                    Stroke="{DynamicResource AccentForegroundBrush}"
                    StrokeThickness="1.8"
                    StrokeLineCap="Round"
                    StrokeJoin="Round"
                    Stretch="Uniform"
                    IsVisible="False"/>
            </Viewbox>
          </Border>
          <ContentPresenter Grid.Column="2"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            FontSize="{TemplateBinding FontSize}"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            RecognizesAccessKey="True"/>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked /template/ Border#CheckBoxBorder">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="^:checked /template/ Path#CheckMark">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
  </ControlTheme>

  <!-- 统一复选框：仅方框（列表行勾选） -->
  <ControlTheme x:Key="MusicVaultCheckIconTheme" TargetType="CheckBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <ControlTemplate TargetType="CheckBox">
        <Border x:Name="CheckBoxBorder"
                Width="16"
                Height="16"
                CornerRadius="4"
                BorderThickness="1"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                Background="{DynamicResource SearchFieldBrush}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                ClipToBounds="True">
          <Viewbox Width="10"
                   Height="10"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
            <Path x:Name="CheckMark"
                  Data="M2.5,8 L6,11.5 L13.5,4"
                  Stroke="{DynamicResource AccentForegroundBrush}"
                  StrokeThickness="1.8"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Stretch="Uniform"
                  IsVisible="False"/>
          </Viewbox>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked /template/ Border#CheckBoxBorder">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="^:checked /template/ Path#CheckMark">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
  </ControlTheme>

  <!-- 紧凑开关：40×22；PART_SwitchKnob 宽度=滑块行程（框架 checked 时 Left=该宽度） -->
  <ControlTheme x:Key="MusicVaultSwitchTheme" TargetType="ToggleSwitch">
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="MinWidth" Value="40"/>
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="OnContent" Value=""/>
    <Setter Property="OffContent" Value=""/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="KnobTransitions">
      <Transitions>
        <DoubleTransition Property="Canvas.Left" Duration="0:0:0.15" Easing="CubicEaseOut"/>
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="ToggleSwitch">
        <Panel Width="40"
               Height="22"
               ClipToBounds="True"
               Background="Transparent"
               VerticalAlignment="Center">
          <ContentPresenter x:Name="PART_OnContentPresenter"
                            Content="{TemplateBinding OnContent}"
                            ContentTemplate="{TemplateBinding OnContentTemplate}"
                            IsVisible="False"/>
          <ContentPresenter x:Name="PART_OffContentPresenter"
                            Content="{TemplateBinding OffContent}"
                            ContentTemplate="{TemplateBinding OffContentTemplate}"
                            IsVisible="False"/>
          <Border x:Name="SwitchKnobBounds"
                  Width="40"
                  Height="22"
                  CornerRadius="11"
                  Background="{DynamicResource BorderSecondaryBrush}"
                  BorderThickness="0"/>
          <Panel x:Name="PART_SwitchKnob"
                 Width="20"
                 Height="22"
                 Margin="2,0,18,0"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Left"
                 Background="Transparent"
                 ClipToBounds="True">
            <Panel x:Name="PART_MovingKnobs"
                   Width="18"
                   Height="18"
                   VerticalAlignment="Center">
              <Ellipse x:Name="SwitchKnobOn"
                       Width="18"
                       Height="18"
                       Fill="{DynamicResource AccentForegroundBrush}"
                       IsVisible="False"/>
              <Ellipse x:Name="SwitchKnobOff"
                       Width="18"
                       Height="18"
                       Fill="{DynamicResource TextPrimaryBrush}"/>
            </Panel>
          </Panel>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked /template/ Border#SwitchKnobBounds">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="^:checked /template/ Ellipse#SwitchKnobOn">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:checked /template/ Ellipse#SwitchKnobOff">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45"/>
    </Style>
  </ControlTheme>

  <!-- 兼容旧资源键 -->
  <ControlTheme x:Key="MetadataCheckTheme" TargetType="CheckBox" BasedOn="{StaticResource MusicVaultCheckTheme}"/>
  <ControlTheme x:Key="SettingsCheckTheme" TargetType="CheckBox" BasedOn="{StaticResource MusicVaultCheckTheme}"/>
  <ControlTheme x:Key="IconOnlyCheckTheme" TargetType="CheckBox" BasedOn="{StaticResource MusicVaultCheckIconTheme}"/>

</ResourceDictionary>
