<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- WinUI 3 shape tokens (Fluent Design System) -->
  <CornerRadius x:Key="RadiusControl">4</CornerRadius>
  <CornerRadius x:Key="RadiusOverlay">8</CornerRadius>

  <!-- WinUI control metrics -->
  <x:Double x:Key="ControlHeightStandard">32</x:Double>
  <x:Double x:Key="RowActionButtonSize">28</x:Double>
  <x:Double x:Key="IconToolbarButtonSize">22</x:Double>
  <x:Double x:Key="IconButtonSizeMd">32</x:Double>
  <Thickness x:Key="ControlPaddingStandard">12,0</Thickness>
  <Thickness x:Key="ButtonPaddingStandard">16,0</Thickness>
  <Thickness x:Key="FocusStrokeThickness">1</Thickness>

</ResourceDictionary>
