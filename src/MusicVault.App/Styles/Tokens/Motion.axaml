<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

  <!-- 动效 Token（阶段 0）：Avalonia Transform 仅支持 px，禁止 translateX(100%) -->

  <sys:TimeSpan x:Key="MotionDurationFast">0:0:0.15</sys:TimeSpan>
  <sys:TimeSpan x:Key="MotionDurationBase">0:0:0.25</sys:TimeSpan>
  <sys:TimeSpan x:Key="MotionDurationSlow">0:0:0.35</sys:TimeSpan>
  <sys:TimeSpan x:Key="MotionDurationDrawer">0:0:0.25</sys:TimeSpan>
  <sys:TimeSpan x:Key="MotionDurationTonearm">0:0:0.75</sys:TimeSpan>
  <x:Double x:Key="MotionTonearmDegreesPerTick">0.65</x:Double>
  <x:Double x:Key="MotionTonearmSettleDelayMs">50</x:Double>

  <!-- Drawer：与 Styles/Components/Drawer.axaml 中 translateX 保持一致 -->
  <x:Double x:Key="DrawerSlideOffsetPx">560</x:Double>
  <x:Double x:Key="FormDrawerSlideOffsetWidePx">1040</x:Double>
  <x:Double x:Key="FormDrawerWidthCombinedLabels">1040</x:Double>
  <x:Double x:Key="DrawerWidthDefault">360</x:Double>
  <x:Double x:Key="DrawerWidthMin">220</x:Double>
  <x:Double x:Key="DrawerWidthMax">560</x:Double>
  <x:Double x:Key="FormDrawerWidthMax">1040</x:Double>

</ResourceDictionary>
