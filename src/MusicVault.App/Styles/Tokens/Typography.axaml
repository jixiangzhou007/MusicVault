<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- WinUI 字号阶梯（Segoe UI Variable / 中文回退） -->
  <FontFamily x:Key="AppFontFamily">Inter, Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, "Microsoft YaHei UI", "PingFang SC", "Hiragino Sans GB", "Yu Gothic UI", "Malgun Gothic", "Noto Sans CJK SC", sans-serif</FontFamily>
  <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="MonoFontFamily">Inter, Segoe UI Variable Text, Segoe UI, "Microsoft YaHei UI", "PingFang SC", sans-serif</FontFamily>

  <x:Double x:Key="FontSizeMicro">10</x:Double>
  <x:Double x:Key="FontSizeCaption">11</x:Double>
  <x:Double x:Key="FontSizeLabel">12</x:Double>
  <x:Double x:Key="FontSizeBody">13</x:Double>
  <x:Double x:Key="FontSizeTitle3">15</x:Double>
  <x:Double x:Key="FontSizeLead">16</x:Double>
  <x:Double x:Key="FontSizeTitle2">22</x:Double>
  <!-- 内容区页头（在线收藏 / 我的歌单 / 艺术家等），略小于窗口级大标题 -->
  <x:Double x:Key="FontSizePageTitle">20</x:Double>
  <x:Double x:Key="FontSizeLargeTitle">28</x:Double>
  <x:Double x:Key="FontSizeStatValue">34</x:Double>
  <x:Double x:Key="FontSizeOverviewKpi">20</x:Double>

  <x:Double x:Key="IconSizeXs">12</x:Double>
  <x:Double x:Key="IconSizeSm">14</x:Double>
  <x:Double x:Key="IconSizeMd">16</x:Double>
  <x:Double x:Key="IconSizeLg">20</x:Double>
  <x:Double x:Key="IconSizeXl">24</x:Double>
  <x:Double x:Key="IconSize2xl">36</x:Double>
  <x:Double x:Key="IconSizeHero">72</x:Double>

</ResourceDictionary>
