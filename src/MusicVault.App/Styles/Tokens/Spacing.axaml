<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 间距 -->
  <x:Double x:Key="SpaceXs">4</x:Double>
  <x:Double x:Key="SpaceSm">8</x:Double>
  <x:Double x:Key="SpaceMd">12</x:Double>
  <x:Double x:Key="SpaceLg">16</x:Double>
  <x:Double x:Key="SpaceXl">20</x:Double>

  <!-- 控件高度：WinUI 标准 32；工具栏保留紧凑 30 以免列表行挤压 -->
  <x:Double x:Key="ControlHeightSm">28</x:Double>
  <x:Double x:Key="ControlHeightMd">32</x:Double>
  <x:Double x:Key="ControlHeightLg">40</x:Double>

  <!-- 按钮高度（与 ControlHeight* 对齐，供样式层引用） -->
  <x:Double x:Key="ToolbarButtonHeight">30</x:Double>
  <x:Double x:Key="TooltipMaxWidth">420</x:Double>
  <!-- 发现页：登录胶囊 / 识曲状态共用固定高度带，避免切换模式时列表跳动 -->
  <x:Double x:Key="DiscoverLoginBandMinHeight">30</x:Double>
  <Thickness x:Key="DiscoverLoginBandMargin">16,6,33,4</Thickness>
  <!-- 工具栏按钮内边距：仅水平留白，垂直靠固定高度 + 居中，避免中文裁切 -->
  <Thickness x:Key="ToolbarButtonPadding">14,0</Thickness>
  <x:Double x:Key="DialogButtonHeight">34</x:Double>
  <x:Double x:Key="DialogButtonMinWidth">88</x:Double>
  <x:Double x:Key="MenuItemHeight">28</x:Double>

  <!-- 表单布局 -->
  <x:Double x:Key="LabelColumnWidth">60</x:Double>
  <x:Double x:Key="MetadataLabelGap">10</x:Double>
  <x:Double x:Key="FieldContentIndent">70</x:Double>
  <x:Double x:Key="FieldScrollGutter">24</x:Double>

  <!-- 全局内容宽度（跨页复用；设置页等仍可用 Settings* 别名见下方注释） -->
  <x:Double x:Key="ContentWidthForm">560</x:Double>
  <x:Double x:Key="ContentWidthList">640</x:Double>
  <x:Double x:Key="ContentWidthPreview">720</x:Double>
  <x:Double x:Key="ContentWidthWide">880</x:Double>
  <x:Double x:Key="ControlWidthStandard">280</x:Double>
  <x:Double x:Key="ControlWidthWide">420</x:Double>
  <!-- 设置偏好下拉（主题/循环/字号等短枚举）；URL/路径仍用 Standard/Wide -->
  <x:Double x:Key="SettingsComboWidth">168</x:Double>
  <x:Double x:Key="SettingsGathererListWidth">640</x:Double>
  <x:Int32 x:Key="SettingsGathererColumns">3</x:Int32>

  <GridLength x:Key="SettingsLabelColumnWidth">108</GridLength>
  <GridLength x:Key="SettingsFieldGap">8</GridLength>
  <!-- 标签列 108（右对齐）+ 间隙 8 + 控件列 Auto（紧跟标签） -->
  <x:Double x:Key="SettingsControlColumnOffsetPx">120</x:Double>
  <GridLength x:Key="SettingsControlColumnWidth">*</GridLength>
  <GridLength x:Key="SettingsFormControlColumnWidth">*</GridLength>
  <x:Double x:Key="SettingsBackupNameColumnMaxWidth">360</x:Double>
  <Thickness x:Key="SettingsBackupTableEdgeInset">12,8,12,12</Thickness>
  <Thickness x:Key="SettingsStickySaveBarPadding">12,10</Thickness>
  <GridLength x:Key="SettingsShortcutKeyColumnWidth">172</GridLength>
  <x:Double x:Key="SettingsUpdateFeedMaxWidth">420</x:Double>
  <x:Double x:Key="SettingsUpdateFrequencyWidth">128</x:Double>
  <x:Double x:Key="SettingsUpdateHistoryMinHeight">360</x:Double>
  <x:Double x:Key="SettingsUpdateHistoryMaxHeight">520</x:Double>
  <x:Double x:Key="SettingsUpdateStatusMaxHeight">120</x:Double>
  <x:Double x:Key="SettingsSliderMinWidth">170</x:Double>
  <x:Double x:Key="SettingsSliderValueColumnWidth">48</x:Double>
  <Thickness x:Key="SettingsAntdCardTabContentPadding">12,12,12,12</Thickness>
  <x:Double x:Key="SettingsGroupBodyIndent">16</x:Double>
  <x:Double x:Key="SettingsSubgroupBodyIndent">12</x:Double>

  <!-- 二级列表行内边距（歌单/曲库侧栏子项） -->
  <Thickness x:Key="LibraryListRowChildPadding">28,0,12,0</Thickness>
  <!-- 偏好中心：右栏内容区左 8px（贴分割线）；Nav 仍 12px -->
  <Thickness x:Key="SettingsPaneContentMargin">8,16,12,16</Thickness>
  <Thickness x:Key="SettingsFieldHintMargin">120,4,0,0</Thickness>
  <Thickness x:Key="SettingsEqualizerCustomMargin">120,8,0,8</Thickness>
  <Thickness x:Key="SettingsControlColumnOffset">120,0,0,0</Thickness>
  <Thickness x:Key="SettingsNavRowPadding">12,0,12,0</Thickness>
  <Thickness x:Key="SettingsOverviewHeaderPadding">8,4,8,4</Thickness>
  <Thickness x:Key="SettingsOverviewBodyPadding">8,6,8,6</Thickness>
  <Thickness x:Key="SettingsOverviewPageMargin">16,16,33,16</Thickness>
  <!-- 偏好中心子页（外观/播放等）：侧栏已占宽，左 inset 略紧 -->
  <Thickness x:Key="SettingsSubpagePageMargin">8,16,33,16</Thickness>
  <Thickness x:Key="SettingsPlaybackTabContentPadding">8,12,0,16</Thickness>
  <!-- 兼容旧引用 -->
  <Thickness x:Key="SettingsAppearancePageMargin">8,16,33,16</Thickness>
  <!-- 偏好中心各独立页（外观等）正文区 inset；页头与正文共用 SettingsOverviewPageMargin -->
  <Thickness x:Key="SettingsSectionPageMargin">16,0,33,16</Thickness>
  <Thickness x:Key="SettingsAppearanceSwatchGridMargin">0,0,8,0</Thickness>
  <x:Double x:Key="SettingsOverviewFeatureTabContentHeight">128</x:Double>
  <Thickness x:Key="SettingsOverviewChipMargin">0,0,6,2</Thickness>
  <Thickness x:Key="SettingsOverviewKpiCardGapMargin">0,0,8,0</Thickness>
  <Thickness x:Key="CommandPalettePanelMargin">0,72,0,0</Thickness>
  <Thickness x:Key="SettingsGroupBodyMargin">0,0,0,0</Thickness>
  <Thickness x:Key="SettingsSubgroupBodyMargin">0,0,0,0</Thickness>

  <Thickness x:Key="FieldContentMargin">70,0,0,0</Thickness>
  <Thickness x:Key="SettingsFieldContentMargin">0,4,0,0</Thickness>
  <x:Double x:Key="SettingsGroupBodySpacing">8</x:Double>
  <x:Double x:Key="SettingsSectionBodySpacing">16</x:Double>
  <Thickness x:Key="PageContentMargin">16</Thickness>
  <Thickness x:Key="SidebarEditorMargin">12,0,12,8</Thickness>

  <!-- 批次 C：View 层常用外边距（引用 DynamicResource，避免 inline magic number） -->
  <Thickness x:Key="MarginBottomXs">0,0,0,4</Thickness>
  <Thickness x:Key="MarginBottomSm">0,0,0,8</Thickness>
  <Thickness x:Key="MarginBottomMd">0,0,0,12</Thickness>
  <Thickness x:Key="MarginBottomLg">0,0,0,16</Thickness>
  <Thickness x:Key="MarginTopXs">0,4,0,0</Thickness>
  <Thickness x:Key="MarginTopSm">0,8,0,0</Thickness>
  <Thickness x:Key="MarginLeadingSm">8,0,0,0</Thickness>
  <Thickness x:Key="MarginLeadingMd">12,0,0,0</Thickness>
  <Thickness x:Key="MarginTrailingSm">0,0,8,0</Thickness>
  <Thickness x:Key="MarginTrailingMd">0,0,12,0</Thickness>
  <Thickness x:Key="MarginTrailingLg">0,0,16,0</Thickness>
  <Thickness x:Key="MarginToolbarBtnGap">0,0,6,0</Thickness>
  <Thickness x:Key="LibraryPaneHeaderMargin">12,16,12,8</Thickness>
  <Thickness x:Key="LibraryPaneFooterMargin">12,0,12,12</Thickness>
  <Thickness x:Key="LibraryPaneToolbarMargin">12,16,16,8</Thickness>
  <Thickness x:Key="PageHeaderMargin">16,16,33,0</Thickness>
  <Thickness x:Key="PageHeaderBlockMargin">16,16,33,8</Thickness>
  <!-- 页头 Hero 底部分割线（通栏至窗口左右缘，非壳层 inset 分割线） -->
  <Thickness x:Key="PageHeroDividerMargin">0,10,0,10</Thickness>
  <!-- 页内首行工具栏：右缘与曲目行同为内容 inset 16；滚动条占位由 TrackTablePairedLayout 按实测同步 -->
  <Thickness x:Key="PageToolbarGridMargin">16,16,16,8</Thickness>
  <!-- Hero 文案下方的工具栏（不再叠加 top inset） -->
  <Thickness x:Key="PageHeroToolbarMargin">16,0,16,8</Thickness>
  <!-- Hero 下方首行工具栏（如整理工具顶栏，含略大 bottom 间距） -->
  <Thickness x:Key="PageHeroToolbarFirstRowMargin">16,0,16,10</Thickness>
  <!-- Hero 区块内容区左右 paired inset（无额外 vertical） -->
  <Thickness x:Key="PageHeroToolbarInsetMargin">16,0,16,0</Thickness>
  <Thickness x:Key="PageContentHorizontalMargin">16,0,16,0</Thickness>
  <Thickness x:Key="PageContentHorizontalMarginSm">12,0,12,0</Thickness>
  <Thickness x:Key="PageContentBottomMargin">16,0,16,12</Thickness>
  <Thickness x:Key="TrackTableHeaderMargin">16,0,16,2</Thickness>
  <Thickness x:Key="AlbumCatalogTrackTableHeaderMargin">16,0,20,2</Thickness>
  <Thickness x:Key="AlbumCatalogTrackTableDividerMargin">16,0,20,0</Thickness>
  <!-- 左右 16 为内容 inset；右侧滚动条 gutter 由 TrackTablePairedLayout.Wire 动态追加，避免与 Visible 滚动条双计 -->
  <Thickness x:Key="TrackTableHeaderPairedMargin">16,0,16,2</Thickness>
  <x:Double x:Key="TrackTablePairedContentInset">16</x:Double>
  <x:Double x:Key="TrackTablePairedHeaderBottomInset">2</x:Double>
  <Thickness x:Key="HomeHistoryPaneMargin">0</Thickness>
  <Thickness x:Key="HomeSectionHeaderMargin">16,8,16,8</Thickness>
  <!-- 与 TrackTableHeaderPairedMargin 左右一致，供首页区块标题行 / 表头配对 -->
  <Thickness x:Key="HomeTableEmptyMargin">16,32,16,16</Thickness>
  <Thickness x:Key="DownloadTransferRowMargin">16,3,16,0</Thickness>
  <Thickness x:Key="DownloadTransferProgressMargin">88,1,16,0</Thickness>
  <Thickness x:Key="DiscoverTransferQuickRowMargin">12,3,12,0</Thickness>
  <Thickness x:Key="DiscoverTransferQuickDividerMargin">12,3,12,2</Thickness>
  <!-- 与表头内容 inset 一致；滚动条由 ListBox Visible 占位，不再把 17px gutter 写进行 Margin -->
  <Thickness x:Key="TrackTableRowPairedMargin">16,0,16,0</Thickness>
  <Thickness x:Key="TrackTableScrollPadding">0,0,0,20</Thickness>
  <x:Double x:Key="TrackTableScrollBarGutter">17</x:Double>
  <Thickness x:Key="TrackTableHeaderScrollGutterMargin">0,0,17,0</Thickness>
  <Thickness x:Key="TrackRowHorizontalMargin">16,0,16,0</Thickness>
  <Thickness x:Key="TrackColHeaderMargin">8,0,8,0</Thickness>
  <Thickness x:Key="TrackColHeaderIndexMargin">0</Thickness>
  <Thickness x:Key="TrackColHeaderLastMargin">8,0,0,0</Thickness>
  <Thickness x:Key="TrackColCellMargin">8,0,8,0</Thickness>
  <x:Double x:Key="TrackTableHeaderHeight">27</x:Double>
  <x:Double x:Key="TrackTableRowHeight">34</x:Double>
  <x:Double x:Key="TrackRowHeight">34</x:Double>
  <Thickness x:Key="ToolbarBtnLeadingMargin">8,0,0,0</Thickness>
  <Thickness x:Key="CardGridItemMargin">0,0,12,12</Thickness>
  <Thickness x:Key="ChipGridItemMargin">0,0,8,8</Thickness>
  <Thickness x:Key="PageToolbarDividerTightMargin">0,0,0,8</Thickness>
  <Thickness x:Key="SectionSplitMargin">0,0,0,6</Thickness>
  <Thickness x:Key="MarginTopXsBottomSm">0,4,0,8</Thickness>
  <Thickness x:Key="PlayerResumePromptOffsetMargin">0,-32,0,0</Thickness>
  <Thickness x:Key="BrowseDockMargin">0</Thickness>
  <x:Double x:Key="SearchFieldWidth">280</x:Double>
  <x:Double x:Key="SearchFieldWidthCompact">168</x:Double>
  <Thickness x:Key="SettingsNavHeaderMargin">12,16,12,8</Thickness>
  <Thickness x:Key="WindowLogoMargin">12,0,16,0</Thickness>
  <!-- Win=0；macOS 启动时写入约 78，给交通灯让位。只加在顶栏左侧，不要加在整行。 -->
  <Thickness x:Key="TitleBarLeadingInset">0</Thickness>
  <Thickness x:Key="WindowNavLeadingMargin">12,0,0,0</Thickness>
  <Thickness x:Key="WindowPageHeaderMargin">16,16,33,8</Thickness>
  <Thickness x:Key="PlayerBarInnerMargin">12,12,16,10</Thickness>
  <Thickness x:Key="PlayerBarCoverMargin">0,0,0,0</Thickness>
  <Thickness x:Key="PlayerBarTitleMargin">12,0,16,0</Thickness>
  <Thickness x:Key="CompactPlayerOverlayMargin">18,10,18,12</Thickness>
  <Thickness x:Key="CompactPlayerChromeMargin">4,4,4,0</Thickness>
  <Thickness x:Key="ListScrollBottomMargin">0,0,20,16</Thickness>
  <Thickness x:Key="DetailHeroMargin">16,20,28,0</Thickness>
  <Thickness x:Key="HeroAvatarMargin">0,0,16,0</Thickness>
  <Thickness x:Key="DesignSystemPageMargin">20</Thickness>
  <Thickness x:Key="SettingsOverviewCardMargin">0,8,0,0</Thickness>
  <Thickness x:Key="SettingsChipGridMargin">0,0,8,8</Thickness>
  <Thickness x:Key="SettingsSwatchGridMargin">0,0,10,10</Thickness>
  <Thickness x:Key="SettingsIndentMargin">24,0,0,0</Thickness>
  <Thickness x:Key="SettingsGathererIndentMargin">24,0,0,0</Thickness>
  <Thickness x:Key="FieldCaptionLeadingMargin">8,0,0,0</Thickness>
  <Thickness x:Key="EqualizerSectionGap">0,0,0,10</Thickness>
  <Thickness x:Key="EqualizerRowGap">0,0,0,12</Thickness>

  <!-- 壳层布局高度 -->
  <x:Double x:Key="TopNavHeight">52</x:Double>
  <x:Double x:Key="MusicBrowseBarHeight">36</x:Double>
  <x:Double x:Key="MusicBrowseSearchHeight">28</x:Double>
  <x:Double x:Key="PlayerBarHeight">88</x:Double>
  <x:Double x:Key="PlayerBarCoverSize">72</x:Double>
  <!-- 底栏进度条（ZIndex 叠在内容区上缘）需为可滚动列表预留底部留白 -->
  <x:Double x:Key="PlayerProgressScrollInset">20</x:Double>
  <Thickness x:Key="PlayerProgressScrollPadding">0,0,0,20</Thickness>
  <!-- 榜单卡片区：底栏进度条 + 横向滚动条留白 -->
  <Thickness x:Key="PlaylistChartsScrollPadding">0,0,0,36</Thickness>

  <!-- 正在播放页左右分栏（左封面+歌词 / 右播放历史） -->
  <x:Double x:Key="NowPlayingLeftPaneDefaultWidth">360</x:Double>
  <x:Double x:Key="NowPlayingLeftPaneWeight">0.38</x:Double>
  <x:Double x:Key="NowPlayingRightPaneWeight">54</x:Double>
  <!-- 全屏歌词：左封面区 / 右歌词区 -->
  <Thickness x:Key="FullscreenContentMargin">40,0,40,0</Thickness>
  <Thickness x:Key="FullscreenCoverPaneMargin">0,0,20,0</Thickness>
  <Thickness x:Key="FullscreenLyricsPaneMargin">20,0,0,0</Thickness>
  <x:Double x:Key="FullscreenCoverSize">360</x:Double>
  <x:Double x:Key="FullscreenLyricsMaxHeight">520</x:Double>
  <x:Double x:Key="HomeSectionListMaxHeight">280</x:Double>
  <!-- 整理工具 / 浏览页控件宽 -->
  <x:Double x:Key="ControlWidthCompact">132</x:Double>
  <x:Double x:Key="ControlWidthOrganize">168</x:Double>
  <x:Double x:Key="ControlWidthLibraryPicker">200</x:Double>
  <x:Double x:Key="BrowseCoverTileSize">128</x:Double>
  <x:Double x:Key="DiscoverBrowseCoverTileSize">152</x:Double>
  <!-- 方案 A：条高=完整方封边长（略增高，画面更协调） -->
  <x:Double x:Key="DiscoverHeroHeight">220</x:Double>
  <x:Double x:Key="DiscoverHeroCoverWidth">200</x:Double>
  <x:Double x:Key="DiscoverQuickIconWellSize">44</x:Double>

  <!-- V3：工具栏 / 筛选 / 播放栏 / 首页引导宽度 -->
  <x:Double x:Key="ControlWidthToolbar">96</x:Double>
  <x:Double x:Key="ControlWidthToolbarSecondary">72</x:Double>
  <x:Double x:Key="ControlWidthFilterMin">100</x:Double>
  <x:Double x:Key="ControlWidthFilterCompact">112</x:Double>
  <x:Double x:Key="ControlWidthFilterMax">128</x:Double>
  <x:Double x:Key="ControlWidthFilterSortMax">120</x:Double>
  <x:Double x:Key="ControlWidthOrganizeWide">144</x:Double>
  <x:Double x:Key="PlayerBarTitleMaxWidth">320</x:Double>
  <x:Double x:Key="VolumeSliderWidth">108</x:Double>
  <x:Double x:Key="DiscoverRowHeight">56</x:Double>

</ResourceDictionary>
