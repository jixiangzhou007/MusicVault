<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="StackPanel.ant-result">
    <Setter Property="Spacing" Value="12"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="Border.ant-result-icon">
    <Setter Property="Width" Value="64"/>
    <Setter Property="Height" Value="64"/>
    <Setter Property="CornerRadius" Value="32"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <Style Selector="Border.ant-result-icon-info">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentMutedBrush}"/>
  </Style>
  <Style Selector="Border.ant-result-icon-success">
    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}"/>
  </Style>
  <Style Selector="Border.ant-result-icon-warning">
    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}"/>
  </Style>
  <Style Selector="Border.ant-result-icon-error">
    <Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}"/>
  </Style>

  <Style Selector="TextBlock.ant-result-glyph-info">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="TextBlock.ant-result-glyph-success">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
  </Style>
  <Style Selector="TextBlock.ant-result-glyph-warning">
    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
  </Style>
  <Style Selector="TextBlock.ant-result-glyph-error">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>

  <Style Selector="TextBlock.ant-result-title">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle2}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style Selector="TextBlock.ant-result-subtitle">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="LineHeight" Value="22"/>
  </Style>

  <Style Selector="StackPanel.ant-result-actions">
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>

</Styles>
