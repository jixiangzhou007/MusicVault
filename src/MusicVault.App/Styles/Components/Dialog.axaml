<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 小型确认弹窗：与批量入队、API 更新等共用 -->
  <Style Selector="Window.app-dialog">
    <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
    <Setter Property="CanResize" Value="False"/>
    <Setter Property="SystemDecorations" Value="BorderOnly"/>
    <Setter Property="WindowStartupLocation" Value="CenterOwner"/>
  </Style>
  <Style Selector="Border.app-dialog-shell">
    <Setter Property="Padding" Value="24"/>
    <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
  </Style>
  <Style Selector="StackPanel.app-dialog-body">
    <Setter Property="Spacing" Value="10"/>
  </Style>
  <Style Selector="Border.app-dialog-footer">
    <Setter Property="Padding" Value="0,16,0,0"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
  </Style>
  <Style Selector="StackPanel.app-dialog-actions">
    <Setter Property="Orientation" Value="Horizontal"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="Spacing" Value="10"/>
    <Setter Property="Margin" Value="0,12,0,0"/>
  </Style>
  <Style Selector="Button.app-dialog-btn">
    <Setter Property="Height" Value="{DynamicResource DialogButtonHeight}"/>
    <Setter Property="MinHeight" Value="{DynamicResource DialogButtonHeight}"/>
    <Setter Property="MaxHeight" Value="{DynamicResource DialogButtonHeight}"/>
    <Setter Property="MinWidth" Value="{DynamicResource DialogButtonMinWidth}"/>
    <Setter Property="Padding" Value="{DynamicResource ToolbarButtonPadding}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Border.app-modal-panel">
    <Setter Property="MinWidth" Value="400"/>
    <Setter Property="MaxWidth" Value="520"/>
    <Setter Property="Padding" Value="24"/>
  </Style>
  <Style Selector="Border.app-modal-panel StackPanel.app-dialog-body">
    <Setter Property="Spacing" Value="8"/>
  </Style>
  <Style Selector="Border.app-modal-panel TextBlock.text-title,
                   Border.app-modal-panel TextBlock.text-subtitle,
                   Border.app-modal-panel TextBlock.text-body">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>
  <Style Selector="Border.app-modal-panel TextBlock.text-caption">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  </Style>
  <Style Selector="Border.app-modal-panel-wide">
    <Setter Property="MinWidth" Value="1000"/>
    <Setter Property="MaxWidth" Value="1200"/>
    <Setter Property="Width" Value="1100"/>
    <Setter Property="Padding" Value="16"/>
  </Style>
  <Style Selector="TextBlock.app-dialog-intro">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="LineHeight" Value="20"/>
  </Style>
  <Style Selector="TextBlock.app-dialog-status">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="LineHeight" Value="18"/>
  </Style>
  <Style Selector="TextBlock.app-dialog-status.success">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
  </Style>

  <!-- 试听加载：紧凑卡片（小于通用 app-modal-panel） -->
  <Style Selector="Border.preview-loading-card">
    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="BoxShadow" Value="{DynamicResource PopoverShadow}"/>
    <Setter Property="Padding" Value="16,14"/>
    <Setter Property="Width" Value="300"/>
    <Setter Property="MinWidth" Value="280"/>
    <Setter Property="MaxWidth" Value="320"/>
  </Style>
  <Style Selector="TextBlock.preview-loading-title">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="LineHeight" Value="18"/>
  </Style>
  <Style Selector="TextBlock.preview-loading-track">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="LineHeight" Value="20"/>
  </Style>
  <Style Selector="TextBlock.preview-loading-artist">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="LineHeight" Value="16"/>
  </Style>
  <Style Selector="TextBlock.preview-loading-status">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
    <Setter Property="LineHeight" Value="16"/>
  </Style>
  <Style Selector="ProgressBar.preview-loading-progress">
    <Setter Property="Height" Value="4"/>
    <Setter Property="MinHeight" Value="4"/>
    <Setter Property="MaxHeight" Value="4"/>
    <Setter Property="CornerRadius" Value="2"/>
  </Style>
  <Style Selector="Button.preview-loading-cancel">
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="MaxHeight" Value="28"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="Margin" Value="0,10,0,0"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
  </Style>
</Styles>
