<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Border.top-message-host">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Margin" Value="0,10,0,0"/>
    <Setter Property="MaxWidth" Value="560"/>
  </Style>

  <Style Selector="StackPanel.top-message-stack">
    <Setter Property="Spacing" Value="8"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Border.top-message-item">
    <Setter Property="Background" Value="{DynamicResource MessageSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource MessageBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="BoxShadow" Value="{DynamicResource PopoverShadow}"/>
    <Setter Property="IsHitTestVisible" Value="True"/>
  </Style>

  <Style Selector="TextBlock.top-message-icon">
    <Setter Property="FontFamily" Value="{DynamicResource IconFontFamily}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
  </Style>

  <Style Selector="TextBlock.top-message-text">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="MaxWidth" Value="480"/>
  </Style>

</Styles>
