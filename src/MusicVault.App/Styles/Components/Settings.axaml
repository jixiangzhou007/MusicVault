<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MusicVault.App.Controls">

  <Style Selector="StackPanel.settings-form">
    <Setter Property="Margin" Value="{DynamicResource SettingsPaneContentMargin}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Spacing" Value="0"/>
  </Style>

  <Style Selector="StackPanel.settings-form StackPanel.page-hero-toolbar,
                   StackPanel.settings-form Grid.page-hero-toolbar">
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>

  <Style Selector="StackPanel.settings-form Border.page-hero-divider">
    <Setter Property="Margin" Value="0,8,0,8"/>
  </Style>

  <Style Selector="StackPanel.settings-section">
    <Setter Property="Spacing" Value="{DynamicResource SettingsGroupBodySpacing}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
  </Style>

  <!-- 与概览页一致：分区全宽左对齐，勿用 MaxWidth 居中窄栏 -->

  <Style Selector="StackPanel.settings-section-header">
    <Setter Property="Spacing" Value="4"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
  </Style>

  <Style Selector="Border.settings-page-header">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="Border.settings-page-header DockPanel > Button.settings-save-header-btn">
    <Setter Property="Margin" Value="12,0,0,0"/>
  </Style>

  <Style Selector="Border.settings-sticky-save-bar">
    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="Border.settings-recommend-summary">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,2,0,0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="StackPanel.settings-section > Border">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="StackPanel.settings-section > Border.ant-descriptions">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="TextBlock.settings-page-title">
    <Setter Property="FontSize" Value="{DynamicResource FontSizePageTitle}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="TextAlignment" Value="Left"/>
  </Style>

  <Style Selector="TextBlock.settings-section-intro">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="LineHeight" Value="20"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="TextAlignment" Value="Left"/>
  </Style>

  <Style Selector="StackPanel.settings-intro-page">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
  </Style>

  <Style Selector="StackPanel.settings-intro-page > Border">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="StackPanel.settings-section-compact">
    <Setter Property="Spacing" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="StackPanel.settings-section-compact > TextBlock.settings-section-intro">
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>

  <Style Selector="StackPanel.settings-section-compact > Grid.settings-field-row">
    <Setter Property="Margin" Value="0,1"/>
  </Style>

  <Style Selector="StackPanel.settings-section-compact > Grid.settings-field-row.tall">
    <Setter Property="Margin" Value="0,2"/>
  </Style>

  <Style Selector="StackPanel.settings-section-compact StackPanel.settings-field-body">
    <Setter Property="Spacing" Value="4"/>
  </Style>

  <Style Selector="StackPanel.settings-section-compact Border.settings-gatherer-row">
    <Setter Property="Padding" Value="0,4"/>
  </Style>

  <Style Selector="Grid.settings-field-row">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="MinHeight" Value="{DynamicResource ToolbarButtonHeight}"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
  </Style>

  <Style Selector="Grid.settings-field-row.tall">
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Margin" Value="0"/>
  </Style>

  <Style Selector="TextBlock.settings-field-label">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="TextAlignment" Value="Right"/>
    <Setter Property="Padding" Value="0,0,2,0"/>
    <Setter Property="Margin" Value="0"/>
  </Style>

  <Style Selector="Grid.settings-field-row > TextBlock.metadata-field-label,
                   Grid.settings-field-row > TextBlock.settings-field-label">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="TextAlignment" Value="Right"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="Padding" Value="0,0,2,0"/>
    <Setter Property="MinWidth" Value="0"/>
  </Style>

  <Style Selector="Grid.settings-field-row.tall > TextBlock.metadata-field-label,
                   Grid.settings-field-row.tall > TextBlock.settings-field-label">
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Margin" Value="0,6,0,0"/>
    <Setter Property="Padding" Value="0"/>
  </Style>

  <Style Selector="Grid.settings-field-value">
    <Setter Property="MaxWidth" Value="{DynamicResource ControlWidthWide}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="MinWidth" Value="0"/>
  </Style>

  <Style Selector="Grid.settings-field-row > Grid.settings-field-value">
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="MinWidth" Value="0"/>
  </Style>

  <Style Selector="Grid.settings-field-row > Grid.settings-field-value.settings-inline-action-row">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="MaxWidth" Value="Infinity"/>
    <Setter Property="Width" Value="NaN"/>
  </Style>

  <Style Selector="Grid.settings-field-row.tall > Grid.settings-field-value">
    <Setter Property="VerticalAlignment" Value="Top"/>
  </Style>

  <Style Selector="TextBlock.settings-field-caption">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- 字段说明：优先 ToolTip；区块说明用 settings-field-caption；多控件区用 settings-field-stack -->

  <Style Selector="Grid.settings-field-value > TextBlock.settings-field-caption,
                   Grid.settings-field-value > TextBlock.text-caption">
    <Setter Property="Margin" Value="0,0,12,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  </Style>

  <Style Selector="Grid.settings-field-value > ToggleSwitch.ant-switch,
                   Grid.settings-field-row ToggleSwitch.ant-switch">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="ClipToBounds" Value="False"/>
  </Style>

  <Style Selector="StackPanel.settings-control-inline">
    <Setter Property="Orientation" Value="Horizontal"/>
    <Setter Property="Spacing" Value="8"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="StackPanel.settings-control-inline > TextBlock.settings-field-caption">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="MaxWidth" Value="520"/>
    <Setter Property="Margin" Value="0"/>
  </Style>

  <Style Selector="TextBlock.settings-field-value-text">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <Style Selector="WrapPanel.settings-field-actions > TextBlock.settings-field-value-text">
    <Setter Property="Margin" Value="0,0,12,0"/>
  </Style>

  <Style Selector="Grid.settings-inline-control > TextBlock.settings-field-caption,
                   Grid.settings-inline-control > TextBlock.text-caption">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="WrapPanel.settings-field-actions > Button">
    <Setter Property="Margin" Value="0,0,10,0"/>
  </Style>

  <Style Selector="TextBlock.settings-slider-value">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="MinWidth" Value="{DynamicResource SettingsSliderValueColumnWidth}"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
  </Style>

  <Style Selector="ListBox.settings-nav-list Border.library-list-row.settings-nav-row">
    <Setter Property="Padding" Value="{DynamicResource SettingsNavRowPadding}"/>
  </Style>

  <Style Selector="ListBox.settings-nav-list Border.library-list-row.settings-nav-row > Grid">
    <Setter Property="Margin" Value="0"/>
  </Style>

  <Style Selector="ListBox.settings-nav-list ListBoxItem:selected Border.settings-nav-badge TextBlock,
                   ListBox.settings-nav-list ListBoxItem:selected Border.settings-nav-pending-dot">
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <Style Selector="Border.settings-nav-pending-dot">
    <Setter Property="Width" Value="6"/>
    <Setter Property="Height" Value="6"/>
    <Setter Property="CornerRadius" Value="3"/>
    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
    <Setter Property="Margin" Value="6,0,0,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Border.settings-nav-badge">
    <Setter Property="MinWidth" Value="16"/>
    <Setter Property="MinHeight" Value="16"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="4,1"/>
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    <Setter Property="Margin" Value="6,0,0,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Border.settings-nav-badge TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeMicro}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccentSoftForegroundBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Button.intro-chip">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="3"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="Margin" Value="0,0,8,8"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>

  <Style Selector="Button.intro-chip:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}"/>
  </Style>

  <Style Selector="Button.intro-chip TextBlock.intro-chip-name">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeMicro}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccentSoftForegroundBrush}"/>
  </Style>

  <Style Selector="TextBlock.settings-connection-result-text">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  </Style>

  <Style Selector="TextBlock.settings-connection-result-text.connection-result-ok">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
  </Style>

  <Style Selector="TextBlock.settings-connection-result-text.connection-result-fail">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>

  <Style Selector="Button.settings-connection-test-btn.connection-test-ok">
    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
  </Style>

  <Style Selector="Button.settings-connection-test-btn.connection-test-ok:pointerover">
    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <Style Selector="WrapPanel.settings-connection-test-line">
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>

  <Style Selector="WrapPanel.settings-connection-test-line > Button">
    <Setter Property="Margin" Value="0,0,10,8"/>
  </Style>

  <Style Selector="StackPanel.settings-connection-test-group">
    <Setter Property="Orientation" Value="Horizontal"/>
    <Setter Property="Spacing" Value="8"/>
    <Setter Property="Margin" Value="0,0,10,8"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Border.settings-connection-pill">
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <Style Selector="Border.settings-connection-pill TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Border.settings-connection-pill.success">
    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}"/>
  </Style>

  <Style Selector="Border.settings-connection-pill.success TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
  </Style>

  <Style Selector="Border.settings-connection-pill.error">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}"/>
  </Style>

  <Style Selector="Border.settings-connection-pill.error TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>

  <Style Selector="Button.settings-gatherer-name-btn">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="2,0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>

  <Style Selector="Button.settings-gatherer-name-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <Style Selector="TextBox.settings-url-input">
    <Setter Property="Width" Value="{DynamicResource ControlWidthStandard}"/>
    <Setter Property="MaxWidth" Value="{DynamicResource ControlWidthStandard}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>

  <Style Selector="Grid.settings-url-input-line">
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>

  <Style Selector="Grid.settings-control-line">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Grid.settings-status-row">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="Grid.settings-usage-kv-row">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Margin" Value="0,2,0,2"/>
  </Style>

  <Style Selector="ItemsControl.settings-usage-kv-list">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="ItemsControl.settings-usage-kv-list ContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="Grid.settings-usage-kv-row > TextBlock.settings-field-label">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="TextAlignment" Value="Right"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
  </Style>

  <Style Selector="TextBlock.settings-usage-kv-value">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="TextBlock.settings-usage-kv-value-mono">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New, monospace"/>
  </Style>

  <Style Selector="TextBlock.settings-usage-funnel">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style Selector="TextBlock.settings-page-subtitle">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style Selector="TextBlock.settings-field-hint">
    <Setter Property="Margin" Value="{DynamicResource SettingsFieldHintMargin}"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    <Setter Property="Foreground" Value="{DynamicResource WarningSoftBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style Selector="TextBlock.settings-field-hint.tight">
    <Setter Property="Margin" Value="{DynamicResource SettingsFieldContentMargin}"/>
  </Style>

  <Style Selector="ItemsControl.settings-capability-list">
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Grid.settings-capability-inline-row">
    <Setter Property="Margin" Value="0,0,0,4"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="StackPanel.settings-capability-row">
    <Setter Property="Orientation" Value="Horizontal"/>
    <Setter Property="Spacing" Value="20"/>
    <Setter Property="Margin" Value="0"/>
  </Style>

  <Style Selector="Grid.settings-capability-list-row">
    <Setter Property="ClipToBounds" Value="False"/>
  </Style>

  <Style Selector="Grid.settings-capability-list-row > ItemsControl.settings-capability-list">
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="ClipToBounds" Value="False"/>
  </Style>

  <Style Selector="StackPanel.settings-capability-row">
    <Setter Property="Margin" Value="0"/>
  </Style>

  <!-- 已弃用 settings-playback-control 宽栏右置开关；控件紧跟标签见 settings-control-inline -->

  <Style Selector="Grid.settings-field-row > ComboBox.settings-playback-combo">
    <Setter Property="Width" Value="{DynamicResource ControlWidthWide}"/>
    <Setter Property="MaxWidth" Value="{DynamicResource ControlWidthWide}"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>

  <Style Selector="StackPanel.settings-capability-item">
    <Setter Property="Orientation" Value="Horizontal"/>
    <Setter Property="Spacing" Value="6"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Border.settings-capability-pill.success">
    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <Style Selector="Border.settings-capability-pill.success TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
  </Style>

  <Style Selector="Border.settings-capability-pill.warning">
    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource WarningTextBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <Style Selector="Border.settings-capability-pill.warning TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
  </Style>

  <Style Selector="Border.settings-capability-pill.error">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <Style Selector="Border.settings-capability-pill.error TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>

  <Style Selector="TextBlock.settings-capability-label">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="LineHeight" Value="{DynamicResource FontSizeLabel}"/>
  </Style>

  <Style Selector="Border.settings-capability-pill">
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Border.settings-capability-pill TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="LineHeight" Value="14"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
  </Style>

  <Style Selector="Grid.settings-field-row > ComboBox,
                   Grid.settings-field-row > ComboBox.settings-field-control">
    <Setter Property="Width" Value="{DynamicResource ControlWidthStandard}"/>
    <Setter Property="MaxWidth" Value="{DynamicResource ControlWidthStandard}"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
  </Style>

  <Style Selector="Grid.settings-field-row > Slider">
    <Setter Property="MaxWidth" Value="{DynamicResource ControlWidthStandard}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>

  <Style Selector="Grid.settings-inline-control">
    <Setter Property="Width" Value="{DynamicResource ControlWidthStandard}"/>
    <Setter Property="MaxWidth" Value="{DynamicResource ControlWidthStandard}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="MinWidth" Value="0"/>
  </Style>

  <Style Selector="Grid.settings-field-row > Grid.settings-inline-control">
    <Setter Property="Width" Value="{DynamicResource ControlWidthStandard}"/>
    <Setter Property="MaxWidth" Value="{DynamicResource ControlWidthStandard}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="MinWidth" Value="0"/>
  </Style>

  <Style Selector="Grid.settings-inline-control > Slider">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="MinWidth" Value="{DynamicResource SettingsSliderMinWidth}"/>
  </Style>

  <Style Selector="Grid.settings-field-row > TextBox">
    <Setter Property="Width" Value="{DynamicResource ControlWidthStandard}"/>
    <Setter Property="MaxWidth" Value="{DynamicResource ControlWidthStandard}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>

  <Style Selector="Grid.settings-field-row > TextBox.settings-field-wide">
    <Setter Property="Width" Value="{DynamicResource ControlWidthWide}"/>
    <Setter Property="MaxWidth" Value="{DynamicResource ControlWidthWide}"/>
  </Style>

  <Style Selector="Grid.settings-control-line > TextBox.settings-control-input,
                   Grid.settings-field-row > TextBox.settings-control-input">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MaxWidth" Value="Infinity"/>
    <Setter Property="Width" Value="NaN"/>
  </Style>

  <Style Selector="Grid.settings-field-row > Button">
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Grid.settings-field-row > TextBlock.metadata-field-label,
                   Grid.settings-field-row > TextBlock.settings-field-label">
