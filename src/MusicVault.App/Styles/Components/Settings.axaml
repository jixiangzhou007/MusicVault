    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="TextBlock.settings-release-bullet-mark">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
  </Style>

  <Style Selector="TextBlock.settings-release-bullet">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="LineHeight" Value="20"/>
  </Style>

  <Style Selector="Button.settings-update-history-toggle">
    <Setter Property="Padding" Value="{DynamicResource ToolbarButtonPadding}"/>
    <Setter Property="MinHeight" Value="{DynamicResource ToolbarButtonHeight}"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>

  <Style Selector="Border.settings-update-status-list">
    <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}"/>
    <Setter Property="Padding" Value="10,8,12,12"/>
    <Setter Property="MaxWidth" Value="{DynamicResource ContentWidthList}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>

  <Style Selector="TextBlock.settings-update-status-time">
    <Setter Property="Margin" Value="0,0,8,0"/>
  </Style>

  <Style Selector="StackPanel.settings-update-troubleshoot-section">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="StackPanel.settings-update-troubleshoot-section > TextBlock.settings-group-title">
    <Setter Property="Margin" Value="0"/>
  </Style>

  <Style Selector="Grid.settings-update-status-row">
    <Setter Property="Margin" Value="0,3,0,0"/>
  </Style>

  <Style Selector="StackPanel.settings-group-body.settings-changelog-panel">
    <Setter Property="Spacing" Value="6"/>
  </Style>

  <Style Selector="StackPanel.settings-changelog-panel">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="ScrollViewer.settings-changelog-scroll">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="MinHeight" Value="{DynamicResource SettingsUpdateHistoryMinHeight}"/>
    <Setter Property="MaxHeight" Value="{DynamicResource SettingsUpdateHistoryMaxHeight}"/>
  </Style>

  <Style Selector="Border.settings-troubleshoot-panel">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>

  <Style Selector="Border.settings-troubleshoot-panel.settings-capability-panel">
    <Setter Property="Padding" Value="0"/>
  </Style>

  <Style Selector="Border.settings-troubleshoot-panel:not(.settings-capability-panel)">
    <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}"/>
    <Setter Property="Padding" Value="{DynamicResource SettingsOverviewBodyPadding}"/>
  </Style>

  <Style Selector="Border.settings-backup-panel">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}"/>
    <Setter Property="Padding" Value="16"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="MinHeight" Value="120"/>
  </Style>

  <Style Selector="StackPanel.settings-backup-empty">
    <Setter Property="Margin" Value="12,14"/>
    <Setter Property="Spacing" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="Border.settings-backup-table">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <Style Selector="Border.settings-backup-table-header-wrap">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="Grid.settings-backup-table-header,
                   Grid.settings-backup-table-row-grid">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="TextBlock.settings-backup-table-th">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="Margin" Value="10,6,10,6"/>
  </Style>

  <Style Selector="TextBlock.settings-backup-table-th.settings-backup-table-meta,
                   TextBlock.settings-backup-table-td.settings-backup-table-meta">
    <Setter Property="Margin" Value="16,6,16,6"/>
    <Setter Property="MinWidth" Value="168"/>
  </Style>

  <Style Selector="TextBlock.settings-backup-table-th.settings-backup-table-action">
    <Setter Property="Margin" Value="8,6,14,6"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>

  <Style Selector="Border.settings-backup-table-row">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="TextBlock.settings-backup-table-td">
    <Setter Property="Margin" Value="10,5"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
  </Style>

  <Style Selector="Grid.settings-backup-table-row-grid > Button.settings-backup-restore-action">
    <Setter Property="Margin" Value="8,5,14,5"/>
  </Style>

  <Style Selector="Grid.settings-backup-pagination">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Margin" Value="0,6,0,0"/>
    <Setter Property="MinHeight" Value="28"/>
  </Style>

  <Style Selector="TextBlock.settings-backup-pagination-info">
    <Setter Property="Margin" Value="10,0,0,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Grid.settings-backup-pagination > StackPanel">
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0"/>
  </Style>

  <Style Selector="Button.primary.btn-toolbar.settings-backup-restore-action">
    <Setter Property="MinWidth" Value="48"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="MaxHeight" Value="22"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="8,5,14,5"/>
  </Style>

  <Style Selector="StackPanel.settings-about-page">
    <Setter Property="Spacing" Value="12"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="StackPanel.settings-about-hero">
    <Setter Property="Margin" Value="0,0,0,4"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="StackPanel.settings-about-page > Border.ant-alert">
    <Setter Property="Margin" Value="0"/>
  </Style>

  <Style Selector="TextBlock.settings-update-status-empty">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="8,6"/>
  </Style>

  <Style Selector="Grid.settings-diag-tool-row">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="MinHeight" Value="{DynamicResource ToolbarButtonHeight}"/>
    <Setter Property="Margin" Value="0,3"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Grid.settings-diag-tool-row > TextBlock.metadata-field-label,
                   Grid.settings-diag-tool-row > TextBlock.settings-field-label">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Padding" Value="0"/>
  </Style>

  <Style Selector="Grid.settings-diag-tool-row > StackPanel.settings-field-actions">
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Grid.settings-diag-tool-row > StackPanel.settings-field-actions > Button">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0"/>
  </Style>

  <Style Selector="Grid.settings-diag-tool-row.tall > TextBlock.settings-field-label">
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Margin" Value="0,6,0,0"/>
  </Style>

  <Style Selector="WrapPanel.settings-intro-actions">
    <Setter Property="Margin" Value="0,4,0,0"/>
  </Style>

  <Style Selector="WrapPanel.settings-intro-actions > Button">
    <Setter Property="Margin" Value="0,0,10,8"/>
  </Style>

</Styles>
