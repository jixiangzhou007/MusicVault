<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Ant Drawer：右侧滑出 + 遮罩（与 modal-scrim 共用蒙层色） -->

  <Style Selector="Border.ant-drawer-panel">
    <Setter Property="Background" Value="{DynamicResource RightPanelBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
    <Setter Property="BorderThickness" Value="1,0,0,0"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <!-- Avalonia Transform 不支持 %，用像素偏移（与 MainWindow Drawer MaxWidth 560 对齐） -->
    <Setter Property="RenderTransformOrigin" Value="1,0.5"/>
    <Setter Property="RenderTransform" Value="translateX(560px)"/>
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource MotionDurationDrawer}" Easing="CubicEaseOut"/>
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.ant-drawer-panel.drawer-open">
    <Setter Property="RenderTransform" Value="translateX(0px)"/>
  </Style>

  <!-- Form Drawer 宽表（组合标签搜索）：滑入偏移与 FormDrawerWidthCombinedLabels 对齐 -->
  <Style Selector="Border.ant-drawer-panel.form-drawer-wide">
    <Setter Property="RenderTransform" Value="translateX(1040px)"/>
  </Style>

  <Style Selector="Border.ant-drawer-panel.form-drawer-wide.drawer-open">
    <Setter Property="RenderTransform" Value="translateX(0px)"/>
  </Style>

  <Style Selector="Grid.ant-drawer-host > Border.modal-scrim">
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDurationDrawer}"/>
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Grid.ant-drawer-host.drawer-open > Border.modal-scrim">
    <Setter Property="Opacity" Value="1"/>
    <Setter Property="IsHitTestVisible" Value="True"/>
  </Style>

  <!-- 平台登录抽屉：单行紧凑 — 上圆角图标 + 下短标签 -->
  <Style Selector="Button.login-platform-chip">
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="MinWidth" Value="48"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.login-platform-chip:pointerover">
    <Setter Property="Background" Value="{DynamicResource OverlayHoverSubtleBrush}"/>
  </Style>
  <Style Selector="Button.login-platform-chip.selected">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
  </Style>
  <Style Selector="Button.login-platform-chip.selected Border.login-platform-icon-clip">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>
  <Style Selector="Button.login-platform-chip.unsupported">
    <Setter Property="Opacity" Value="0.5"/>
  </Style>
  <Style Selector="Button.login-platform-chip:disabled">
    <Setter Property="Opacity" Value="0.5"/>
  </Style>
  <Style Selector="Button.login-platform-chip /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Border.login-platform-icon-clip">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="{DynamicResource ControlFillSecondaryBrush}"/>
  </Style>
  <Style Selector="Image.login-platform-app-icon">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
  </Style>
  <Style Selector="TextBlock.login-platform-chip-label">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
  </Style>
  <Style Selector="Button.login-platform-chip.selected TextBlock.login-platform-chip-label">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>
  <Style Selector="Border.login-platform-logged-badge">
    <Setter Property="Width" Value="12"/>
    <Setter Property="Height" Value="12"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceElevatedBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Border.login-platform-logged-badge > TextBlock">
    <Setter Property="FontSize" Value="8"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
  </Style>
  <Style Selector="Border.login-qr-card">
    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusOverlay}"/>
    <Setter Property="Padding" Value="12"/>
  </Style>

</Styles>
