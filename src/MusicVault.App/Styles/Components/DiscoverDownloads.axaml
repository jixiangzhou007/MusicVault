  <!-- 发现页操作列：与 download-quality-chip 同视觉（蓝底白字圆角） -->
  <Style Selector="Button.discover-action-chip">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource IconOnAccentBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="3"/>
    <Setter Property="Padding" Value="6,2"/>
    <Setter Property="MinWidth" Value="34"/>
    <Setter Property="MinHeight" Value="18"/>
    <Setter Property="MaxHeight" Value="22"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSizeMicro}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.discover-action-chip:pointerover">
    <Setter Property="Opacity" Value="0.92"/>
  </Style>
  <Style Selector="Button.discover-action-chip:disabled">
    <Setter Property="Background" Value="{DynamicResource TextTertiaryBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource IconOnAccentBrush}"/>
