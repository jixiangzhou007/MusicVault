<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MusicVault.App.Controls">

  <Style Selector="TextBlock.discover-recognize-status">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <Style Selector="Border.discover-search-band">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <!-- 与左右 16 一致：顶/底都用 SpaceLg -->
    <Setter Property="Padding" Value="0,16,0,16"/>
  </Style>

  <Style Selector="Border.discover-search-shell">
    <Setter Property="Background" Value="{DynamicResource PlayPaneBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
    <!-- 内边距与平台图标间距统一为 SpaceSm(8) -->
    <Setter Property="Padding" Value="8"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="Border.discover-search-hero">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Margin" Value="{DynamicResource PageContentHorizontalMargin}"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
  </Style>

  <Style Selector="Border.discover-search-compact">
    <Setter Property="Margin" Value="{DynamicResource PageContentHorizontalMargin}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
  </Style>

  <Style Selector="StackPanel.discover-browse-section">
    <Setter Property="Spacing" Value="8"/>
    <Setter Property="Margin" Value="{DynamicResource PageContentHorizontalMargin}"/>
  </Style>

  <Style Selector="TextBlock.discover-browse-section-title">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle2}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="LetterSpacing" Value="0.2"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Border.discover-browse-card">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <Style Selector="Border.discover-hero-immersive">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Height" Value="{DynamicResource DiscoverHeroHeight}"/>
    <Setter Property="MinHeight" Value="{DynamicResource DiscoverHeroHeight}"/>
    <Setter Property="MaxHeight" Value="{DynamicResource DiscoverHeroHeight}"/>
  </Style>

  <Style Selector="Border.discover-hero-cover-well">
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard} 0 0 {DynamicResource RadiusCard}"/>
  </Style>

  <Style Selector="Button.discover-hero-refresh">
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
    <Setter Property="Background" Value="#66000000"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="#F2FFFFFF"/>
  </Style>
  <Style Selector="Button.discover-hero-refresh:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#99000000"/>
  </Style>
  <Style Selector="Button.discover-hero-refresh:disabled">
    <Setter Property="Opacity" Value="0.55"/>
  </Style>
  <Style Selector="TextBlock.discover-hero-refresh-label">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="#F2FFFFFF"/>
  </Style>
  <Style Selector="Button.discover-hero-refresh TextBlock.icon-xs">
    <Setter Property="Foreground" Value="#F2FFFFFF"/>
  </Style>

  <Style Selector="TextBlock.discover-hero-eyebrow">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Opacity" Value="0.85"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  </Style>

  <Style Selector="TextBlock.discover-hero-title">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeLargeTitle}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="MaxLines" Value="2"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style Selector="TextBlock.discover-hero-sub">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="Opacity" Value="0.92"/>
    <Setter Property="MaxLines" Value="2"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- 圆点：自绘模板，避开 Fluent Button 最小高度/背景把点盖没 -->
  <Style Selector="Button.discover-hero-dot">
    <Setter Property="Width" Value="22"/>
    <Setter Property="Height" Value="18"/>
    <Setter Property="MinWidth" Value="22"/>
    <Setter Property="MinHeight" Value="18"/>
    <Setter Property="MaxWidth" Value="22"/>
    <Setter Property="MaxHeight" Value="18"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Content="{TemplateBinding Content}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Background="Transparent"/>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Border.discover-hero-dot-idle">
    <Setter Property="Background" Value="#B3FFFFFF"/>
    <Setter Property="BorderBrush" Value="#66000000"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Button.discover-hero-dot:pointerover Border.discover-hero-dot-idle">
    <Setter Property="Background" Value="#E6FFFFFF"/>
  </Style>
  <Style Selector="Border.discover-hero-dot-active">
    <Setter Property="Background" Value="#FFFFFFFF"/>
    <Setter Property="BorderBrush" Value="#88000000"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="ItemsControl.discover-hero-dots">
    <Setter Property="MinHeight" Value="18"/>
    <Setter Property="IsHitTestVisible" Value="True"/>
  </Style>

  <Style Selector="Border.discover-quick-rail">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
    <Setter Property="Padding" Value="8,12"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="Button.discover-quick-tile">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>

  <Style Selector="Button.discover-quick-tile:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource OverlayHoverLightBrush}"/>
  </Style>

  <Style Selector="Border.discover-quick-icon-well">
    <Setter Property="Width" Value="{DynamicResource DiscoverQuickIconWellSize}"/>
    <Setter Property="Height" Value="{DynamicResource DiscoverQuickIconWellSize}"/>
    <Setter Property="CornerRadius" Value="22"/>
    <Setter Property="Background" Value="{DynamicResource ControlFillDefaultBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>

  <Style Selector="ScrollViewer.discover-rail-scroll">
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
    <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="Grid.discover-browse-hub">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="ItemsControl.discover-rail-list">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="ItemsControl.discover-rail-list > ContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Button.discover-rail-row">
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="Button.discover-rail-row:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
  </Style>

  <Style Selector="Panel.discover-foryou-host">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="ItemsControl.discover-foryou-list">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="ItemsControl.discover-foryou-list > ContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="Border.discover-foryou-cell">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Border.discover-foryou-cell:pointerover">
    <Setter Property="Background" Value="{DynamicResource OverlayHoverLightBrush}"/>
  </Style>

  <Style Selector="Border.discover-foryou-cover">
    <Setter Property="Width" Value="48"/>
    <Setter Property="Height" Value="48"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="Background" Value="{DynamicResource PlayerCoverPlaceholderBrush}"/>
  </Style>

  <Style Selector="Button.discover-foryou-play">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="MinWidth" Value="28"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="MaxWidth" Value="28"/>
    <Setter Property="MaxHeight" Value="28"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Background" Value="#CC000000"/>
    <Setter Property="Foreground" Value="#F5F7FA"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="Button.discover-foryou-play /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#CC000000"/>
    <Setter Property="Foreground" Value="#F5F7FA"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="14"/>
  </Style>
  <Style Selector="Button.discover-foryou-play:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#F0000000"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
  </Style>
  <Style Selector="Button.discover-foryou-play TextBlock">
    <Setter Property="Foreground" Value="#F5F7FA"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.discover-foryou-cell:pointerover Button.discover-foryou-play">
    <Setter Property="IsVisible" Value="True"/>
    <Setter Property="Opacity" Value="0.96"/>
  </Style>

  <Style Selector="Button.discover-foryou-fav">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="MinWidth" Value="28"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="MaxWidth" Value="28"/>
    <Setter Property="MaxHeight" Value="28"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeDefaultBrush}"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="Button.discover-foryou-fav /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="Button.discover-foryou-fav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlFillSecondaryBrush}"/>
  </Style>
  <Style Selector="Border.discover-foryou-cell:pointerover Button.discover-foryou-fav">
    <Setter Property="IsVisible" Value="True"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="Border.discover-foryou-cell Button.discover-foryou-fav.favorited">
    <Setter Property="IsVisible" Value="True"/>
    <Setter Property="Opacity" Value="0.72"/>
  </Style>
  <Style Selector="Border.discover-foryou-cell:pointerover Button.discover-foryou-fav.favorited">
    <Setter Property="IsVisible" Value="True"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <Style Selector="Button.discover-foryou-rowhit">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.discover-foryou-rowhit /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="Button.discover-foryou-rowhit:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <Style Selector="StackPanel.discover-foryou-pager">
    <Setter Property="Orientation" Value="Vertical"/>
    <Setter Property="Spacing" Value="8"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.discover-foryou-page-btn-well">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="BoxShadow" Value="0 4 14 0 #99000000"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.discover-foryou-page-btn">
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="MinWidth" Value="36"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="MaxWidth" Value="36"/>
    <Setter Property="MaxHeight" Value="36"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeDefaultBrush}"/>
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="FontFamily" Value="{DynamicResource IconFontFamily}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.discover-foryou-page-btn /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="Button.discover-foryou-page-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlFillSecondaryBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>
  <Style Selector="Button.discover-foryou-page-btn:disabled">
    <Setter Property="Opacity" Value="0.4"/>
  </Style>
  <Style Selector="Button.discover-foryou-page-btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <Style Selector="TextBox.discover-search-input">
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeightLg}"/>
    <Setter Property="Height" Value="{DynamicResource ControlHeightLg}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <Style Selector="TextBlock.discover-search-leading-icon">
    <Setter Property="Opacity" Value="0.65"/>
    <Setter Property="Margin" Value="8,0,4,0"/>
  </Style>

  <Style Selector="ComboBox.discover-search-platform">
    <Setter Property="MinWidth" Value="148"/>
    <Setter Property="Width" Value="148"/>
    <Setter Property="Height" Value="{DynamicResource ControlHeightStandard}"/>
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeightStandard}"/>
    <Setter Property="MaxHeight" Value="{DynamicResource ControlHeightStandard}"/>
    <Setter Property="Padding" Value="10,0,28,0"/>
    <Setter Property="Margin" Value="4,0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
  </Style>

  <Style Selector="Button.discover-search-go">
    <Setter Property="MinWidth" Value="64"/>
    <Setter Property="Height" Value="{DynamicResource ControlHeightStandard}"/>
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeightStandard}"/>
    <Setter Property="MaxHeight" Value="{DynamicResource ControlHeightStandard}"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="Margin" Value="8,0,0,0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
  </Style>

  <Style Selector="Button.discover-search-go:disabled">
    <Setter Property="Opacity" Value="0.7"/>
  </Style>

  <Style Selector="Border.discover-hero-promo">
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <Style Selector="Button.discover-search-go TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
  </Style>

  <Style Selector="Button.discover-search-icon-btn">
    <Setter Property="Width" Value="{DynamicResource ControlHeightStandard}"/>
    <Setter Property="Height" Value="{DynamicResource ControlHeightStandard}"/>
    <Setter Property="Margin" Value="2,0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
  </Style>

  <Style Selector="Button.discover-search-recognize-btn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource OverlayHoverLightBrush}"/>
  </Style>

  <Style Selector="Border.discover-cover-thumb">
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="Background" Value="{DynamicResource PlayerCoverPlaceholderBrush}"/>
  </Style>

  <Style Selector="StackPanel.discover-track-title-stack">
    <Setter Property="Margin" Value="8,0,8,0"/>
    <Setter Property="MinWidth" Value="0"/>
  </Style>

  <Style Selector="Grid.discover-track-row">
    <Setter Property="MinHeight" Value="{DynamicResource DiscoverRowHeight}"/>
  </Style>

  <Style Selector="DockPanel.discover-results-pane">
    <Setter Property="Background" Value="{DynamicResource PlayPaneBrush}"/>
  </Style>

  <!-- 与收藏/下载行操作一致：图标即可，文案放 ToolTip -->
  <Style Selector="Border.discover-cache-chip">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
  </Style>

  <Style Selector="TextBlock.discover-cache-glyph">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="TextBlock.discover-cache-chip-text">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>

  <Style Selector="DockPanel.discover-transfers-sidebar TextBlock.track-col-header">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
  </Style>

  <Style Selector="DockPanel.discover-transfers-sidebar TextBlock.download-queue-stats,
                   DockPanel.discover-transfers-sidebar TextBlock.text-caption">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeMicro}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
  </Style>

  <Style Selector="DockPanel.discover-transfers-sidebar ListBox.download-queue-list">
    <Setter Property="Opacity" Value="0.92"/>
  </Style>

  <Style Selector="DockPanel.downloads-panel">
    <Setter Property="Background" Value="{DynamicResource LibraryPaneBrush}"/>
  </Style>
  <Style Selector="DockPanel.transfers-page">
    <Setter Property="Background" Value="{DynamicResource PlayPaneBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Border.transfers-toolbar-host">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Grid.transfers-toolbar-row">
    <Setter Property="MinHeight" Value="{DynamicResource ToolbarButtonHeight}"/>
  </Style>
  <Style Selector="StackPanel.transfers-toolbar-actions">
    <Setter Property="HorizontalAlignment" Value="Right"/>
  </Style>
  <Style Selector="StackPanel.transfers-toolbar-flow">
    <Setter Property="Orientation" Value="Horizontal"/>
    <Setter Property="Spacing" Value="8"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>
  <Style Selector="Border.transfers-toolbar-group-sep">
    <Setter Property="Width" Value="1"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="Background" Value="{DynamicResource SeparatorBrush}"/>
    <Setter Property="Margin" Value="2,0,4,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.transfers-link-btn">
    <Setter Property="MinHeight" Value="20"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource LinkBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.transfers-link-btn:pointerover">
    <Setter Property="Opacity" Value="0.85"/>
  </Style>
  <Style Selector="TextBlock.transfers-stats-summary">
