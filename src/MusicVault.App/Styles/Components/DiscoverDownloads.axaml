  <Style Selector="ToggleButton.transfers-preset-toggle">
    <Setter Property="MinWidth" Value="78"/>
    <Setter Property="Padding" Value="10,0"/>
  </Style>
  <Style Selector="ToggleButton.transfers-preset-toggle:checked">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccentSoftForegroundBrush}"/>
