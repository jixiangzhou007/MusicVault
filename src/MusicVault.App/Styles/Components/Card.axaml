<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- ===== 通用卡片 ===== -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <Style Selector="Border.stat-card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowSm}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="20,18"/>
  </Style>

  <Style Selector="TextBlock.stat-label">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  </Style>
  <Style Selector="TextBlock.stat-value">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeStatValue}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="LetterSpacing" Value="-1"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>

  <!-- ===== 设置面板（统一卡片） ===== -->
  <Style Selector="Border.settings-panel,
                   Border.settings-card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}"/>
    <Setter Property="Padding" Value="20"/>
  </Style>
  <Style Selector="Border.settings-panel">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowSm}"/>
    <Setter Property="Padding" Value="20"/>
  </Style>
  <Style Selector="TextBlock.settings-panel-title">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>

  <!-- ===== 设置分区标题（统一上边距） ===== -->
  <Style Selector="TextBlock.settings-section-title">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="Margin" Value="0,20,0,8"/>
  </Style>

  <!-- ===== 设置 KPI 卡片 ===== -->
  <Style Selector="Border.settings-kpi-card">
    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowSm}"/>
    <Setter Property="Padding" Value="16,14"/>
    <Setter Property="MinWidth" Value="0"/>
  </Style>

</Styles>
