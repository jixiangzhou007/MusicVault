<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 紧凑上下文菜单项（音乐库 +、更多 …） -->
  <Style Selector="MenuItem.app-compact-menu-item">
    <Setter Property="Height" Value="{DynamicResource MenuItemHeight}"/>
    <Setter Property="MinHeight" Value="{DynamicResource MenuItemHeight}"/>
    <Setter Property="MaxHeight" Value="{DynamicResource MenuItemHeight}"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    <Setter Property="FontWeight" Value="Normal"/>
  </Style>
  <Style Selector="MenuItem.app-compact-menu-item TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
</Styles>
