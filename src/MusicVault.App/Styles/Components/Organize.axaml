<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="StackPanel.organize-toolbar">
    <Setter Property="Spacing" Value="6"/>
    <Setter Property="Margin" Value="16,0,33,6"/>
  </Style>

  <Style Selector="StackPanel.organize-toolbar-row">
    <Setter Property="Orientation" Value="Horizontal"/>
  </Style>

  <Style Selector="Grid.organize-form-row">
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="TextBlock.organize-field-label">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="Margin" Value="0,0,2,0"/>
  </Style>

  <Style Selector="WrapPanel.organize-scrape-fields-wrap">
    <Setter Property="Orientation" Value="Horizontal"/>
  </Style>

  <Style Selector="WrapPanel.organize-scrape-fields-wrap > CheckBox">
    <Setter Property="Margin" Value="0,0,12,2"/>
    <Setter Property="Padding" Value="0"/>
  </Style>

  <Style Selector="Border.organize-section-divider">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Background" Value="{DynamicResource SeparatorBrush}"/>
    <Setter Property="Margin" Value="0,4,0,8"/>
  </Style>

</Styles>
