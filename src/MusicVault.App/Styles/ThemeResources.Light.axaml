  <!-- WinUI 语义色（浅色主题） -->
  <SolidColorBrush x:Key="ControlFillDefaultBrush" Color="#EFEFF4"/>
  <SolidColorBrush x:Key="ControlFillSecondaryBrush" Color="#0A000000"/>
  <SolidColorBrush x:Key="ControlStrokeDefaultBrush" Color="#0F000000"/>
  <SolidColorBrush x:Key="ControlStrokeOnAccentBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SubtleFillTransparentBrush" Color="#00FFFFFF"/>

  <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#D9000000"/>
  <SolidColorBrush x:Key="TooltipForegroundBrush" Color="#FFFFFF"/>

  <BoxShadows x:Key="ShadowSm">0 1 2 0 #0C000000</BoxShadows>
  <BoxShadows x:Key="TooltipShadow">0 4 12 0 #40000000</BoxShadows>
  <BoxShadows x:Key="PopoverShadow">0 20 56 8 #28000000</BoxShadows>
  <BoxShadows x:Key="CardShadow">0 1 3 0 #0F000000, 0 6 20 0 #12000012</BoxShadows>
  <BoxShadows x:Key="PanelShadow">0 2 8 0 #10000000, 0 12 32 0 #14000014</BoxShadows>
  <BoxShadows x:Key="PlayerShadow">0 -1 0 0 #12000000, 0 8 32 0 #18000018</BoxShadows>

</ResourceDictionary>
