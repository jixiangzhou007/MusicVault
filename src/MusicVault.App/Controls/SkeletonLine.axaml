<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MusicVault.App.Controls.SkeletonLine"
             x:Name="Root">
  <Border x:Name="Line"
          Classes="ant-skeleton ant-skeleton-paragraph ant-skeleton-active"
          Width="{Binding LineWidth, ElementName=Root}"
          Height="{Binding LineHeight, ElementName=Root}"
          HorizontalAlignment="{Binding LineHorizontalAlignment, ElementName=Root}"/>
</UserControl>
