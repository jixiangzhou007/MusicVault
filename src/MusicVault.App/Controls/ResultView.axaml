<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:MusicVault.App.Converters"
             x:Class="MusicVault.App.Controls.ResultView"
             x:Name="Root"
             x:CompileBindings="False">
  <StackPanel Classes="ant-result">
    <Border x:Name="IconHost" Classes="ant-result-icon" IsVisible="{Binding ShowIcon, ElementName=Root}">
      <TextBlock x:Name="IconGlyph" Classes="icon-2xl" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <TextBlock Text="{Binding Title, ElementName=Root}"
               Classes="ant-result-title"
               IsVisible="{Binding Title, ElementName=Root, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"/>
    <TextBlock Text="{Binding Description, ElementName=Root}"
               Classes="ant-result-subtitle"
               IsVisible="{Binding Description, ElementName=Root, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"/>
    <ContentPresenter Content="{Binding Extra, ElementName=Root}" Margin="0,8,0,0"/>
    <StackPanel x:Name="ActionsPanel" Classes="ant-result-actions" Margin="0,12,0,0"
                IsVisible="{Binding ShowActions, ElementName=Root}">
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
        <Button Content="{Binding SecondaryButtonText, ElementName=Root}"
                Classes="flat-btn app-dialog-btn"
                Command="{Binding SecondaryCommand, ElementName=Root}"
                IsVisible="{Binding ShowSecondaryButton, ElementName=Root}"/>
        <Button Content="{Binding PrimaryButtonText, ElementName=Root}"
                Classes="primary app-dialog-btn"
                Command="{Binding PrimaryCommand, ElementName=Root}"
                IsVisible="{Binding ShowPrimaryButton, ElementName=Root}"/>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
