<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="using:MusicVault.App.Layout"
             x:Class="MusicVault.App.Controls.LibraryTrackTableHeader"
             x:Name="Root">
  <StackPanel Spacing="0">
    <Grid x:Name="HeaderGrid"
          Classes="track-table-header ant-table-header"
          ColumnDefinitions="{x:Static layout:TrackTableLayout.LibraryColumns}"
          HorizontalAlignment="Stretch">
      <TextBlock x:Name="HColIndex" Grid.Column="0" Text="#" Classes="track-col-header track-col-header-index"/>
      <TextBlock x:Name="HColTitle" Grid.Column="1" Text="歌曲" Classes="track-col-header track-col-header-muted"/>
      <TextBlock x:Name="HColArtist" Grid.Column="2" Text="艺术家" Classes="track-col-header"/>
      <TextBlock x:Name="HColAlbum" Grid.Column="3" Text="专辑" Classes="track-col-header"/>
      <TextBlock x:Name="HColYear" Grid.Column="4" Text="年份" Classes="track-col-header track-col-header-meta"/>
      <TextBlock x:Name="HColDuration" Grid.Column="5" Text="时长" Classes="track-col-header track-col-header-meta"/>
      <TextBlock x:Name="HColFavorite" Grid.Column="6" Text="收藏" Classes="track-col-header track-col-header-index"/>
      <TextBlock x:Name="HColPlaylist" Grid.Column="7" Text="歌单" Classes="track-col-header track-col-header-index"/>
      <TextBlock x:Name="HColActions" Grid.Column="8" Text="操作" Classes="track-col-header track-col-header-index"/>
    </Grid>
    <Border x:Name="HeaderDivider" Classes="track-row-divider"/>
  </StackPanel>
</UserControl>
