<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MusicVault.App.Controls.VerticalPaneSplitter"
             x:Name="Root"
             Classes="pane-splitter-host pane-splitter-v"
             Width="6"
             MinWidth="6"
             MaxWidth="6"
             Background="Transparent"
             Cursor="SizeWestEast"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">
  <Panel Background="Transparent" IsHitTestVisible="False">
    <Border x:Name="Line"
            Width="1"
            IsHitTestVisible="False"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Background="{DynamicResource SeparatorBrush}"/>
    <Border x:Name="Grip"
            Width="3"
            IsHitTestVisible="False"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            IsVisible="False"
            Background="{DynamicResource SeparatorBrush}"/>
    <Border x:Name="GripIconHost"
            Width="20"
            Height="28"
            IsHitTestVisible="False"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            CornerRadius="4"
            IsVisible="False"
            Background="{DynamicResource NavHoverBrush}">
      <TextBlock Text="&#xE784;"
                 IsHitTestVisible="False"
                 Classes="icon-xs"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Border>
  </Panel>
</UserControl>
