<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MusicVault.App.Controls"
             x:Class="MusicVault.App.Controls.SkeletonDiscoverResultsView">
  <StackPanel Classes="skeleton-discover-list">
    <Border Classes="skeleton-discover-row">
      <Grid ColumnDefinitions="40,4*,2.2*,1.1*,0.9*,2.5*" Height="34" VerticalAlignment="Center">
