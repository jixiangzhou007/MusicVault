        <controls:SkeletonLine Grid.Column="1" Margin="8,0" LineHeight="14"/>
        <controls:SkeletonLine Grid.Column="2" Margin="8,0" LineWidth="100"/>
        <controls:SkeletonLine Grid.Column="3" Margin="8,0" LineWidth="56"/>
        <controls:SkeletonLine Grid.Column="4" LineWidth="36" LineHorizontalAlignment="Center"/>
        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0" VerticalAlignment="Center">
          <controls:SkeletonBlock BlockWidth="44" BlockHeight="24" BlockCornerRadius="4"/>
          <controls:SkeletonBlock BlockWidth="52" BlockHeight="24" BlockCornerRadius="4"/>
        </StackPanel>
      </Grid>
