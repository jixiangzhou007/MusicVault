<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MusicVault.App.Controls"
             x:Class="MusicVault.App.Controls.SectionHeader"
             x:DataType="controls:SectionHeader">
  <TextBlock Classes="section-header" Text="{Binding Title}"/>
</UserControl>
