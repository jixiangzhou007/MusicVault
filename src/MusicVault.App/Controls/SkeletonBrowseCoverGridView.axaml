<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MusicVault.App.Controls"
             x:Class="MusicVault.App.Controls.SkeletonBrowseCoverGridView">
  <WrapPanel Orientation="Horizontal">
    <StackPanel Spacing="8" Width="{DynamicResource BrowseCoverTileSize}" Margin="{DynamicResource CardGridItemMargin}">
      <controls:SkeletonBlock BlockWidth="{DynamicResource BrowseCoverTileSize}"
                              BlockHeight="{DynamicResource BrowseCoverTileSize}"
                              BlockCornerRadius="8"/>
      <controls:SkeletonLine LineWidth="100" LineHorizontalAlignment="Center"/>
      <controls:SkeletonLine LineWidth="60" LineHeight="12" LineHorizontalAlignment="Center"/>
    </StackPanel>
    <StackPanel Spacing="8" Width="{DynamicResource BrowseCoverTileSize}" Margin="{DynamicResource CardGridItemMargin}">
      <controls:SkeletonBlock BlockWidth="{DynamicResource BrowseCoverTileSize}"
                              BlockHeight="{DynamicResource BrowseCoverTileSize}"
                              BlockCornerRadius="8"/>
      <controls:SkeletonLine LineWidth="90" LineHorizontalAlignment="Center"/>
      <controls:SkeletonLine LineWidth="52" LineHeight="12" LineHorizontalAlignment="Center"/>
    </StackPanel>
    <StackPanel Spacing="8" Width="{DynamicResource BrowseCoverTileSize}" Margin="{DynamicResource CardGridItemMargin}">
      <controls:SkeletonBlock BlockWidth="{DynamicResource BrowseCoverTileSize}"
                              BlockHeight="{DynamicResource BrowseCoverTileSize}"
                              BlockCornerRadius="8"/>
      <controls:SkeletonLine LineWidth="110" LineHorizontalAlignment="Center"/>
      <controls:SkeletonLine LineWidth="48" LineHeight="12" LineHorizontalAlignment="Center"/>
    </StackPanel>
    <StackPanel Spacing="8" Width="{DynamicResource BrowseCoverTileSize}" Margin="{DynamicResource CardGridItemMargin}">
      <controls:SkeletonBlock BlockWidth="{DynamicResource BrowseCoverTileSize}"
                              BlockHeight="{DynamicResource BrowseCoverTileSize}"
                              BlockCornerRadius="8"/>
      <controls:SkeletonLine LineWidth="80" LineHorizontalAlignment="Center"/>
      <controls:SkeletonLine LineWidth="56" LineHeight="12" LineHorizontalAlignment="Center"/>
    </StackPanel>
    <StackPanel Spacing="8" Width="{DynamicResource BrowseCoverTileSize}" Margin="{DynamicResource CardGridItemMargin}">
      <controls:SkeletonBlock BlockWidth="{DynamicResource BrowseCoverTileSize}"
                              BlockHeight="{DynamicResource BrowseCoverTileSize}"
                              BlockCornerRadius="8"/>
      <controls:SkeletonLine LineWidth="105" LineHorizontalAlignment="Center"/>
      <controls:SkeletonLine LineWidth="44" LineHeight="12" LineHorizontalAlignment="Center"/>
    </StackPanel>
    <StackPanel Spacing="8" Width="{DynamicResource BrowseCoverTileSize}" Margin="{DynamicResource CardGridItemMargin}">
      <controls:SkeletonBlock BlockWidth="{DynamicResource BrowseCoverTileSize}"
                              BlockHeight="{DynamicResource BrowseCoverTileSize}"
                              BlockCornerRadius="8"/>
      <controls:SkeletonLine LineWidth="95" LineHorizontalAlignment="Center"/>
      <controls:SkeletonLine LineWidth="50" LineHeight="12" LineHorizontalAlignment="Center"/>
    </StackPanel>
  </WrapPanel>
</UserControl>
